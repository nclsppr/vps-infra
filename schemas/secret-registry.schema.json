{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nclsppr/vps-infra/schemas/secret-registry.schema.json",
  "title": "Atlas required secret registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "secret_root",
    "observed_at",
    "controller_revision",
    "evidence",
    "value_recovery_state",
    "secrets"
  ],
  "properties": {
    "schema": { "const": 1 },
    "environment": { "const": "production" },
    "secret_root": { "const": "/etc/vps/secrets" },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "controller_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence": { "const": "read-only-secret-metadata-audit" },
    "value_recovery_state": {
      "enum": ["not-configured", "partial", "verified"]
    },
    "secrets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/secret" }
    }
  },
  "$defs": {
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "classification",
        "provider",
        "path",
        "owner",
        "group",
        "mode",
        "materializer",
        "consumers",
        "source",
        "rebuild",
        "declared_state",
        "generation",
        "target_generation",
        "generation_binding",
        "host_state",
        "provider_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "scope": {
          "enum": ["platform", "surplasse", "parkventory", "monflorian"]
        },
        "classification": { "enum": ["secret", "protected-input"] },
        "provider": {
          "enum": [
            "auth0",
            "local",
            "openai",
            "ovhcloud",
            "scaleway-tem",
            "stripe"
          ]
        },
        "credential_set": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.:_-][a-z0-9]+)*$"
        },
        "permission_set": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^/etc/vps/secrets/[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?:/[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)*$"
        },
        "owner": { "const": 0 },
        "group": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "mode": { "enum": ["0400", "0440"] },
        "materializer": {
          "enum": [
            "ansible-deploy-role",
            "materialize-internal-platform-secrets",
            "materialize-parkventory-provider-secrets",
            "materialize-parkventory-secrets",
            "materialize-surplasse-dns-secrets",
            "materialize-surplasse-secrets",
            "not-implemented",
            "surplasse-dns-cutover-operator"
          ]
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        },
        "source": {
          "enum": [
            "generated-on-atlas",
            "operator-file",
            "provider-identifier",
            "provider-secret"
          ]
        },
        "rebuild": {
          "enum": [
            "do-not-restore",
            "regenerate",
            "restore-from-external-store"
          ]
        },
        "declared_state": { "enum": ["planned", "required", "temporary"] },
        "generation": { "type": "integer", "minimum": 0 },
        "target_generation": { "type": "integer", "minimum": 1 },
        "generation_binding": {
          "enum": ["materializer-marker", "unlinked"]
        },
        "host_state": { "enum": ["absent", "materialized", "runtime-loaded"] },
        "provider_state": {
          "enum": ["not-applicable", "planned", "active", "revoked"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "generation_binding": { "const": "unlinked" }
            },
            "required": ["generation_binding"]
          },
          "then": {
            "properties": {
              "generation": { "const": 0 },
              "host_state": { "enum": ["absent", "materialized"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generation_binding": { "const": "materializer-marker" }
            },
            "required": ["generation_binding"]
          },
          "then": { "properties": { "generation": { "minimum": 1 } } }
        },
        {
          "if": {
            "properties": {
              "provider_state": { "const": "revoked" }
            },
            "required": ["provider_state"]
          },
          "then": {
            "properties": {
              "host_state": { "const": "absent" },
              "rebuild": { "const": "do-not-restore" }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "provider": { "const": "scaleway-tem" }
                },
                "required": ["provider"]
              },
              {
                "properties": {
                  "source": {
                    "enum": ["provider-identifier", "provider-secret"]
                  }
                },
                "required": ["source"]
              }
            ]
          },
          "then": {
            "required": ["credential_set", "permission_set"],
            "properties": {
              "permission_set": { "const": "TransactionalEmailEmailSmtpCreate" }
            }
          }
        }
      ]
    }
  }
}
