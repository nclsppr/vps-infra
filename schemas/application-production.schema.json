{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nclsppr/vps-infra/schemas/application-production.schema.json",
  "title": "Atlas application production admission policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "applications"],
  "properties": {
    "schema": { "const": 1 },
    "applications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surplasse", "parkventory", "monflorian"],
      "properties": {
        "surplasse": { "$ref": "#/$defs/surplasse" },
        "parkventory": { "$ref": "#/$defs/parkventory" },
        "monflorian": { "$ref": "#/$defs/monflorian" }
      }
    }
  },
  "$defs": {
    "baseProperties": {
      "enabled": { "type": "boolean" },
      "mode": { "const": "compose" },
      "source_branch": { "const": "main" }
    },
    "surplasse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "source_repository",
        "source_branch",
        "release_repository",
        "integration_repository",
        "component_repositories",
        "required_checks"
      ],
      "properties": {
        "enabled": { "$ref": "#/$defs/baseProperties/enabled" },
        "mode": { "$ref": "#/$defs/baseProperties/mode" },
        "source_repository": { "const": "nclsppr/surplasse" },
        "source_branch": { "$ref": "#/$defs/baseProperties/source_branch" },
        "release_repository": {
          "const": "ghcr.io/nclsppr/surplasse/application-release"
        },
        "integration_repository": {
          "const": "ghcr.io/nclsppr/surplasse/vps-integration"
        },
        "component_repositories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "onboarding", "commande", "dashboard", "docs"],
          "properties": {
            "backend": { "const": "ghcr.io/nclsppr/surplasse/backend" },
            "onboarding": { "const": "ghcr.io/nclsppr/surplasse/onboarding" },
            "commande": { "const": "ghcr.io/nclsppr/surplasse/commande" },
            "dashboard": { "const": "ghcr.io/nclsppr/surplasse/dashboard" },
            "docs": { "const": "ghcr.io/nclsppr/surplasse/docs" }
          }
        },
        "required_checks": {
          "const": ["Publish immutable application release"]
        }
      }
    },
    "parkventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "source_repository",
        "source_branch",
        "release_repository",
        "integration_repository",
        "component_repositories",
        "required_checks",
        "readiness_evidence"
      ],
      "properties": {
        "enabled": { "$ref": "#/$defs/baseProperties/enabled" },
        "mode": { "$ref": "#/$defs/baseProperties/mode" },
        "source_repository": { "const": "nclsppr/parkventory" },
        "source_branch": { "$ref": "#/$defs/baseProperties/source_branch" },
        "release_repository": {
          "const": "ghcr.io/nclsppr/parkventory/application-release"
        },
        "integration_repository": {
          "const": "ghcr.io/nclsppr/parkventory/vps-integration"
        },
        "component_repositories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "frontend"],
          "properties": {
            "backend": { "const": "ghcr.io/nclsppr/parkventory/backend" },
            "frontend": { "const": "ghcr.io/nclsppr/parkventory/frontend" }
          }
        },
        "required_checks": {
          "const": ["Publish immutable application release", "verify"]
        },
        "readiness_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["postgres", "encrypted_offsite_backup"],
          "properties": {
            "postgres": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contract", "path", "sha256"],
              "properties": {
                "contract": {
                  "const": "vps-infra.parkventory-postgres-readiness.v1"
                },
                "path": {
                  "const": "/var/lib/vps-readiness/parkventory/postgres.json"
                },
                "sha256": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                  ]
                }
              }
            },
            "encrypted_offsite_backup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contract", "path", "sha256"],
              "properties": {
                "contract": {
                  "const": "vps-infra.parkventory-offsite-backup-readiness.v1"
                },
                "path": {
                  "const": "/var/lib/vps-readiness/parkventory/offsite-backup.json"
                },
                "sha256": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "monflorian": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "source_repository",
        "source_branch",
        "release_repository",
        "integration_repository",
        "component_repositories",
        "required_checks"
      ],
      "properties": {
        "enabled": { "$ref": "#/$defs/baseProperties/enabled" },
        "mode": { "$ref": "#/$defs/baseProperties/mode" },
        "source_repository": { "const": "nclsppr/monflorian" },
        "source_branch": { "$ref": "#/$defs/baseProperties/source_branch" },
        "release_repository": {
          "const": "ghcr.io/nclsppr/monflorian/application-release"
        },
        "integration_repository": {
          "const": "ghcr.io/nclsppr/monflorian/vps-integration"
        },
        "component_repositories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend"],
          "properties": {
            "backend": { "const": "ghcr.io/nclsppr/monflorian/backend" }
          }
        },
        "required_checks": {
          "const": ["Publish immutable application release", "verify"]
        }
      }
    }
  }
}
