---
# Exemple à copier hors du dépôt puis à passer avec :
#   --extra-vars @/chemin/vers/bootstrap-public.yml
vps_admin_authorized_keys:
  - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIREMPLACER cle-administration

# Requise avant site.yml. Une liste vide doit arrêter la convergence avant que
# le rôle ne touche au fichier authorized_keys du compte deploy.
vps_deploy_authorized_keys:
  - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIREMPLACER cle-deploiement-github

# Clé publique temporaire et distincte pour l'ingress provider Parkventory.
# Remettre cette valeur à vide puis reconverger après le bootstrap.
vps_parkventory_provider_ingress_authorized_key: ""

# Laisser vide. Le runbook de réconciliation décrit l'exception à usage unique
# réservée à une perte prouvée de toutes les clés de déploiement.
vps_deploy_key_recovery_nonce: ""

# Passerelle SSH optionnelle pour Codex desktop. Utiliser une clé dédiée.
vps_codex_remote_enabled: false
vps_codex_remote_authorized_keys: []

# Relais sortant optionnel pour contrôler Atlas directement depuis un mobile.
# Cette option ne nécessite ni passerelle SSH Codex ni port entrant.
vps_codex_remote_control_enabled: false
