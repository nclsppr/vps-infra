{% set declared_keys = vps_deploy_authorized_keys | default([]) %}
{% set provider_key = vps_parkventory_provider_ingress_authorized_key | default('') %}
{% set bounded_keys = (
  declared_keys is sequence and
  declared_keys is not string and
  declared_keys is not mapping and
  declared_keys | length > 0 and
  declared_keys | length <= 4 and
  declared_keys | unique | length == declared_keys | length
) %}
{% set provider_key_bounded = (
  provider_key is string and
  provider_key | length <= 16384 and
  declared_keys | length + (1 if provider_key | length > 0 else 0) <= 4
) %}
{% set rotation_guard_passed = (
  deploy_key_rotation_guard is defined and
  not (deploy_key_rotation_guard.failed | default(true) | bool)
) %}
{% set recovery_marker_consumed = (
  vps_deploy_key_recovery_nonce | default('') | length == 0 or
  ansible_check_mode | default(false) | bool or
  (
    deploy_key_recovery_marker_creation is defined and
    deploy_key_recovery_marker_creation.changed | default(false) | bool
  )
) %}
{% if not bounded_keys or not provider_key_bounded or not rotation_guard_passed or not recovery_marker_consumed %}
vps-deploy-authorized-keys-render-refused
{% else %}
{% for key in declared_keys %}
restrict,command="{{ vps_deploy_gate_path }}" {{ key | trim }}
{% endfor %}
{% if provider_key | length > 0 %}
restrict,command="{{ vps_parkventory_provider_ingress_ssh_gate_path }}" {{ provider_key | trim }}
{% endif %}
{% endif %}
