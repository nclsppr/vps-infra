# Managed by Ansible. OpenSSH uses the first value found, hence the 00 prefix.
Port {{ vps_ssh_port }}
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM yes
MaxAuthTries 3
LoginGraceTime 30
X11Forwarding no
AllowUsers {{ vps_admin_user }} {{ vps_deploy_user }}

Match User {{ vps_deploy_user }}
    AuthenticationMethods publickey
    DisableForwarding yes
    PermitTTY no
    X11Forwarding no
    AllowAgentForwarding no
    AllowTcpForwarding no
    PermitTunnel no
    ForceCommand {{ vps_deploy_gate_path }}

Match all
