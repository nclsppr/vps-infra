[Unit]
Description=Bounded volatile backing store for DynamicUser static jobs

[Mount]
What=tmpfs
Where={{ vps_static_jobs_backing_path }}
Type=tmpfs
Options=nodev,nosuid,noexec,mode=0700,size={{ vps_static_jobs_tmpfs_size_mib }}M,nr_inodes={{ vps_static_jobs_tmpfs_inodes }}
DirectoryMode=0700
TimeoutSec=30s

[Install]
WantedBy=local-fs.target
