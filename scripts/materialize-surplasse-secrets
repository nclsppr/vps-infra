#!/usr/bin/env python3
"""Validate Surplasse secrets and create only missing database passwords."""

from __future__ import annotations

import argparse
import os
import re
import secrets
import stat
import sys
from dataclasses import dataclass
from pathlib import Path


EX_CONFIG = 78
PRODUCTION_ROOT = Path("/etc/vps/secrets/surplasse")
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW
RANDOM_PATTERN = re.compile(rb"[A-Za-z0-9_-]{64}\n")


class SecretError(RuntimeError):
    """Raised when the Surplasse secret tree differs from the contract."""


@dataclass(frozen=True)
class SecretSpec:
    name: str
    generated: bool
    random_format: bool = False


SPECS = (
    SecretSpec("surplasse-jwt-jwks", False),
    SecretSpec("surplasse-jwt-private-key", False),
    SecretSpec("surplasse-postgres-migrator-password", True, True),
    SecretSpec("surplasse-postgres-runtime-password", True, True),
    SecretSpec("surplasse-smtp-password", False),
    SecretSpec("surplasse-smtp-username", False),
    SecretSpec("surplasse-stripe-account-webhook-secret", False),
    SecretSpec("surplasse-stripe-payment-webhook-secret", False),
    SecretSpec("surplasse-stripe-secret-key", False),
)


def fail(message: str) -> int:
    print(f"Surplasse secret materialization refused: {message}", file=sys.stderr)
    return EX_CONFIG


def open_directory(path: Path) -> int:
    try:
        return os.open(path, DIRECTORY_FLAGS)
    except OSError as exc:
        raise SecretError(f"cannot open protected directory {path}: {exc.strerror}") from exc


def ensure_directory_at(parent_fd: int, name: str, mode: int) -> int:
    try:
        os.mkdir(name, mode=mode, dir_fd=parent_fd)
    except FileExistsError:
        pass
    try:
        descriptor = os.open(name, DIRECTORY_FLAGS, dir_fd=parent_fd)
    except OSError as exc:
        raise SecretError(f"protected directory {name} is unsafe: {exc.strerror}") from exc
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        os.close(descriptor)
        raise SecretError(f"protected directory {name} differs from root:root {mode:04o}")
    return descriptor


def production_directory() -> tuple[int, list[int]]:
    descriptors: list[int] = []
    root_fd = open_directory(Path("/"))
    descriptors.append(root_fd)
    etc_fd = os.open("etc", DIRECTORY_FLAGS, dir_fd=root_fd)
    descriptors.append(etc_fd)
    vps_fd = ensure_directory_at(etc_fd, "vps", 0o755)
    descriptors.append(vps_fd)
    secrets_fd = ensure_directory_at(vps_fd, "secrets", 0o700)
    descriptors.append(secrets_fd)
    application_fd = ensure_directory_at(secrets_fd, "surplasse", 0o700)
    descriptors.append(application_fd)
    return application_fd, descriptors


def test_directory(path: Path) -> tuple[int, list[int]]:
    if os.geteuid() == 0 or os.environ.get("VPS_SURPLASSE_SECRET_TESTING") != "1":
        raise SecretError("test-only mode requires an explicit unprivileged test guard")
    if not path.is_absolute():
        raise SecretError("test-only directory must be absolute")
    descriptor = open_directory(path)
    metadata = os.fstat(descriptor)
    if metadata.st_uid != os.geteuid() or stat.S_IMODE(metadata.st_mode) != 0o700:
        os.close(descriptor)
        raise SecretError("test-only directory must be caller-owned with mode 0700")
    return descriptor, [descriptor]


def validate(descriptor: int, spec: SecretSpec, owner: int, group: int) -> None:
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_nlink != 1
        or metadata.st_uid != owner
        or metadata.st_gid != group
        or stat.S_IMODE(metadata.st_mode) != 0o440
    ):
        raise SecretError(f"secret {spec.name} has unsafe metadata")
    content = os.read(descriptor, 1_048_577)
    if not content or len(content) > 1_048_576 or b"\0" in content:
        raise SecretError(f"secret {spec.name} is empty, too large, or binary")
    if spec.random_format and RANDOM_PATTERN.fullmatch(content) is None:
        raise SecretError(f"secret {spec.name} has an invalid random format")


def materialize(directory_fd: int, spec: SecretSpec, owner: int, group: int) -> None:
    try:
        descriptor = os.open(spec.name, FILE_FLAGS, dir_fd=directory_fd)
    except FileNotFoundError:
        if not spec.generated:
            raise SecretError(f"operator-supplied secret {spec.name} is missing")
        descriptor = os.open(
            spec.name,
            os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        try:
            content = secrets.token_urlsafe(48).encode("ascii") + b"\n"
            if RANDOM_PATTERN.fullmatch(content) is None:
                raise SecretError("the operating system returned an invalid random value")
            view = memoryview(content)
            while view:
                written = os.write(descriptor, view)
                if written <= 0:
                    raise SecretError(f"cannot write secret {spec.name}")
                view = view[written:]
            os.fchown(descriptor, owner, group)
            os.fchmod(descriptor, 0o440)
            os.fsync(descriptor)
            os.lseek(descriptor, 0, os.SEEK_SET)
            validate(descriptor, spec, owner, group)
        except Exception:
            os.close(descriptor)
            try:
                os.unlink(spec.name, dir_fd=directory_fd)
            except OSError:
                pass
            raise
        os.close(descriptor)
        return
    except OSError as exc:
        raise SecretError(f"cannot open protected secret {spec.name}: {exc.strerror}") from exc
    try:
        validate(descriptor, spec, owner, group)
    finally:
        os.close(descriptor)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--database-only", action="store_true")
    parser.add_argument("--test-root", type=Path, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.test_root is None and os.geteuid() != 0:
        return fail("production mode requires root")
    owner = 0 if args.test_root is None else os.geteuid()
    group = 10001 if args.test_root is None else os.getegid()
    specs = tuple(spec for spec in SPECS if spec.generated) if args.database_only else SPECS
    descriptors: list[int] = []
    try:
        directory_fd, descriptors = (
            production_directory() if args.test_root is None else test_directory(args.test_root)
        )
        for spec in specs:
            materialize(directory_fd, spec, owner, group)
        os.fsync(directory_fd)
    except (OSError, SecretError) as exc:
        return fail(str(exc))
    finally:
        for descriptor in reversed(descriptors):
            try:
                os.close(descriptor)
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
