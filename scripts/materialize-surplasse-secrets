#!/usr/bin/env python3
"""Validate and materialize the protected Surplasse operator inputs."""

from __future__ import annotations

import argparse
import base64
import binascii
import fcntl
import hashlib
import json
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any

EX_CONFIG = 78
PRODUCTION_ROOT = Path("/etc/vps/secrets/surplasse")
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
MAX_INPUT_BYTES = 1_048_576
MANIFEST_NAME = "surplasse-operator-bundle-manifest.json"
LOCK_NAME = ".surplasse-operator-bundle.lock"
MANIFEST_CONTRACT = "surplasse-operator-bundle"
MANIFEST_VERSION = 1
LOCK_TIMEOUT_SECONDS = 30
RANDOM_PATTERN = re.compile(rb"[A-Za-z0-9_-]{64}\n")
SINGLE_LINE_PATTERN = re.compile(rb"[\x21-\x7e]{1,512}\n")
OPAQUE_LINE_PATTERN = re.compile(rb"[\x20-\x7e]{1,512}\n")
JWT_KEY_ID_PATTERN = re.compile(rb"[A-Za-z0-9][A-Za-z0-9._:-]{0,127}\n")
STRIPE_LIVE_KEY_RE = re.compile(rb"sk_live_[A-Za-z0-9_]{16,248}\n")
STRIPE_WEBHOOK_PATTERN = re.compile(rb"whsec_[A-Za-z0-9_-]{16,248}\n")
OVH_APPLICATION_KEY_PATTERN = re.compile(rb"[A-Za-z0-9]{16}\n")
OVH_LONG_KEY_PATTERN = re.compile(rb"[A-Za-z0-9]{32}\n")


class SecretError(RuntimeError):
    """Raised when the Surplasse operator input tree differs from the contract."""


@dataclass(frozen=True)
class SecretSpec:
    name: str
    generated: bool
    kind: str
    application_readable: bool


OPERATOR_SPECS = (
    SecretSpec("surplasse-jwt-jwks", False, "jwks", True),
    SecretSpec("surplasse-jwt-private-key", False, "rsa-private-key", True),
    SecretSpec("surplasse-jwt-key-id", False, "jwt-key-id", False),
    SecretSpec("surplasse-smtp-host", False, "smtp-host", False),
    SecretSpec("surplasse-smtp-port", False, "smtp-port", False),
    SecretSpec("surplasse-smtp-password", False, "opaque-line", True),
    SecretSpec("surplasse-smtp-username", False, "single-line", True),
    SecretSpec(
        "surplasse-stripe-account-webhook-secret", False, "stripe-webhook", True
    ),
    SecretSpec(
        "surplasse-stripe-payment-webhook-secret", False, "stripe-webhook", True
    ),
    SecretSpec("surplasse-stripe-secret-key", False, "stripe-secret-key", True),
    SecretSpec("ovh-application-key", False, "ovh-application-key", False),
    SecretSpec("ovh-application-secret", False, "ovh-long-key", False),
    SecretSpec("ovh-consumer-key", False, "ovh-long-key", False),
)
GENERATED_SPECS = (
    SecretSpec("surplasse-postgres-migrator-password", True, "random", True),
    SecretSpec("surplasse-postgres-runtime-password", True, "random", True),
)
SPECS = OPERATOR_SPECS + GENERATED_SPECS


def fail(message: str) -> int:
    print(f"Surplasse secret materialization refused: {message}", file=sys.stderr)
    return EX_CONFIG


def open_directory(path: Path) -> int:
    try:
        return os.open(path, DIRECTORY_FLAGS)
    except OSError as exc:
        raise SecretError(
            f"cannot open protected directory {path}: {exc.strerror}"
        ) from exc


def ensure_directory_at(parent_fd: int, name: str, mode: int) -> int:
    try:
        os.mkdir(name, mode=mode, dir_fd=parent_fd)
    except FileExistsError:
        pass
    try:
        descriptor = os.open(name, DIRECTORY_FLAGS, dir_fd=parent_fd)
    except OSError as exc:
        raise SecretError(
            f"protected directory {name} is unsafe: {exc.strerror}"
        ) from exc
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        os.close(descriptor)
        raise SecretError(
            f"protected directory {name} differs from root:root {mode:04o}"
        )
    return descriptor


def production_directory() -> tuple[int, list[int]]:
    descriptors: list[int] = []
    root_fd = open_directory(Path("/"))
    descriptors.append(root_fd)
    etc_fd = os.open("etc", DIRECTORY_FLAGS, dir_fd=root_fd)
    descriptors.append(etc_fd)
    vps_fd = ensure_directory_at(etc_fd, "vps", 0o755)
    descriptors.append(vps_fd)
    secrets_fd = ensure_directory_at(vps_fd, "secrets", 0o700)
    descriptors.append(secrets_fd)
    application_fd = ensure_directory_at(secrets_fd, "surplasse", 0o700)
    descriptors.append(application_fd)
    return application_fd, descriptors


def test_directory(path: Path) -> tuple[int, list[int]]:
    if os.geteuid() == 0 or os.environ.get("VPS_SURPLASSE_SECRET_TESTING") != "1":
        raise SecretError("test-only mode requires an explicit unprivileged test guard")
    if not path.is_absolute():
        raise SecretError("test-only directory must be absolute")
    descriptor = open_directory(path)
    metadata = os.fstat(descriptor)
    if metadata.st_uid != os.geteuid() or stat.S_IMODE(metadata.st_mode) != 0o700:
        os.close(descriptor)
        raise SecretError("test-only directory must be caller-owned with mode 0700")
    return descriptor, [descriptor]


def strict_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise SecretError("JWKS contains a duplicate object member")
        result[key] = value
    return result


def decode_base64url(value: object, label: str) -> bytes:
    if not isinstance(value, str) or re.fullmatch(r"[A-Za-z0-9_-]+", value) is None:
        raise SecretError(f"active JWKS {label} is not canonical base64url")
    padding = "=" * ((4 - len(value) % 4) % 4)
    try:
        decoded = base64.b64decode(value + padding, altchars=b"-_", validate=True)
    except (binascii.Error, ValueError) as exc:
        raise SecretError(f"active JWKS {label} is invalid") from exc
    if (
        not decoded
        or base64.urlsafe_b64encode(decoded).rstrip(b"=").decode("ascii") != value
    ):
        raise SecretError(f"active JWKS {label} is not canonical base64url")
    return decoded


def der_length(length: int) -> bytes:
    if length < 0x80:
        return bytes((length,))
    encoded = length.to_bytes((length.bit_length() + 7) // 8, "big")
    return bytes((0x80 | len(encoded),)) + encoded


def der_value(tag: int, value: bytes) -> bytes:
    return bytes((tag,)) + der_length(len(value)) + value


def der_integer(value: bytes) -> bytes:
    normalized = value.lstrip(b"\0") or b"\0"
    if normalized[0] & 0x80:
        normalized = b"\0" + normalized
    return der_value(0x02, normalized)


def jwk_subject_public_key_info(key: dict[str, Any]) -> bytes:
    modulus = decode_base64url(key.get("n"), "modulus")
    exponent = decode_base64url(key.get("e"), "exponent")
    modulus_integer = int.from_bytes(modulus, "big")
    exponent_integer = int.from_bytes(exponent, "big")
    if modulus[:1] == b"\0" or not 2048 <= modulus_integer.bit_length() <= 8192:
        raise SecretError(
            "JWKS RSA modulus must be a canonical 2048 to 8192 bit integer"
        )
    if exponent[:1] == b"\0" or len(exponent) > 4:
        raise SecretError("JWKS RSA exponent is not a canonical bounded integer")
    if exponent_integer != 65537:
        raise SecretError("JWKS RSA exponent must be 65537")
    rsa_public_key = der_value(0x30, der_integer(modulus) + der_integer(exponent))
    rsa_algorithm = bytes.fromhex("300d06092a864886f70d0101010500")
    return der_value(0x30, rsa_algorithm + der_value(0x03, b"\0" + rsa_public_key))


def parse_jwks(content: bytes, key_id: str) -> bytes:
    try:
        document = json.loads(
            content.decode("utf-8"),
            object_pairs_hook=strict_object,
            parse_constant=lambda value: (_ for _ in ()).throw(
                SecretError("JWKS contains an invalid numeric constant")
            ),
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SecretError("JWKS is not strict UTF-8 JSON") from exc
    if not isinstance(document, dict) or set(document) != {"keys"}:
        raise SecretError("JWKS must contain only the keys array")
    keys = document["keys"]
    if not isinstance(keys, list) or not 1 <= len(keys) <= 3:
        raise SecretError("JWKS must contain between one and three public keys")
    selected_public_key: bytes | None = None
    key_ids: set[str] = set()
    forbidden_private_members = {"d", "p", "q", "dp", "dq", "qi", "oth"}
    for key in keys:
        if not isinstance(key, dict):
            raise SecretError("each JWKS member must be an object")
        if forbidden_private_members.intersection(key):
            raise SecretError("JWKS must not contain private RSA parameters")
        required = {"alg", "e", "kid", "kty", "n", "use"}
        allowed = required | {"alg", "use", "key_ops"}
        if not required.issubset(key) or not set(key).issubset(allowed):
            raise SecretError(
                "each JWKS member must use the reviewed RSA public fields"
            )
        if key.get("kty") != "RSA":
            raise SecretError("each JWKS member must use RSA")
        if key.get("alg") != "RS256":
            raise SecretError("each JWKS member must use RS256")
        if key.get("use") != "sig":
            raise SecretError("each JWKS member must be a signing key")
        key_ops = key.get("key_ops")
        if key_ops is not None and key_ops != ["verify"]:
            raise SecretError("JWKS key_ops must contain only verify")
        if (
            not isinstance(key.get("kid"), str)
            or JWT_KEY_ID_PATTERN.fullmatch(key["kid"].encode("utf-8") + b"\n") is None
        ):
            raise SecretError("each JWKS member must have a valid kid")
        if key["kid"] in key_ids:
            raise SecretError("JWKS contains a duplicate kid")
        key_ids.add(key["kid"])
        public_key = jwk_subject_public_key_info(key)
        if key["kid"] == key_id:
            selected_public_key = public_key
    if selected_public_key is None:
        raise SecretError("JWKS must contain the active kid exactly once")
    return selected_public_key


def private_public_key(content: bytes) -> bytes:
    openssl = shutil.which("openssl", path="/usr/bin:/bin:/usr/local/bin")
    if openssl is None:
        raise SecretError("openssl is required to validate the JWT private key")
    environment = {"PATH": "/usr/bin:/bin", "LC_ALL": "C"}
    for arguments, label in (
        ([openssl, "rsa", "-check", "-noout", "-passin", "pass:"], "validation"),
        (
            [openssl, "pkey", "-pubout", "-outform", "DER", "-passin", "pass:"],
            "public key extraction",
        ),
    ):
        try:
            result = subprocess.run(
                arguments,
                input=content,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=10,
                env=environment,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise SecretError(f"JWT private key {label} failed") from exc
        if result.returncode != 0:
            raise SecretError(f"JWT private key {label} failed")
        if label == "public key extraction":
            if not result.stdout or len(result.stdout) > 8192:
                raise SecretError("JWT private key returned an invalid public key")
            return result.stdout
    raise SecretError("JWT private key validation did not return a public key")


def validate_smtp_host(content: bytes) -> None:
    if not content.endswith(b"\n") or content.count(b"\n") != 1:
        raise SecretError("SMTP host must be one newline-terminated DNS name")
    try:
        host = content[:-1].decode("ascii")
    except UnicodeDecodeError as exc:
        raise SecretError("SMTP host must be ASCII") from exc
    if len(host) > 253 or host.endswith(".") or host.startswith("."):
        raise SecretError("SMTP host is not a bounded DNS name")
    labels = host.split(".")
    if len(labels) < 2 or any(
        len(label) > 63
        or re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?", label) is None
        for label in labels
    ):
        raise SecretError("SMTP host is not a valid DNS name")


def validate_content(spec: SecretSpec, content: bytes) -> None:
    if not content or len(content) > MAX_INPUT_BYTES or b"\0" in content:
        raise SecretError(f"operator input {spec.name} is empty, too large, or binary")
    patterns = {
        "random": RANDOM_PATTERN,
        "single-line": SINGLE_LINE_PATTERN,
        "opaque-line": OPAQUE_LINE_PATTERN,
        "jwt-key-id": JWT_KEY_ID_PATTERN,
        "stripe-secret-key": STRIPE_LIVE_KEY_RE,
        "stripe-webhook": STRIPE_WEBHOOK_PATTERN,
        "ovh-application-key": OVH_APPLICATION_KEY_PATTERN,
        "ovh-long-key": OVH_LONG_KEY_PATTERN,
    }
    if spec.kind in patterns and patterns[spec.kind].fullmatch(content) is None:
        raise SecretError(
            f"operator input {spec.name} has an invalid {spec.kind} format"
        )
    if spec.kind == "smtp-host":
        validate_smtp_host(content)
    elif spec.kind == "smtp-port":
        if re.fullmatch(rb"[0-9]{1,5}\n", content) is None:
            raise SecretError("SMTP port must be a newline-terminated decimal integer")
        port = int(content)
        if not 1 <= port <= 65535:
            raise SecretError("SMTP port is outside the TCP port range")
    elif spec.kind == "jwks":
        try:
            json.loads(content.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise SecretError("JWKS is not UTF-8 JSON") from exc
    elif spec.kind == "rsa-private-key":
        allowed_boundaries = {
            (b"-----BEGIN " + b"PRIVATE KEY-----", b"-----END " + b"PRIVATE KEY-----"),
            (
                b"-----BEGIN RSA " + b"PRIVATE KEY-----",
                b"-----END RSA " + b"PRIVATE KEY-----",
            ),
        }
        is_single_pem = any(
            re.fullmatch(
                re.escape(begin)
                + rb"\n(?:[A-Za-z0-9+/]{1,64}={0,2}\n)+"
                + re.escape(end)
                + rb"\n",
                content,
            )
            is not None
            for begin, end in allowed_boundaries
        )
        if len(content) > 64 * 1024 or not is_single_pem:
            raise SecretError("JWT private key is not a bounded PEM private key")


def validate_bundle(contents: dict[str, bytes]) -> None:
    key_id_raw = contents.get("surplasse-jwt-key-id")
    jwks_raw = contents.get("surplasse-jwt-jwks")
    signing_material = contents.get("surplasse-jwt-private-key")
    if key_id_raw is None or jwks_raw is None or signing_material is None:
        raise SecretError("operator bundle omits the JWT key, JWKS, or kid")
    key_id = key_id_raw[:-1].decode("ascii")
    expected_public_key = parse_jwks(jwks_raw, key_id)
    if private_public_key(signing_material) != expected_public_key:
        raise SecretError("JWT private key does not match the active JWKS kid")
    if (
        contents["surplasse-stripe-account-webhook-secret"]
        == contents["surplasse-stripe-payment-webhook-secret"]
    ):
        raise SecretError("Stripe webhook signing secrets must be distinct")
    if contents["ovh-application-secret"] == contents["ovh-consumer-key"]:
        raise SecretError("OVH application and consumer secrets must be distinct")


def render_manifest(contents: dict[str, bytes]) -> bytes:
    document = {
        "contract": MANIFEST_CONTRACT,
        "sha256": {
            spec.name: hashlib.sha256(contents[spec.name]).hexdigest()
            for spec in OPERATOR_SPECS
        },
        "version": MANIFEST_VERSION,
    }
    return (
        json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n"
    ).encode("ascii")


def read_manifest(directory_fd: int, owner: int, group: int) -> bytes:
    try:
        descriptor = os.open(MANIFEST_NAME, FILE_FLAGS, dir_fd=directory_fd)
    except FileNotFoundError as exc:
        raise SecretError("operator bundle manifest is missing") from exc
    except OSError as exc:
        raise SecretError("operator bundle manifest is unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        expected_group = 0 if owner == 0 else group
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != expected_group
            or stat.S_IMODE(metadata.st_mode) != 0o400
        ):
            raise SecretError("operator bundle manifest has unsafe metadata")
        content = os.read(descriptor, MAX_INPUT_BYTES + 1)
        if not content or len(content) > MAX_INPUT_BYTES or b"\0" in content:
            raise SecretError("operator bundle manifest is invalid")
        return content
    finally:
        os.close(descriptor)


def validate_manifest_target_metadata(
    directory_fd: int, owner: int, group: int
) -> None:
    try:
        descriptor = os.open(MANIFEST_NAME, FILE_FLAGS, dir_fd=directory_fd)
    except FileNotFoundError:
        return
    except OSError as exc:
        raise SecretError("operator bundle manifest is unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        expected_group = 0 if owner == 0 else group
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != expected_group
            or stat.S_IMODE(metadata.st_mode) != 0o400
        ):
            raise SecretError("operator bundle manifest has unsafe metadata")
    finally:
        os.close(descriptor)


def validate_target_inventory(directory_fd: int) -> None:
    allowed_entries = (
        {spec.name for spec in SPECS} | {MANIFEST_NAME, LOCK_NAME}
    )
    if not set(os.listdir(directory_fd)).issubset(allowed_entries):
        raise SecretError("protected directory has an unexpected entry")


def validate_operator_tree(
    directory_fd: int, owner: int, group: int
) -> dict[str, bytes]:
    validate_target_inventory(directory_fd)
    contents = validate_existing(directory_fd, OPERATOR_SPECS, owner, group)
    if read_manifest(directory_fd, owner, group) != render_manifest(contents):
        raise SecretError("operator bundle manifest does not match the installed files")
    return contents


def acquire_bundle_lock(directory_fd: int, owner: int, group: int) -> int:
    expected_group = 0 if owner == 0 else group
    descriptor: int | None = None
    for _ in range(3):
        try:
            descriptor = os.open(
                LOCK_NAME,
                os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o600,
                dir_fd=directory_fd,
            )
            break
        except FileExistsError:
            try:
                descriptor = os.open(
                    LOCK_NAME,
                    os.O_RDWR | os.O_NOFOLLOW,
                    dir_fd=directory_fd,
                )
                break
            except FileNotFoundError:
                continue
            except OSError as exc:
                raise SecretError("cannot open the operator bundle lock") from exc
        except OSError as exc:
            raise SecretError("cannot open the operator bundle lock") from exc
    if descriptor is None:
        raise SecretError("cannot open the operator bundle lock")
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != expected_group
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            raise SecretError("operator bundle lock has unsafe metadata")
        deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise SecretError("operator bundle lock is busy")
                time.sleep(0.05)
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def remove_orphaned_pending_files(
    directory_fd: int, owner: int, group: int
) -> None:
    canonical_names = [spec.name for spec in OPERATOR_SPECS] + [MANIFEST_NAME]
    patterns = [
        re.compile(rf"\.{re.escape(name)}\.[0-9a-f]{{24}}\.pending")
        for name in canonical_names
    ]
    removed = False
    expected_groups = {0 if owner == 0 else group, group}
    for name in os.listdir(directory_fd):
        if not any(pattern.fullmatch(name) for pattern in patterns):
            continue
        metadata = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid not in expected_groups
            or stat.S_IMODE(metadata.st_mode) not in {0o400, 0o440, 0o600}
        ):
            raise SecretError("orphaned operator bundle staging file is unsafe")
        os.unlink(name, dir_fd=directory_fd)
        removed = True
    if removed:
        os.fsync(directory_fd)


def target_metadata(
    spec: SecretSpec, owner: int, application_group: int
) -> tuple[int, int]:
    if spec.application_readable:
        return application_group, 0o440
    root_group = 0 if owner == 0 else application_group
    return root_group, 0o400


def read_checked_file(
    directory_fd: int,
    spec: SecretSpec,
    *,
    owner: int,
    group: int | None,
    target: bool,
) -> bytes:
    try:
        descriptor = os.open(spec.name, FILE_FLAGS, dir_fd=directory_fd)
    except FileNotFoundError as exc:
        subject = (
            "operator-supplied secret" if not spec.generated else "generated input"
        )
        raise SecretError(f"{subject} {spec.name} is missing") from exc
    except OSError as exc:
        raise SecretError(f"operator input {spec.name} is unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        mode = stat.S_IMODE(metadata.st_mode)
        invalid = (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
        )
        if target:
            expected_group, expected_mode = target_metadata(spec, owner, group)
            invalid = (
                invalid or metadata.st_gid != expected_group or mode != expected_mode
            )
        else:
            invalid = invalid or mode & 0o077 != 0 or mode & 0o600 == 0
        if invalid:
            raise SecretError(f"operator input {spec.name} has unsafe metadata")
        content = os.read(descriptor, MAX_INPUT_BYTES + 1)
        validate_content(spec, content)
        return content
    finally:
        os.close(descriptor)


def validate_existing(
    directory_fd: int, specs: tuple[SecretSpec, ...], owner: int, group: int
) -> dict[str, bytes]:
    contents = {
        spec.name: read_checked_file(
            directory_fd, spec, owner=owner, group=group, target=True
        )
        for spec in specs
    }
    if specs == OPERATOR_SPECS:
        validate_bundle(contents)
    return contents


def materialize_generated(
    directory_fd: int, spec: SecretSpec, owner: int, group: int
) -> None:
    try:
        descriptor = os.open(spec.name, FILE_FLAGS, dir_fd=directory_fd)
    except FileNotFoundError:
        descriptor = os.open(
            spec.name,
            os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        try:
            content = secrets.token_urlsafe(48).encode("ascii") + b"\n"
            validate_content(spec, content)
            view = memoryview(content)
            while view:
                written = os.write(descriptor, view)
                if written <= 0:
                    raise SecretError(f"cannot write generated input {spec.name}")
                view = view[written:]
            expected_group, expected_mode = target_metadata(spec, owner, group)
            os.fchown(descriptor, owner, expected_group)
            os.fchmod(descriptor, expected_mode)
            os.fsync(descriptor)
        except Exception:
            os.close(descriptor)
            try:
                os.unlink(spec.name, dir_fd=directory_fd)
            except OSError:
                pass
            raise
        os.close(descriptor)
        read_checked_file(directory_fd, spec, owner=owner, group=group, target=True)
        return
    except OSError as exc:
        raise SecretError(
            f"cannot open protected input {spec.name}: {exc.strerror}"
        ) from exc
    os.close(descriptor)
    read_checked_file(directory_fd, spec, owner=owner, group=group, target=True)


def install_operator_bundle(
    target_fd: int,
    source_root: Path,
    *,
    owner: int,
    group: int,
) -> None:
    source_fd = open_directory(source_root)
    temporary_names: list[str] = []
    try:
        source_metadata = os.fstat(source_fd)
        source_group = 0 if owner == 0 else group
        if (
            source_metadata.st_uid != owner
            or source_metadata.st_gid != source_group
            or stat.S_IMODE(source_metadata.st_mode) != 0o700
        ):
            raise SecretError(
                "operator source directory must have the expected owner and mode 0700"
            )
        if set(os.listdir(source_fd)) != {spec.name for spec in OPERATOR_SPECS}:
            raise SecretError("operator source directory has an unexpected entry")
        contents = {
            spec.name: read_checked_file(
                source_fd, spec, owner=owner, group=None, target=False
            )
            for spec in OPERATOR_SPECS
        }
        validate_bundle(contents)

        needs_update = False
        for spec in OPERATOR_SPECS:
            try:
                existing = read_checked_file(
                    target_fd, spec, owner=owner, group=group, target=True
                )
            except SecretError as exc:
                try:
                    os.stat(spec.name, dir_fd=target_fd, follow_symlinks=False)
                except FileNotFoundError:
                    needs_update = True
                    continue
                raise exc
            if existing != contents[spec.name]:
                needs_update = True
        if not needs_update:
            try:
                existing_manifest = read_manifest(target_fd, owner, group)
            except SecretError:
                needs_update = True
            else:
                if existing_manifest == render_manifest(contents):
                    return
                needs_update = True

        pending: dict[str, str] = {}
        for spec in OPERATOR_SPECS:
            temporary_name = f".{spec.name}.{secrets.token_hex(12)}.pending"
            descriptor = os.open(
                temporary_name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o600,
                dir_fd=target_fd,
            )
            temporary_names.append(temporary_name)
            try:
                view = memoryview(contents[spec.name])
                while view:
                    written = os.write(descriptor, view)
                    if written <= 0:
                        raise SecretError(f"cannot stage operator input {spec.name}")
                    view = view[written:]
                expected_group, expected_mode = target_metadata(spec, owner, group)
                os.fchown(descriptor, owner, expected_group)
                os.fchmod(descriptor, expected_mode)
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
            pending[spec.name] = temporary_name

        manifest_temporary_name = (
            f".{MANIFEST_NAME}.{secrets.token_hex(12)}.pending"
        )
        descriptor = os.open(
            manifest_temporary_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=target_fd,
        )
        temporary_names.append(manifest_temporary_name)
        try:
            view = memoryview(render_manifest(contents))
            while view:
                written = os.write(descriptor, view)
                if written <= 0:
                    raise SecretError("cannot stage the operator bundle manifest")
                view = view[written:]
            manifest_group = 0 if owner == 0 else group
            os.fchown(descriptor, owner, manifest_group)
            os.fchmod(descriptor, 0o400)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)

        for spec in OPERATOR_SPECS:
            os.replace(
                pending[spec.name],
                spec.name,
                src_dir_fd=target_fd,
                dst_dir_fd=target_fd,
            )
            temporary_names.remove(pending[spec.name])
        os.fsync(target_fd)
        os.replace(
            manifest_temporary_name,
            MANIFEST_NAME,
            src_dir_fd=target_fd,
            dst_dir_fd=target_fd,
        )
        temporary_names.remove(manifest_temporary_name)
        os.fsync(target_fd)
        validate_operator_tree(target_fd, owner, group)
    finally:
        for temporary_name in temporary_names:
            try:
                os.unlink(temporary_name, dir_fd=target_fd)
            except OSError:
                pass
        os.close(source_fd)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--database-only", action="store_true")
    mode.add_argument("--operator-only", action="store_true")
    mode.add_argument("--install-operator-from", type=Path)
    parser.add_argument("--test-root", type=Path, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.test_root is None and os.geteuid() != 0:
        return fail("production mode requires root")
    owner = 0 if args.test_root is None else os.geteuid()
    group = 10001 if args.test_root is None else os.getegid()
    descriptors: list[int] = []
    lock_descriptor: int | None = None
    try:
        directory_fd, descriptors = (
            production_directory()
            if args.test_root is None
            else test_directory(args.test_root)
        )
        if not args.database_only:
            lock_descriptor = acquire_bundle_lock(directory_fd, owner, group)
            remove_orphaned_pending_files(directory_fd, owner, group)
            validate_target_inventory(directory_fd)
            validate_manifest_target_metadata(directory_fd, owner, group)
        if args.install_operator_from is not None:
            if not args.install_operator_from.is_absolute():
                raise SecretError("operator source directory must be absolute")
            install_operator_bundle(
                directory_fd,
                args.install_operator_from,
                owner=owner,
                group=group,
            )
        elif args.database_only:
            for spec in GENERATED_SPECS:
                materialize_generated(directory_fd, spec, owner, group)
            os.fsync(directory_fd)
        elif args.operator_only:
            validate_operator_tree(directory_fd, owner, group)
        else:
            validate_operator_tree(directory_fd, owner, group)
            for spec in GENERATED_SPECS:
                materialize_generated(directory_fd, spec, owner, group)
            os.fsync(directory_fd)
    except (OSError, SecretError) as exc:
        return fail(str(exc))
    finally:
        if lock_descriptor is not None:
            try:
                os.close(lock_descriptor)
            except OSError:
                pass
        for descriptor in reversed(descriptors):
            try:
                os.close(descriptor)
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
