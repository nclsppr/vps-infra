#!/usr/bin/env python3
"""Create or verify the Parkventory secrets generated on Atlas."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import secrets
import stat
import sys
import time
from pathlib import Path


EX_CONFIG = 78
PRODUCTION_ROOT = Path("/etc/vps/secrets/parkventory")
MANIFEST_NAME = "parkventory-database-secret-manifest.json"
MANIFEST_CONTRACT = "vps-infra.parkventory-database-secrets.v1"
GENERATION_MARKER_NAME = "parkventory-secret-generation.json"
GENERATION_MARKER_CONTRACT = "vps-infra.parkventory-secret-generation.v1"
MATERIALIZER_NAME = "materialize-parkventory-secrets"
TARGET_GENERATION = 1
DATABASE_CREDENTIAL_FILES = (
    "parkventory-postgres-migrator-password",
    "parkventory-postgres-runtime-password",
)
LOCAL_APPLICATION_CREDENTIAL_FILES = (
    "parkventory-oidc-state-secret",
    "parkventory-oidc-token-encryption-secret",
)
GENERATED_CREDENTIAL_FILES = (
    DATABASE_CREDENTIAL_FILES + LOCAL_APPLICATION_CREDENTIAL_FILES
)
CREDENTIAL_FILES = GENERATED_CREDENTIAL_FILES
REGISTERED_SECRETS = (
    {
        "id": "parkventory.oidc-state-secret",
        "file": "parkventory-oidc-state-secret",
    },
    {
        "id": "parkventory.oidc-token-encryption-secret",
        "file": "parkventory-oidc-token-encryption-secret",
    },
    {
        "id": "parkventory.postgres-migrator-password",
        "file": "parkventory-postgres-migrator-password",
    },
    {
        "id": "parkventory.postgres-runtime-password",
        "file": "parkventory-postgres-runtime-password",
    },
)
GENERATED_SECRET_RE = re.compile(rb"[A-Za-z0-9_-]{64}\n")
MAX_FILE_BYTES = 4096
LOCK_TIMEOUT_SECONDS = 30
TEST_GUARD = "VPS_PARKVENTORY_SECRET_TESTING"


class SecretError(RuntimeError):
    """The protected secret tree differs from the reviewed contract."""


def fail(message: str) -> int:
    print(f"Parkventory secret materialization refused: {message}", file=sys.stderr)
    return EX_CONFIG


def canonical_json(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode(
        "ascii"
    )


def require_directory(path: Path, uid: int, gid: int, mode: int) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise SecretError(f"cannot inspect protected directory {path}: {exc.strerror}") from exc
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != uid
        or metadata.st_gid != gid
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        raise SecretError(
            f"protected directory {path} must be {uid}:{gid} with mode {mode:04o}"
        )


def production_root(create: bool) -> Path:
    expected = (
        (Path("/etc/vps"), 0o755),
        (Path("/etc/vps/secrets"), 0o700),
        (PRODUCTION_ROOT, 0o700),
    )
    for path, mode in expected:
        if create:
            try:
                path.mkdir(mode=mode)
            except FileExistsError:
                pass
        require_directory(path, 0, 0, mode)
    return PRODUCTION_ROOT


def absent_production_root_is_safe() -> bool:
    """Validate every existing parent and report whether the leaf is absent."""
    for path, mode in (
        (Path("/etc/vps"), 0o755),
        (Path("/etc/vps/secrets"), 0o700),
        (PRODUCTION_ROOT, 0o700),
    ):
        try:
            path.lstat()
        except FileNotFoundError:
            return True
        require_directory(path, 0, 0, mode)
    return False


def test_root(path: Path) -> Path:
    if os.geteuid() == 0 or os.environ.get(TEST_GUARD) != "1":
        raise SecretError("test mode requires its explicit unprivileged guard")
    if not path.is_absolute():
        raise SecretError("test root must be absolute")
    require_directory(path, os.geteuid(), os.getegid(), 0o700)
    return path


def read_regular(
    root: Path,
    name: str,
    *,
    uid: int,
    gid: int,
    mode: int,
    required: bool,
) -> bytes | None:
    path = root / name
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        if required:
            raise SecretError(f"protected file {name} is missing")
        return None
    except OSError as exc:
        raise SecretError(f"cannot open protected file {name}: {exc.strerror}") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != uid
            or metadata.st_gid != gid
            or stat.S_IMODE(metadata.st_mode) != mode
            or not 1 <= metadata.st_size <= MAX_FILE_BYTES
        ):
            raise SecretError(f"protected file {name} has unsafe metadata")
        content = os.read(descriptor, MAX_FILE_BYTES + 1)
        if len(content) != metadata.st_size:
            raise SecretError(f"protected file {name} changed while it was read")
        return content
    finally:
        os.close(descriptor)


def acquire_materializer_lock(root: Path) -> int:
    try:
        descriptor = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        raise SecretError("cannot open the protected directory lock") from exc
    try:
        deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return descriptor
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise SecretError("the protected directory lock is busy")
                time.sleep(0.05)
    except Exception:
        os.close(descriptor)
        raise


def owned_pending_files(directory: int) -> dict[str, str]:
    canonical_names = GENERATED_CREDENTIAL_FILES + (
        MANIFEST_NAME,
        GENERATION_MARKER_NAME,
    )
    result: dict[str, str] = {}
    for entry in sorted(os.listdir(directory)):
        for canonical_name in canonical_names:
            prefix = f".{canonical_name}."
            if not entry.startswith(prefix) or not entry.endswith(".pending"):
                continue
            pattern = re.compile(
                rf"\.{re.escape(canonical_name)}\.[0-9a-f]{{32}}\.pending"
            )
            if pattern.fullmatch(entry) is None or canonical_name in result:
                raise SecretError("generated-secret staging residue is unsafe")
            result[canonical_name] = entry
            break
    return result


def recover_owned_pending_files(
    directory: int, *, uid: int, application_gid: int, manifest_gid: int
) -> None:
    candidates = owned_pending_files(directory)
    validated: list[tuple[str, int, int]] = []
    for canonical_name, pending_name in candidates.items():
        if canonical_name in GENERATED_CREDENTIAL_FILES:
            expected_gid = application_gid
            expected_mode = 0o440
            pending_metadata = {
                (manifest_gid, 0o600),
                (application_gid, 0o600),
                (application_gid, expected_mode),
            }
        else:
            expected_gid = manifest_gid
            expected_mode = 0o400
            pending_metadata = {
                (manifest_gid, 0o600),
                (manifest_gid, expected_mode),
            }
        try:
            pending_fd = os.open(
                pending_name,
                os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                dir_fd=directory,
            )
        except OSError as exc:
            raise SecretError("generated-secret staging residue is unsafe") from exc
        try:
            pending = os.fstat(pending_fd)
            if (
                not stat.S_ISREG(pending.st_mode)
                or pending.st_uid != uid
                or (pending.st_gid, stat.S_IMODE(pending.st_mode))
                not in pending_metadata
                or not 0 <= pending.st_size <= MAX_FILE_BYTES
            ):
                raise SecretError("generated-secret staging residue is unsafe")
        finally:
            os.close(pending_fd)

        try:
            canonical_fd = os.open(
                canonical_name,
                os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                dir_fd=directory,
            )
        except FileNotFoundError:
            canonical = None
        except OSError as exc:
            raise SecretError("generated-secret staging residue is unsafe") from exc
        else:
            try:
                canonical = os.fstat(canonical_fd)
                if (
                    not stat.S_ISREG(canonical.st_mode)
                    or canonical.st_uid != uid
                    or canonical.st_gid != expected_gid
                    or stat.S_IMODE(canonical.st_mode) != expected_mode
                    or not 1 <= canonical.st_size <= MAX_FILE_BYTES
                ):
                    raise SecretError("generated-secret staging residue is unsafe")
            finally:
                os.close(canonical_fd)

        same_inode = canonical is not None and (
            pending.st_dev,
            pending.st_ino,
        ) == (canonical.st_dev, canonical.st_ino)
        if same_inode:
            if pending.st_nlink != 2 or canonical.st_nlink != 2:
                raise SecretError("generated-secret staging residue is unsafe")
        elif pending.st_nlink != 1 or (
            canonical is not None and canonical.st_nlink != 1
        ):
            raise SecretError("generated-secret staging residue is unsafe")
        validated.append((pending_name, pending.st_dev, pending.st_ino))

    for pending_name, device, inode in validated:
        metadata = os.stat(pending_name, dir_fd=directory, follow_symlinks=False)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_dev != device
            or metadata.st_ino != inode
        ):
            raise SecretError("generated-secret staging residue changed during recovery")
    for pending_name, _, _ in validated:
        os.unlink(pending_name, dir_fd=directory)
    if validated:
        os.fsync(directory)


def reject_owned_pending_files(directory: int) -> None:
    if owned_pending_files(directory):
        raise SecretError("generated-secret staging residue requires apply recovery")


def publish_exclusive(
    root: Path,
    name: str,
    content: bytes,
    *,
    uid: int,
    gid: int,
    mode: int,
) -> bool:
    directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    temporary = f".{name}.{secrets.token_hex(16)}.pending"
    descriptor = -1
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory,
        )
        os.fchown(descriptor, uid, gid)
        os.fchmod(descriptor, mode)
        written = 0
        while written < len(content):
            written += os.write(descriptor, content[written:])
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        try:
            os.link(
                temporary,
                name,
                src_dir_fd=directory,
                dst_dir_fd=directory,
                follow_symlinks=False,
            )
            os.fsync(directory)
            return True
        except FileExistsError:
            return False
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass
        else:
            os.fsync(directory)
        os.close(directory)


def password_manifest(passwords: dict[str, bytes]) -> bytes:
    return canonical_json(
        {
            "contract": MANIFEST_CONTRACT,
            "sha256": {
                name: hashlib.sha256(passwords[name]).hexdigest()
                for name in DATABASE_CREDENTIAL_FILES
            },
        }
    )


def generation_marker() -> bytes:
    return canonical_json(
        {
            "contract": GENERATION_MARKER_CONTRACT,
            "materializer": MATERIALIZER_NAME,
            "secrets": REGISTERED_SECRETS,
            "target_generation": TARGET_GENERATION,
        }
    )


def inspect_generated_secrets(
    root: Path, *, uid: int, application_gid: int, required: bool
) -> dict[str, bytes | None]:
    result: dict[str, bytes | None] = {}
    for name in GENERATED_CREDENTIAL_FILES:
        content = read_regular(
            root,
            name,
            uid=uid,
            gid=application_gid,
            mode=0o440,
            required=required,
        )
        if content is not None and GENERATED_SECRET_RE.fullmatch(content) is None:
            raise SecretError(f"protected file {name} has an invalid generated-secret format")
        result[name] = content
    database_passwords = [
        result[name]
        for name in DATABASE_CREDENTIAL_FILES
        if result[name] is not None
    ]
    if len(database_passwords) == 2 and database_passwords[0] == database_passwords[1]:
        raise SecretError("migrator and runtime passwords must be distinct")
    application_secrets = [
        result[name]
        for name in LOCAL_APPLICATION_CREDENTIAL_FILES
        if result[name] is not None
    ]
    if len(application_secrets) == 2 and application_secrets[0] == application_secrets[1]:
        raise SecretError("OIDC state and token encryption secrets must be distinct")
    return result


def materialize(root: Path, mode: str, *, production: bool) -> dict[str, object]:
    uid = 0 if production else os.geteuid()
    application_gid = 10001 if production else os.getegid()
    manifest_gid = 0 if production else os.getegid()
    changed = False
    generated_secrets = inspect_generated_secrets(
        root, uid=uid, application_gid=application_gid, required=mode == "check"
    )
    installed_marker = read_regular(
        root,
        GENERATION_MARKER_NAME,
        uid=uid,
        gid=manifest_gid,
        mode=0o400,
        required=mode == "check",
    )
    expected_marker = generation_marker()
    if installed_marker is not None and installed_marker != expected_marker:
        raise SecretError("secret generation marker differs from the authorized contract")
    if installed_marker is not None:
        generated_secrets = inspect_generated_secrets(
            root, uid=uid, application_gid=application_gid, required=True
        )

    if mode == "dry-run":
        changed = any(value is None for value in generated_secrets.values())
        if not changed:
            database_passwords = {
                name: generated_secrets[name]
                for name in DATABASE_CREDENTIAL_FILES
                if generated_secrets[name] is not None
            }
            expected_manifest = password_manifest(database_passwords)
            installed_manifest = read_regular(
                root,
                MANIFEST_NAME,
                uid=uid,
                gid=manifest_gid,
                mode=0o400,
                required=installed_marker is not None,
            )
            if installed_manifest is not None and installed_manifest != expected_manifest:
                raise SecretError("database secret manifest does not match the password files")
            changed = installed_manifest is None or installed_marker is None
        return {"changed": changed, "mode": mode, "ready": not changed}

    if mode == "apply":
        if installed_marker is not None:
            installed_manifest = read_regular(
                root,
                MANIFEST_NAME,
                uid=uid,
                gid=manifest_gid,
                mode=0o400,
                required=True,
            )
            database_passwords = {
                name: generated_secrets[name]
                for name in DATABASE_CREDENTIAL_FILES
                if generated_secrets[name] is not None
            }
            if installed_manifest != password_manifest(database_passwords):
                raise SecretError("database secret manifest does not match the password files")
            return {"changed": False, "mode": mode, "ready": True}
        for name in GENERATED_CREDENTIAL_FILES:
            if generated_secrets[name] is None:
                value = secrets.token_urlsafe(48).encode("ascii") + b"\n"
                if GENERATED_SECRET_RE.fullmatch(value) is None:
                    raise SecretError("the secret generator returned an invalid value")
                changed = publish_exclusive(
                    root,
                    name,
                    value,
                    uid=uid,
                    gid=application_gid,
                    mode=0o440,
                ) or changed
        generated_secrets = inspect_generated_secrets(
            root, uid=uid, application_gid=application_gid, required=True
        )

    database_passwords = {
        name: generated_secrets[name]
        for name in DATABASE_CREDENTIAL_FILES
        if generated_secrets[name] is not None
    }
    expected_manifest = password_manifest(database_passwords)
    installed_manifest = read_regular(
        root,
        MANIFEST_NAME,
        uid=uid,
        gid=manifest_gid,
        mode=0o400,
        required=mode == "check",
    )
    if installed_manifest is None:
        changed = publish_exclusive(
            root,
            MANIFEST_NAME,
            expected_manifest,
            uid=uid,
            gid=manifest_gid,
            mode=0o400,
        ) or changed
        installed_manifest = read_regular(
            root,
            MANIFEST_NAME,
            uid=uid,
            gid=manifest_gid,
            mode=0o400,
            required=True,
        )
    if installed_manifest != expected_manifest:
        raise SecretError("database secret manifest does not match the password files")

    if installed_marker is None:
        changed = publish_exclusive(
            root,
            GENERATION_MARKER_NAME,
            expected_marker,
            uid=uid,
            gid=manifest_gid,
            mode=0o400,
        ) or changed
        installed_marker = read_regular(
            root,
            GENERATION_MARKER_NAME,
            uid=uid,
            gid=manifest_gid,
            mode=0o400,
            required=True,
        )
    if installed_marker != expected_marker:
        raise SecretError("secret generation marker differs from the authorized contract")
    return {"changed": changed, "mode": mode, "ready": True}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--apply", dest="mode", action="store_const", const="apply")
    modes.add_argument("--check", dest="mode", action="store_const", const="check")
    modes.add_argument("--dry-run", dest="mode", action="store_const", const="dry-run")
    parser.set_defaults(mode="check")
    parser.add_argument("--test-root", type=Path, help=argparse.SUPPRESS)
    return parser.parse_args()


def main() -> int:
    arguments = parse_args()
    production = arguments.test_root is None
    try:
        if production:
            if os.geteuid() != 0:
                raise SecretError("production secret materialization requires root")
            if arguments.mode == "dry-run" and absent_production_root_is_safe():
                print(
                    canonical_json(
                        {"changed": True, "mode": "dry-run", "ready": False}
                    ).decode("ascii"),
                    end="",
                )
                return 0
            root = production_root(create=arguments.mode == "apply")
        else:
            root = test_root(arguments.test_root)
        uid = 0 if production else os.geteuid()
        application_gid = 10001 if production else os.getegid()
        manifest_gid = 0 if production else os.getegid()
        lock = acquire_materializer_lock(root)
        try:
            if arguments.mode == "apply":
                recover_owned_pending_files(
                    lock,
                    uid=uid,
                    application_gid=application_gid,
                    manifest_gid=manifest_gid,
                )
            else:
                reject_owned_pending_files(lock)
            result = materialize(root, arguments.mode, production=production)
        finally:
            os.close(lock)
    except (OSError, SecretError) as exc:
        return fail(str(exc))
    print(canonical_json(result).decode("ascii"), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
