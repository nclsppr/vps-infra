#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly EX_USAGE=64
readonly EX_CONFIG=78
readonly EXPECTED_ORIGIN=https://github.com/nclsppr/vps-infra.git
readonly caller_path=${PATH:-/usr/local/bin:/usr/bin:/bin}
readonly system_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PATH=$system_path
export PATH
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly SCRIPT_DIR
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd -P)
readonly REPOSITORY_ROOT

fail() {
  local message=$1
  local status=${2:-1}
  echo "amorçage refusé : $message" >&2
  exit "$status"
}

if (($# != 0)); then
  fail "les arguments en ligne de commande ne sont pas acceptés" "$EX_USAGE"
fi

resolve_executable() {
  local name=$1
  local path
  path=$(PATH="$caller_path" type -P -- "$name") || \
    fail "commande requise indisponible : $name" "$EX_CONFIG"
  realpath -- "$path"
}

readonly caller_home=${HOME:-/nonexistent}
git_executable=$(resolve_executable git)
tar_executable=$(resolve_executable tar)
mise_executable=$(resolve_executable mise)
mktemp_executable=$(resolve_executable mktemp)
env_executable=$(resolve_executable env)
readonly git_executable tar_executable mise_executable mktemp_executable env_executable

validator="$SCRIPT_DIR/validate-ansible-inputs"
python_executable="$REPOSITORY_ROOT/.venv/bin/python"
[[ -f $validator && ! -L $validator && -x $validator ]] || \
  fail "le validateur des entrées opérateur est indisponible" "$EX_CONFIG"
[[ -x $python_executable ]] || \
  fail "exécuter make setup avant l'amorçage" "$EX_CONFIG"
python_executable=$(realpath -- "$python_executable") || \
  fail "l'interpréteur Python verrouillé ne peut pas être résolu" "$EX_CONFIG"
readonly validator python_executable

operator_inventory=${ANSIBLE_INVENTORY:-}
operator_extra_vars=${ANSIBLE_EXTRA_VARS:-}
[[ -n $operator_inventory && -f $operator_inventory && ! -L $operator_inventory ]] || \
  fail "ANSIBLE_INVENTORY doit désigner un fichier d'inventaire local régulier" "$EX_USAGE"
[[ -n $operator_extra_vars && -f $operator_extra_vars && ! -L $operator_extra_vars ]] || \
  fail "ANSIBLE_EXTRA_VARS doit désigner un fichier local régulier de clés publiques" "$EX_USAGE"
operator_inventory=$(realpath -- "$operator_inventory")
operator_extra_vars=$(realpath -- "$operator_extra_vars")
readonly operator_inventory operator_extra_vars

validate_operator_inputs() {
  local validator_path=$1
  local inventory_path=$2
  local extra_vars_path=$3
  "$env_executable" -i \
    HOME="$caller_home" \
    PATH="$system_path" \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONSAFEPATH=1 \
    "$python_executable" "$validator_path" \
      --mode bootstrap \
      --inventory "$inventory_path" \
      --extra-vars "$extra_vars_path"
}

validate_operator_inputs "$validator" "$operator_inventory" "$operator_extra_vars" || \
  fail "la validation des entrées opérateur a échoué" "$EX_CONFIG"

ssh_auth_sock=${SSH_AUTH_SOCK:-}
if [[ -n $ssh_auth_sock ]]; then
  ssh_auth_sock=$(realpath -- "$ssh_auth_sock") || \
    fail "SSH_AUTH_SOCK ne peut pas être résolu vers un chemin local" "$EX_CONFIG"
  [[ -S $ssh_auth_sock && -O $ssh_auth_sock ]] || \
    fail "SSH_AUTH_SOCK doit désigner un socket Unix appartenant à l'appelant" "$EX_CONFIG"
fi
readonly ssh_auth_sock

temporary_root=$("$mktemp_executable" -d /tmp/vps-b.XXXXXXXX)
readonly temporary_root
checkout="$temporary_root/checkout"
isolated_home="$temporary_root/home"
control_path_dir="$temporary_root/cp"
input_directory="$temporary_root/input"
inventory="$input_directory/inventory.yml"
extra_vars="$input_directory/public-keys.yml"
readonly checkout isolated_home control_path_dir input_directory inventory extra_vars

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  if [[ -d $temporary_root && $temporary_root != / ]]; then
    rm -rf -- "$temporary_root"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir -m 0700 -- \
  "$checkout" "$isolated_home" "$control_path_dir" "$input_directory"
cp -- "$operator_inventory" "$inventory"
cp -- "$operator_extra_vars" "$extra_vars"
chmod 0600 "$inventory" "$extra_vars"

# Validate the private copies to close the change window between validation and use.
validate_operator_inputs "$validator" "$inventory" "$extra_vars" || \
  fail "la validation des copies des entrées opérateur a échoué" "$EX_CONFIG"

safe_git() {
  "$env_executable" -i \
    HOME="$caller_home" \
    PATH="$system_path" \
    LC_ALL=C \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    "$git_executable" \
      -c protocol.file.allow=never \
      -c protocol.ext.allow=never \
      "$@"
}

origin_url=$(safe_git -C "$REPOSITORY_ROOT" remote get-url origin 2>/dev/null) || \
  fail "le dépôt ne possède aucune remote origin" "$EX_CONFIG"
[[ $origin_url == "$EXPECTED_ORIGIN" ]] || \
  fail "l'URL origin diffère de la liste d'autorisation du dépôt" "$EX_CONFIG"

safe_git -C "$REPOSITORY_ROOT" fetch \
  --force \
  --no-tags \
  --no-recurse-submodules \
  origin \
  +refs/heads/main:refs/remotes/origin/main || \
  fail "la récupération bornée de origin/main a échoué"

revision=$(safe_git -C "$REPOSITORY_ROOT" rev-parse --verify \
  'refs/remotes/origin/main^{commit}') || fail "origin/main ne peut pas être résolu vers un commit"
[[ $revision =~ ^[0-9a-f]{40}$ ]] || fail "origin/main n'a pas produit un SHA Git complet en minuscules"
readonly revision

ansible_environment=(
  "HOME=$isolated_home"
  "PATH=$checkout/.venv/bin:$system_path"
  "LC_ALL=C.UTF-8"
  "ANSIBLE_CONFIG=$checkout/ansible/ansible.cfg"
  "ANSIBLE_COLLECTIONS_PATH=$checkout/.cache/ansible/collections"
  "ANSIBLE_SSH_CONTROL_PATH_DIR=$control_path_dir"
)
if [[ -n $ssh_auth_sock ]]; then
  ansible_environment+=("SSH_AUTH_SOCK=$ssh_auth_sock")
fi
readonly -a ansible_environment

safe_git -C "$REPOSITORY_ROOT" archive --format=tar "$revision" | \
  "$tar_executable" -xf - -C "$checkout"

snapshot_validator="$checkout/scripts/validate-ansible-inputs"
[[ -f $snapshot_validator && ! -L $snapshot_validator && -x $snapshot_validator ]] || \
  fail "le snapshot origin/main ne contient pas de validateur d'entrées exécutable" "$EX_CONFIG"
validate_operator_inputs "$snapshot_validator" "$inventory" "$extra_vars" || \
  fail "les entrées opérateur sont refusées par le snapshot origin/main" "$EX_CONFIG"
readonly snapshot_validator

clean_command() {
  "$env_executable" -i \
    HOME="$isolated_home" \
    PATH="$system_path" \
    LC_ALL=C.UTF-8 \
    XDG_CACHE_HOME="$isolated_home/.cache" \
    XDG_CONFIG_HOME="$isolated_home/.config" \
    XDG_DATA_HOME="$isolated_home/.local/share" \
    "$@"
}

(
  cd "$checkout"
  clean_command "$mise_executable" trust "$checkout/mise.toml"
  clean_command "$mise_executable" install --locked
  clean_command "$mise_executable" exec -- uv sync --locked
  cd ansible
  clean_command ../.venv/bin/ansible-galaxy collection install \
    --requirements-file collections/requirements.yml \
    --collections-path ../.cache/ansible/collections
  "$env_executable" -i "${ansible_environment[@]}" \
    ../.venv/bin/ansible-playbook \
      --inventory "$inventory" \
      --extra-vars "@$extra_vars" \
      playbooks/bootstrap.yml
)
