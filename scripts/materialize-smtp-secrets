#!/usr/bin/env python3
"""Install or check one exact Atlas SMTP credential set."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import secrets
import stat
import sys
import time
from dataclasses import dataclass
from pathlib import Path


EX_USAGE = 64
EX_CONFIG = 78
PRODUCTION_ROOT = Path("/etc/vps/secrets")
DEPLOYMENT_LOCK_PATH = Path("/run/lock/vps-static.lock")
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
MAX_VALUE_BYTES = 513
MAX_MARKER_BYTES = 2048
LOCK_TIMEOUT_SECONDS = 30
MARKER_CONTRACT = "atlas-smtp-credentials"
MARKER_VERSION = 1
MARKER_SUFFIX = "smtp-generation.json"
RELAY_FQDN = b"smtp.tem.scaleway.com\n"
USERNAME_PATTERN = re.compile(
    rb"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\n"
)
OPAQUE_PATTERN = re.compile(rb"[\x21-\x7e]{16,512}\n")


class MaterializationError(RuntimeError):
    """Raised when an SMTP credential set differs from the public contract."""


class UsageParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.print_usage(sys.stderr)
        print(f"{self.prog}: error: {message}", file=sys.stderr)
        raise SystemExit(EX_USAGE)


@dataclass(frozen=True)
class Profile:
    product: str
    include_host: bool
    storage_only: bool = False
    registry_generation: int = 1

    @property
    def username_name(self) -> str:
        return f"{self.product}-smtp-username"

    @property
    def password_name(self) -> str:
        return f"{self.product}-smtp-password"

    @property
    def host_name(self) -> str:
        return f"{self.product}-smtp-host"

    @property
    def marker_name(self) -> str:
        return f"{self.product}-{MARKER_SUFFIX}"

    @property
    def source_names(self) -> tuple[str, str]:
        return (self.password_name, self.username_name)

    @property
    def installed_names(self) -> tuple[str, ...]:
        names = [self.password_name, self.username_name]
        if self.include_host:
            names.append(self.host_name)
        return tuple(sorted(names))

    @property
    def secret_ids(self) -> tuple[str, ...]:
        identifiers = [
            f"{self.product}.smtp-password",
            f"{self.product}.smtp-username",
        ]
        if self.include_host:
            identifiers.append(f"{self.product}.smtp-host")
        return tuple(sorted(identifiers))


PROFILES = {
    profile.product: profile
    for profile in (
        Profile("monflorian", include_host=False, storage_only=True),
        Profile("parkventory", include_host=False),
        Profile("surplasse", include_host=True),
    )
}


def fail(message: str) -> int:
    print(f"SMTP credential operation refused: {message}", file=sys.stderr)
    return EX_CONFIG


def validate_directory(
    descriptor: int, label: str, *, owner: int, group: int, mode: int
) -> None:
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != owner
        or metadata.st_gid != group
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        raise MaterializationError(
            f"{label} must be a {owner}:{group} directory with mode {mode:04o}"
        )


def open_directory(path: Path, label: str) -> int:
    try:
        return os.open(path, DIRECTORY_FLAGS)
    except OSError as exc:
        raise MaterializationError(f"cannot open {label}: {exc.strerror}") from exc


def directory_at(
    parent_fd: int, name: str, label: str, *, create: bool, mode: int
) -> int:
    if create:
        try:
            os.mkdir(name, mode=mode, dir_fd=parent_fd)
            os.fsync(parent_fd)
        except FileExistsError:
            pass
        except OSError as exc:
            raise MaterializationError(f"cannot create {label}: {exc.strerror}") from exc
    try:
        descriptor = os.open(name, DIRECTORY_FLAGS, dir_fd=parent_fd)
    except OSError as exc:
        raise MaterializationError(f"cannot open {label}: {exc.strerror}") from exc
    try:
        validate_directory(descriptor, label, owner=0, group=0, mode=mode)
    except Exception:
        os.close(descriptor)
        raise
    return descriptor


def production_directory(profile: Profile, *, create: bool) -> tuple[int, list[int]]:
    descriptors: list[int] = []
    root_fd = open_directory(Path("/"), "filesystem root")
    descriptors.append(root_fd)
    try:
        etc_fd = os.open("etc", DIRECTORY_FLAGS, dir_fd=root_fd)
    except OSError as exc:
        raise MaterializationError(f"cannot open /etc: {exc.strerror}") from exc
    descriptors.append(etc_fd)
    for name, label, mode in (
        ("vps", "/etc/vps", 0o755),
        ("secrets", str(PRODUCTION_ROOT), 0o700),
        (profile.product, str(PRODUCTION_ROOT / profile.product), 0o700),
    ):
        descriptor = directory_at(
            descriptors[-1], name, label, create=create, mode=mode
        )
        descriptors.append(descriptor)
    return descriptors[-1], descriptors


def test_directory(path: Path) -> tuple[int, list[int]]:
    if os.geteuid() == 0 or os.environ.get("VPS_SMTP_SECRET_TESTING") != "1":
        raise MaterializationError(
            "test-only mode requires an explicit unprivileged test guard"
        )
    if not path.is_absolute():
        raise MaterializationError("test credential root must be absolute")
    descriptor = open_directory(path, "test credential root")
    try:
        validate_directory(
            descriptor,
            "test credential root",
            owner=os.geteuid(),
            group=os.getegid(),
            mode=0o700,
        )
    except Exception:
        os.close(descriptor)
        raise
    return descriptor, [descriptor]


def read_source_value(
    directory_fd: int, name: str, pattern: re.Pattern[bytes], *, owner: int, group: int
) -> bytes:
    try:
        descriptor = os.open(name, FILE_FLAGS, dir_fd=directory_fd)
    except (FileNotFoundError, OSError) as exc:
        raise MaterializationError(f"source file {name} is missing or unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != group
            or stat.S_IMODE(metadata.st_mode) not in {0o400, 0o600}
        ):
            raise MaterializationError(f"source file {name} has unsafe metadata")
        content = os.read(descriptor, MAX_VALUE_BYTES + 1)
        if pattern.fullmatch(content) is None:
            raise MaterializationError(f"source file {name} has invalid framing")
        return content
    finally:
        os.close(descriptor)


def read_source(
    path: Path, profile: Profile, *, owner: int, group: int
) -> dict[str, bytes]:
    if not path.is_absolute():
        raise MaterializationError("credential source directory must be absolute")
    descriptor = open_directory(path, "credential source directory")
    try:
        validate_directory(
            descriptor,
            "credential source directory",
            owner=owner,
            group=group,
            mode=0o700,
        )
        if set(os.listdir(descriptor)) != set(profile.source_names):
            raise MaterializationError(
                "credential source directory has an unexpected entry"
            )
        return {
            profile.password_name: read_source_value(
                descriptor,
                profile.password_name,
                OPAQUE_PATTERN,
                owner=owner,
                group=group,
            ),
            profile.username_name: read_source_value(
                descriptor,
                profile.username_name,
                USERNAME_PATTERN,
                owner=owner,
                group=group,
            ),
        }
    finally:
        os.close(descriptor)


def marker_bytes(profile: Profile, generation: int) -> bytes:
    document = {
        "contract": MARKER_CONTRACT,
        "installed_files": list(profile.installed_names),
        "product": profile.product,
        "registry_generation": generation,
        "secret_ids": list(profile.secret_ids),
        "storage_only": profile.storage_only,
        "version": MARKER_VERSION,
    }
    return (json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n").encode(
        "ascii"
    )


def installed_metadata(profile: Profile, name: str) -> tuple[int, int]:
    if profile.include_host and name == profile.host_name:
        return 0, 0o400
    return 10001, 0o440


def read_regular(
    directory_fd: int,
    name: str,
    *,
    owner: int,
    group: int,
    mode: int,
    maximum: int,
    label: str,
) -> bytes:
    try:
        descriptor = os.open(name, FILE_FLAGS, dir_fd=directory_fd)
    except (FileNotFoundError, OSError) as exc:
        raise MaterializationError(f"{label} is missing or unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != group
            or stat.S_IMODE(metadata.st_mode) != mode
            or not 1 <= metadata.st_size <= maximum
        ):
            raise MaterializationError(f"{label} has unsafe metadata")
        content = os.read(descriptor, maximum + 1)
        if len(content) != metadata.st_size:
            raise MaterializationError(f"{label} changed while it was read")
        return content
    finally:
        os.close(descriptor)


def expected_group(owner: int, test_group: int, production_group: int) -> int:
    return production_group if owner == 0 else test_group


def validate_value(profile: Profile, name: str, content: bytes) -> None:
    if name == profile.username_name:
        valid = USERNAME_PATTERN.fullmatch(content) is not None
    elif name == profile.password_name:
        valid = OPAQUE_PATTERN.fullmatch(content) is not None
    elif profile.include_host and name == profile.host_name:
        valid = content == RELAY_FQDN
    else:
        valid = False
    if not valid:
        raise MaterializationError(f"installed file {name} has invalid framing")


def read_installed_file(
    directory_fd: int,
    profile: Profile,
    name: str,
    *,
    owner: int,
    test_group: int,
) -> bytes:
    production_group, mode = installed_metadata(profile, name)
    content = read_regular(
        directory_fd,
        name,
        owner=owner,
        group=expected_group(owner, test_group, production_group),
        mode=mode,
        maximum=MAX_VALUE_BYTES,
        label=f"installed file {name}",
    )
    validate_value(profile, name, content)
    return content


def validate_installed(
    directory_fd: int,
    profile: Profile,
    generation: int,
    *,
    owner: int,
    test_group: int,
) -> dict[str, bytes]:
    contents: dict[str, bytes] = {}
    for name in profile.installed_names:
        contents[name] = read_installed_file(
            directory_fd,
            profile,
            name,
            owner=owner,
            test_group=test_group,
        )
    marker = read_regular(
        directory_fd,
        profile.marker_name,
        owner=owner,
        group=expected_group(owner, test_group, 0),
        mode=0o400,
        maximum=MAX_MARKER_BYTES,
        label="SMTP generation marker",
    )
    if marker != marker_bytes(profile, generation):
        raise MaterializationError("SMTP generation marker differs from the contract")
    return contents


def owned_entries(directory_fd: int, profile: Profile) -> set[str]:
    owned = set(profile.installed_names) | {profile.marker_name}
    return set(os.listdir(directory_fd)) & owned


def pending_entries(
    directory_fd: int,
    profile: Profile,
    expected: dict[str, bytes] | None,
    *,
    owner: int,
    test_group: int,
) -> dict[str, str]:
    owned = set(profile.installed_names) | {profile.marker_name}
    result: dict[str, str] = {}
    for entry in os.listdir(directory_fd):
        canonical = next(
            (
                name
                for name in owned
                if entry.startswith(f".{name}.") and entry.endswith(".pending")
            ),
            None,
        )
        if canonical is None:
            continue
        pattern = re.compile(
            rf"\.{re.escape(canonical)}\.[0-9a-f]{{24}}\.pending"
        )
        if pattern.fullmatch(entry) is None or canonical in result:
            raise MaterializationError("SMTP credential directory has a foreign staging file")
        if expected is None:
            raise MaterializationError("SMTP credential directory has a staging file")
        production_group, final_mode = (
            (0, 0o400)
            if canonical == profile.marker_name
            else installed_metadata(profile, canonical)
        )
        final_group = expected_group(owner, test_group, production_group)
        try:
            descriptor = os.open(entry, FILE_FLAGS, dir_fd=directory_fd)
        except OSError as exc:
            raise MaterializationError(
                "SMTP credential directory has a foreign staging file"
            ) from exc
        try:
            metadata = os.fstat(descriptor)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_nlink != 1
                or metadata.st_uid != owner
                or metadata.st_gid != final_group
                or stat.S_IMODE(metadata.st_mode) != final_mode
                or metadata.st_size != len(expected[canonical])
            ):
                raise MaterializationError(
                    "SMTP credential directory has a foreign staging file"
                )
            content = os.read(descriptor, len(expected[canonical]) + 1)
            if (
                len(content) != metadata.st_size
                or content != expected[canonical]
            ):
                raise MaterializationError(
                    "SMTP credential staging file differs from the supplied source"
                )
        finally:
            os.close(descriptor)
        result[canonical] = entry
    return result


def stage_file(
    directory_fd: int,
    name: str,
    content: bytes,
    *,
    owner: int,
    group: int,
    mode: int,
) -> str:
    temporary_name = f".{name}.{secrets.token_hex(12)}.pending"
    descriptor = os.open(
        temporary_name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o600,
        dir_fd=directory_fd,
    )
    try:
        view = memoryview(content)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise MaterializationError(f"cannot stage {name}")
            view = view[written:]
        os.fchown(descriptor, owner, group)
        os.fchmod(descriptor, mode)
        os.fsync(descriptor)
    except Exception:
        os.close(descriptor)
        try:
            os.unlink(temporary_name, dir_fd=directory_fd)
        except OSError:
            pass
        raise
    os.close(descriptor)
    return temporary_name


def install(
    directory_fd: int,
    profile: Profile,
    generation: int,
    source: dict[str, bytes],
    *,
    owner: int,
    test_group: int,
) -> None:
    contents = dict(source)
    if profile.include_host:
        contents[profile.host_name] = RELAY_FQDN
    expected = dict(contents)
    expected[profile.marker_name] = marker_bytes(profile, generation)
    owned = set(profile.installed_names) | {profile.marker_name}
    present = owned_entries(directory_fd, profile)
    pending = pending_entries(
        directory_fd,
        profile,
        expected,
        owner=owner,
        test_group=test_group,
    )

    if profile.marker_name in present:
        if present != owned or pending:
            raise MaterializationError("SMTP credential set has a foreign committed state")
        installed = validate_installed(
            directory_fd,
            profile,
            generation,
            owner=owner,
            test_group=test_group,
        )
        if any(installed[name] != contents[name] for name in profile.installed_names):
            raise MaterializationError(
                "SMTP credential rotation requires a new registry generation"
            )
        return

    for name in present:
        installed = read_installed_file(
            directory_fd,
            profile,
            name,
            owner=owner,
            test_group=test_group,
        )
        if installed != contents[name]:
            raise MaterializationError(
                "incomplete SMTP credential set differs from the supplied source"
            )
    if set(pending) & present:
        raise MaterializationError("SMTP credential set has a foreign staging state")

    for temporary_name in pending.values():
        os.unlink(temporary_name, dir_fd=directory_fd)
    if pending:
        os.fsync(directory_fd)

    pending: dict[str, str] = {}
    try:
        for name in profile.installed_names:
            if name in present:
                continue
            group, mode = installed_metadata(profile, name)
            pending[name] = stage_file(
                directory_fd,
                name,
                contents[name],
                owner=owner,
                group=group if owner == 0 else test_group,
                mode=mode,
            )
        marker_group = 0 if owner == 0 else test_group
        pending[profile.marker_name] = stage_file(
            directory_fd,
            profile.marker_name,
            marker_bytes(profile, generation),
            owner=owner,
            group=marker_group,
            mode=0o400,
        )
        for name in profile.installed_names:
            if name not in pending:
                continue
            os.replace(
                pending.pop(name),
                name,
                src_dir_fd=directory_fd,
                dst_dir_fd=directory_fd,
            )
        os.fsync(directory_fd)
        os.replace(
            pending.pop(profile.marker_name),
            profile.marker_name,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
        os.fsync(directory_fd)
        validate_installed(
            directory_fd,
            profile,
            generation,
            owner=owner,
            test_group=test_group,
        )
    finally:
        for temporary_name in pending.values():
            try:
                os.unlink(temporary_name, dir_fd=directory_fd)
            except OSError:
                pass


def acquire_lock(path: Path, *, owner: int, group: int) -> int:
    try:
        descriptor = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError as exc:
        raise MaterializationError("cannot open the shared deployment lock") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != group
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            raise MaterializationError("shared deployment lock has unsafe metadata")
        deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return descriptor
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise MaterializationError("shared deployment lock is busy")
                time.sleep(0.05)
    except Exception:
        os.close(descriptor)
        raise


def use_inherited_parkventory_lock(
    descriptor: int, path: Path, *, owner: int, group: int
) -> int:
    if descriptor < 3:
        raise MaterializationError("inherited deployment lock descriptor is invalid")
    try:
        metadata = os.fstat(descriptor)
        path_metadata = path.stat(follow_symlinks=False)
    except OSError as exc:
        raise MaterializationError("cannot inspect inherited deployment lock") from exc
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_nlink != 1
        or metadata.st_uid != owner
        or metadata.st_gid != group
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_dev != path_metadata.st_dev
        or metadata.st_ino != path_metadata.st_ino
        or not stat.S_ISREG(path_metadata.st_mode)
    ):
        raise MaterializationError("inherited deployment lock has unsafe metadata")
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        raise MaterializationError("inherited deployment lock is not exclusive") from exc
    return descriptor


def parse_args() -> argparse.Namespace:
    parser = UsageParser(description=__doc__)
    parser.add_argument("--product", required=True, choices=sorted(PROFILES))
    parser.add_argument("--registry-generation", required=True, type=int)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--install-from", type=Path, metavar="ABSOLUTE_DIR")
    parser.add_argument("--test-root", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--test-deployment-lock", type=Path, help=argparse.SUPPRESS)
    parser.add_argument(
        "--deployment-lock-held-fd", type=int, help=argparse.SUPPRESS
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    profile = PROFILES[args.product]
    if args.registry_generation != profile.registry_generation:
        return fail(
            f"{profile.product} requires registry generation "
            f"{profile.registry_generation}"
        )
    if args.test_root is None and args.test_deployment_lock is not None:
        return fail("test deployment lock requires the test credential root")
    if args.deployment_lock_held_fd is not None and (
        args.product != "parkventory"
        or args.install_from is None
        or args.test_root is not None
    ):
        return fail("inherited deployment lock is reserved for Parkventory install")
    if args.test_root is not None and (
        os.geteuid() == 0 or os.environ.get("VPS_SMTP_SECRET_TESTING") != "1"
    ):
        return fail("test-only mode requires an explicit unprivileged test guard")
    if args.test_root is None and os.geteuid() != 0:
        return fail("production mode requires root")

    owner = 0 if args.test_root is None else os.geteuid()
    source_group = 0 if args.test_root is None else os.getegid()
    source: dict[str, bytes] | None = None
    if args.install_from is not None:
        try:
            source = read_source(
                args.install_from,
                profile,
                owner=owner,
                group=source_group,
            )
        except (OSError, MaterializationError) as exc:
            return fail(str(exc))

    descriptors: list[int] = []
    lock_descriptor: int | None = None
    try:
        if source is not None:
            lock_path = (
                DEPLOYMENT_LOCK_PATH
                if args.test_root is None
                else (
                    args.test_deployment_lock
                    if args.test_deployment_lock is not None
                    else args.test_root.parent / ".vps-static.lock"
                )
            )
            if not lock_path.is_absolute():
                raise MaterializationError("shared deployment lock path must be absolute")
            if args.deployment_lock_held_fd is None:
                lock_descriptor = acquire_lock(
                    lock_path, owner=owner, group=source_group
                )
            else:
                lock_descriptor = use_inherited_parkventory_lock(
                    args.deployment_lock_held_fd,
                    lock_path,
                    owner=owner,
                    group=source_group,
                )
        directory_fd, descriptors = (
            production_directory(profile, create=source is not None)
            if args.test_root is None
            else test_directory(args.test_root)
        )
        if source is None:
            pending_entries(
                directory_fd,
                profile,
                None,
                owner=owner,
                test_group=source_group,
            )
            present = owned_entries(directory_fd, profile)
            complete = set(profile.installed_names) | {profile.marker_name}
            if present != complete:
                state = "absent" if not present else "incomplete"
                raise MaterializationError(f"SMTP credential set is {state}")
            validate_installed(
                directory_fd,
                profile,
                args.registry_generation,
                owner=owner,
                test_group=source_group,
            )
        else:
            install(
                directory_fd,
                profile,
                args.registry_generation,
                source,
                owner=owner,
                test_group=source_group,
            )
    except (OSError, MaterializationError) as exc:
        return fail(str(exc))
    finally:
        for descriptor in reversed(descriptors):
            try:
                os.close(descriptor)
            except OSError:
                pass
        if lock_descriptor is not None:
            try:
                os.close(lock_descriptor)
            except OSError:
                pass
    print(
        f"{profile.product} SMTP credential generation "
        f"{args.registry_generation} is valid"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
