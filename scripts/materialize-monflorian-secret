#!/usr/bin/env python3
"""Materialize or audit one of the two registered Mon Florian secrets."""

from __future__ import annotations

import argparse
import dataclasses
import fcntl
import json
import os
import re
import secrets
import stat
import sys
from pathlib import Path
from typing import Any


EX_CONFIG = 78
MATERIALIZER = "materialize-monflorian-secret"
PRODUCTION_ROOT = Path("/etc/vps/secrets/monflorian")
PRODUCTION_REGISTRY = Path("/srv/vps/repository/secrets/registry.json")
GENERATION_DIRECTORY = ".generations"
MAX_REGISTRY_BYTES = 128 * 1024
MAX_MARKER_BYTES = 1024
TEST_GUARD = "VPS_MONFLORIAN_SECRET_TESTING"
FAILPOINT = "VPS_MONFLORIAN_SECRET_FAILPOINT"
OPENAI_KEY_RE = re.compile(rb"sk-[A-Za-z0-9._-]{16,508}\n?")
PRIVATE_ACCESS_RE = re.compile(
    rb"basic_auth \{\n"
    rb"\t[A-Za-z0-9][A-Za-z0-9._-]{0,63} "
    rb"\$2[aby]\$14\$[./A-Za-z0-9]{53}\n"
    rb"\}\n"
)


class SecretError(RuntimeError):
    """The requested secret operation violates the public contract."""


@dataclasses.dataclass(frozen=True)
class SecretSpec:
    identifier: str
    filename: str
    group: int
    mode: int
    maximum_size: int
    provider: str
    consumers: tuple[str, ...]
    source: str

    @property
    def marker_name(self) -> str:
        return f"{self.identifier}.json"

    @property
    def production_path(self) -> str:
        return str(PRODUCTION_ROOT / self.filename)

    def validate_content(self, content: bytes, label: str = "source content") -> None:
        pattern = (
            OPENAI_KEY_RE
            if self.identifier == "monflorian.openai-api-key"
            else PRIVATE_ACCESS_RE
        )
        if pattern.fullmatch(content) is None:
            raise SecretError(f"{label} for {self.identifier} is invalid")


SPECS = {
    spec.identifier: spec
    for spec in (
        SecretSpec(
            identifier="monflorian.openai-api-key",
            filename="monflorian-openai-api-key",
            group=10001,
            mode=0o440,
            maximum_size=64 * 1024,
            provider="openai",
            consumers=("monflorian-backend",),
            source="provider-secret",
        ),
        SecretSpec(
            identifier="monflorian.private-access",
            filename="monflorian-private-access.caddy",
            group=0,
            mode=0o400,
            maximum_size=4096,
            provider="local",
            consumers=("caddy",),
            source="operator-file",
        ),
    )
}
MARKER_NAMES = frozenset(spec.marker_name for spec in SPECS.values())


def canonical_json(value: object) -> bytes:
    return (
        json.dumps(value, ensure_ascii=True, separators=(",", ":"), sort_keys=True)
        + "\n"
    ).encode("ascii")


def strict_json(raw: bytes, label: str) -> Any:
    def pairs(values: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in values:
            if key in result:
                raise SecretError(f"{label} contains a duplicate key")
            result[key] = value
        return result

    try:
        return json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=pairs,
            parse_constant=lambda _value: (_ for _ in ()).throw(
                SecretError(f"{label} contains a forbidden constant")
            ),
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SecretError(f"{label} is not strict JSON") from exc


def read_all(descriptor: int, maximum: int, label: str) -> bytes:
    chunks: list[bytes] = []
    total = 0
    while True:
        chunk = os.read(descriptor, min(64 * 1024, maximum + 1 - total))
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
        if total > maximum:
            raise SecretError(f"{label} exceeds its size limit")
    return b"".join(chunks)


def require_directory_fd(
    descriptor: int, label: str, *, uid: int, gid: int, mode: int
) -> None:
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != uid
        or metadata.st_gid != gid
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        raise SecretError(f"{label} has unsafe metadata")


def open_root(path: Path, *, uid: int, gid: int) -> int:
    if not path.is_absolute():
        raise SecretError("secret root must be absolute")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        raise SecretError("secret root is missing or unsafe") from exc
    try:
        require_directory_fd(
            descriptor,
            "secret root",
            uid=uid,
            gid=gid,
            mode=0o700,
        )
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def open_generation_directory(
    root_fd: int, *, create: bool, uid: int, gid: int
) -> int | None:
    try:
        descriptor = os.open(
            GENERATION_DIRECTORY,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
            dir_fd=root_fd,
        )
    except FileNotFoundError:
        if not create:
            return None
        try:
            os.mkdir(GENERATION_DIRECTORY, 0o700, dir_fd=root_fd)
            os.chown(
                GENERATION_DIRECTORY,
                uid,
                gid,
                dir_fd=root_fd,
                follow_symlinks=False,
            )
            os.chmod(
                GENERATION_DIRECTORY,
                0o700,
                dir_fd=root_fd,
                follow_symlinks=False,
            )
            os.fsync(root_fd)
        except FileExistsError:
            pass
        descriptor = os.open(
            GENERATION_DIRECTORY,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
            dir_fd=root_fd,
        )
    except OSError as exc:
        raise SecretError("generation marker directory is unsafe") from exc
    try:
        require_directory_fd(
            descriptor,
            "generation marker directory",
            uid=uid,
            gid=gid,
            mode=0o700,
        )
        unexpected = {
            name
            for name in os.listdir(descriptor)
            if name not in MARKER_NAMES and not name.endswith(".pending")
        }
        if unexpected:
            raise SecretError("generation marker directory has an unexpected entry")
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def read_regular_at(
    directory_fd: int,
    name: str,
    label: str,
    *,
    uid: int,
    gid: int,
    mode: int,
    maximum_size: int,
    required: bool,
    read_content: bool,
    synchronize: bool = False,
) -> bytes | None:
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
            dir_fd=directory_fd,
        )
    except FileNotFoundError:
        if required:
            raise SecretError(f"{label} is missing")
        return None
    except OSError as exc:
        raise SecretError(f"{label} is unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != uid
            or metadata.st_gid != gid
            or stat.S_IMODE(metadata.st_mode) != mode
            or not 1 <= metadata.st_size <= maximum_size
        ):
            raise SecretError(f"{label} has unsafe metadata")
        if not read_content:
            if synchronize:
                os.fsync(descriptor)
            return b""
        content = read_all(descriptor, maximum_size, label)
        if len(content) != metadata.st_size:
            raise SecretError(f"{label} changed while it was read")
        if synchronize:
            os.fsync(descriptor)
        return content
    finally:
        os.close(descriptor)


def read_source(path: Path, spec: SecretSpec, *, uid: int, gid: int) -> bytes:
    if not path.is_absolute():
        raise SecretError("source path must be absolute")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as exc:
        raise SecretError("source file is missing or unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != uid
            or metadata.st_gid != gid
            or stat.S_IMODE(metadata.st_mode) not in {0o400, 0o600}
            or not 1 <= metadata.st_size <= spec.maximum_size
        ):
            raise SecretError("source file has unsafe metadata")
        content = read_all(descriptor, spec.maximum_size, "source file")
        if len(content) != metadata.st_size:
            raise SecretError("source file changed while it was read")
    finally:
        os.close(descriptor)
    spec.validate_content(content)
    return content


def read_registry(path: Path, *, uid: int, gid: int) -> dict[str, dict[str, Any]]:
    if not path.is_absolute():
        raise SecretError("registry path must be absolute")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as exc:
        raise SecretError("secret registry is missing or unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != uid
            or metadata.st_gid != gid
            or stat.S_IMODE(metadata.st_mode) not in {0o444, 0o644}
            or not 1 <= metadata.st_size <= MAX_REGISTRY_BYTES
        ):
            raise SecretError("secret registry has unsafe metadata")
        raw = read_all(descriptor, MAX_REGISTRY_BYTES, "secret registry")
        if len(raw) != metadata.st_size:
            raise SecretError("secret registry changed while it was read")
    finally:
        os.close(descriptor)
    document = strict_json(raw, "secret registry")
    if (
        not isinstance(document, dict)
        or document.get("schema") != 1
        or document.get("environment") != "production"
        or document.get("secret_root") != "/etc/vps/secrets"
        or not isinstance(document.get("secrets"), list)
    ):
        raise SecretError("secret registry root contract is invalid")
    entries: dict[str, dict[str, Any]] = {}
    for value in document["secrets"]:
        if not isinstance(value, dict) or not isinstance(value.get("id"), str):
            raise SecretError("secret registry entry is invalid")
        if value["id"] in entries:
            raise SecretError("secret registry contains a duplicate identifier")
        entries[value["id"]] = value
    for identifier, spec in SPECS.items():
        entry = entries.get(identifier)
        expected = {
            "classification": "secret",
            "consumers": list(spec.consumers),
            "group": spec.group,
            "id": identifier,
            "materializer": MATERIALIZER,
            "mode": f"{spec.mode:04o}",
            "owner": 0,
            "path": spec.production_path,
            "provider": spec.provider,
            "rebuild": "restore-from-external-store",
            "scope": "monflorian",
            "source": spec.source,
        }
        if entry is None or any(entry.get(key) != value for key, value in expected.items()):
            raise SecretError(f"registry contract for {identifier} is invalid")
        generation = entry.get("generation")
        target = entry.get("target_generation")
        if (
            entry.get("declared_state") != "required"
            or not isinstance(generation, int)
            or isinstance(generation, bool)
            or generation < 0
            or not isinstance(target, int)
            or isinstance(target, bool)
            or target < 1
            or target < generation
            or target - generation > 1
        ):
            raise SecretError(f"registry generation for {identifier} is invalid")
        if identifier == "monflorian.openai-api-key":
            if entry.get("provider_state") not in {"planned", "active"}:
                raise SecretError(f"registry provider state for {identifier} is invalid")
        elif entry.get("provider_state") != "not-applicable":
            raise SecretError(f"registry provider state for {identifier} is invalid")
    return {identifier: entries[identifier] for identifier in SPECS}


def marker_content(identifier: str, generation: int) -> bytes:
    return canonical_json(
        {
            "materializer": MATERIALIZER,
            "schema": 1,
            "secret_ids": [identifier],
            "target_generation": generation,
        }
    )


def read_marker(
    generation_fd: int | None,
    spec: SecretSpec,
    entry: dict[str, Any],
    *,
    uid: int,
    gid: int,
) -> int | None:
    if generation_fd is None:
        return None
    raw = read_regular_at(
        generation_fd,
        spec.marker_name,
        f"generation marker for {spec.identifier}",
        uid=uid,
        gid=gid,
        mode=0o400,
        maximum_size=MAX_MARKER_BYTES,
        required=False,
        read_content=True,
    )
    if raw is None:
        return None
    value = strict_json(raw, f"generation marker for {spec.identifier}")
    if not isinstance(value, dict) or set(value) != {
        "materializer",
        "schema",
        "secret_ids",
        "target_generation",
    }:
        raise SecretError(f"generation marker for {spec.identifier} is invalid")
    generation = value.get("target_generation")
    allowed = {entry["target_generation"]}
    if entry["generation"] > 0:
        allowed.add(entry["generation"])
    if (
        value.get("materializer") != MATERIALIZER
        or value.get("schema") != 1
        or value.get("secret_ids") != [spec.identifier]
        or not isinstance(generation, int)
        or isinstance(generation, bool)
        or generation not in allowed
        or raw != marker_content(spec.identifier, generation)
    ):
        raise SecretError(f"generation marker for {spec.identifier} is invalid")
    return generation


def inspect_secret(
    root_fd: int,
    spec: SecretSpec,
    *,
    uid: int,
    owner_gid: int,
    application_gid: int,
    read_content: bool,
    synchronize: bool = False,
) -> bytes | None:
    gid = application_gid if spec.group != 0 else owner_gid
    return read_regular_at(
        root_fd,
        spec.filename,
        f"installed file for {spec.identifier}",
        uid=uid,
        gid=gid,
        mode=spec.mode,
        maximum_size=spec.maximum_size,
        required=False,
        read_content=read_content,
        synchronize=synchronize,
    )


def pending_contract(name: str, *, marker: bool) -> SecretSpec | None:
    for spec in SPECS.values():
        final_name = spec.marker_name if marker else spec.filename
        prefix = f".{final_name}."
        suffix = ".pending"
        if not name.startswith(prefix) or not name.endswith(suffix):
            continue
        nonce = name[len(prefix) : -len(suffix)]
        if re.fullmatch(r"[0-9a-f]{32}", nonce) is not None:
            return spec
    return None


def inspect_pending_at(
    directory_fd: int,
    entries: dict[str, dict[str, Any]],
    *,
    marker: bool,
    uid: int,
    owner_gid: int,
    application_gid: int,
) -> list[str]:
    names = sorted(name for name in os.listdir(directory_fd) if name.endswith(".pending"))
    if not names:
        return []
    if len(names) > len(SPECS):
        raise SecretError("pending transaction count exceeds the closed contract")

    directory_metadata = os.fstat(directory_fd)
    validated: list[str] = []
    final_names: set[str] = set()
    for name in names:
        spec = pending_contract(name, marker=marker)
        if spec is None:
            raise SecretError("pending transaction name is outside the closed contract")
        final_name = spec.marker_name if marker else spec.filename
        if final_name in final_names:
            raise SecretError("pending transaction duplicates one closed target")
        final_names.add(final_name)
        expected_gid = (
            owner_gid
            if marker or spec.group == 0
            else application_gid
        )
        expected_mode = 0o400 if marker else spec.mode
        maximum_size = MAX_MARKER_BYTES if marker else spec.maximum_size
        try:
            descriptor = os.open(
                name,
                os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                dir_fd=directory_fd,
            )
        except OSError as exc:
            raise SecretError("pending transaction file is unsafe") from exc
        try:
            metadata = os.fstat(descriptor)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_nlink != 1
                or metadata.st_uid != uid
                or metadata.st_gid != expected_gid
                or stat.S_IMODE(metadata.st_mode) != expected_mode
                or metadata.st_dev != directory_metadata.st_dev
                or not 1 <= metadata.st_size <= maximum_size
            ):
                raise SecretError("pending transaction file has unsafe metadata")
            content = read_all(descriptor, maximum_size, "pending transaction file")
            if len(content) != metadata.st_size:
                raise SecretError("pending transaction file changed while read")
        finally:
            os.close(descriptor)
        if marker:
            allowed_generations = {entries[spec.identifier]["target_generation"]}
            if entries[spec.identifier]["generation"] > 0:
                allowed_generations.add(entries[spec.identifier]["generation"])
            if content not in {
                marker_content(spec.identifier, generation)
                for generation in allowed_generations
            }:
                raise SecretError("pending generation marker content is invalid")
        else:
            spec.validate_content(content, "pending file content")
        validated.append(name)

    return validated


def recover_pending_locked(
    root_fd: int,
    generation_fd: int | None,
    entries: dict[str, dict[str, Any]],
    *,
    mutate: bool,
    uid: int,
    owner_gid: int,
    application_gid: int,
) -> None:
    root_names = inspect_pending_at(
        root_fd,
        entries,
        marker=False,
        uid=uid,
        owner_gid=owner_gid,
        application_gid=application_gid,
    )
    generation_names: list[str] = []
    if generation_fd is not None:
        generation_names = inspect_pending_at(
            generation_fd,
            entries,
            marker=True,
            uid=uid,
            owner_gid=owner_gid,
            application_gid=application_gid,
        )
    if not root_names and not generation_names:
        return
    if not mutate:
        raise SecretError("pending transaction requires mutating recovery")
    for name in root_names:
        os.unlink(name, dir_fd=root_fd)
    if root_names:
        os.fsync(root_fd)
    if generation_fd is not None:
        for name in generation_names:
            os.unlink(name, dir_fd=generation_fd)
        if generation_names:
            os.fsync(generation_fd)


def audit_locked(
    root_fd: int,
    generation_fd: int | None,
    entries: dict[str, dict[str, Any]],
    *,
    uid: int,
    owner_gid: int,
    application_gid: int,
) -> dict[str, object]:
    result: dict[str, object] = {}
    for identifier, spec in SPECS.items():
        installed = inspect_secret(
            root_fd,
            spec,
            uid=uid,
            owner_gid=owner_gid,
            application_gid=application_gid,
            read_content=False,
        )
        marker_generation = read_marker(
            generation_fd,
            spec,
            entries[identifier],
            uid=uid,
            gid=owner_gid,
        )
        if marker_generation is not None and installed is None:
            raise SecretError(f"generation marker for {identifier} has no installed file")
        if entries[identifier]["generation"] > 0 and marker_generation is None:
            raise SecretError(f"observed generation for {identifier} has no marker")
        result[identifier] = {
            "generation": marker_generation or 0,
            "generation_binding": (
                "materializer-marker" if marker_generation is not None else "unlinked"
            ),
            "host_state": "materialized" if installed is not None else "absent",
        }
    return result


def write_pending(
    directory_fd: int,
    final_name: str,
    content: bytes,
    *,
    uid: int,
    gid: int,
    mode: int,
) -> str:
    temporary = f".{final_name}.{secrets.token_hex(16)}.pending"
    descriptor = -1
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            mode,
            dir_fd=directory_fd,
        )
        os.fchown(descriptor, uid, gid)
        os.fchmod(descriptor, mode)
        written = 0
        while written < len(content):
            count = os.write(descriptor, content[written:])
            if count <= 0:
                raise SecretError("protected file write stopped early")
            written += count
        os.fsync(descriptor)
        return temporary
    except BaseException:
        try:
            os.unlink(temporary, dir_fd=directory_fd)
        except FileNotFoundError:
            pass
        raise
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def injected_failure(name: str, *, testing: bool) -> None:
    if testing and os.environ.get(FAILPOINT) == name:
        raise SecretError(f"injected interruption at {name}")


def publish_marker(
    generation_fd: int,
    spec: SecretSpec,
    generation: int,
    *,
    uid: int,
    gid: int,
    testing: bool,
) -> None:
    temporary: str | None = None
    try:
        temporary = write_pending(
            generation_fd,
            spec.marker_name,
            marker_content(spec.identifier, generation),
            uid=uid,
            gid=gid,
            mode=0o400,
        )
        injected_failure("after-marker-stage", testing=testing)
        os.replace(
            temporary,
            spec.marker_name,
            src_dir_fd=generation_fd,
            dst_dir_fd=generation_fd,
        )
        temporary = None
        os.fsync(generation_fd)
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary, dir_fd=generation_fd)
            except FileNotFoundError:
                pass


def install_locked(
    root_fd: int,
    entries: dict[str, dict[str, Any]],
    spec: SecretSpec,
    source: bytes,
    *,
    uid: int,
    owner_gid: int,
    application_gid: int,
    testing: bool,
) -> bool:
    entry = entries[spec.identifier]
    existing_generation_fd = open_generation_directory(
        root_fd,
        create=False,
        uid=uid,
        gid=owner_gid,
    )
    try:
        installed = inspect_secret(
            root_fd,
            spec,
            uid=uid,
            owner_gid=owner_gid,
            application_gid=application_gid,
            read_content=True,
        )
        current_marker = read_marker(
            existing_generation_fd,
            spec,
            entry,
            uid=uid,
            gid=owner_gid,
        )
    finally:
        if existing_generation_fd is not None:
            os.close(existing_generation_fd)

    target = entry["target_generation"]
    if current_marker == target:
        if installed != source:
            raise SecretError(
                f"same-generation content change for {spec.identifier} is forbidden"
            )
        return False
    if entry["generation"] > 0 and current_marker is None:
        raise SecretError(
            f"observed generation for {spec.identifier} has no recovery marker"
        )
    if target == entry["generation"]:
        raise SecretError(f"registry has no new generation for {spec.identifier}")
    if (
        entry["generation"] == 0
        and current_marker is None
        and installed is not None
        and installed != source
    ):
        raise SecretError(
            f"unlinked existing content for {spec.identifier} cannot be replaced"
        )
    if (
        current_marker == entry["generation"]
        and target > entry["generation"]
        and installed == source
    ):
        raise SecretError(f"rotation for {spec.identifier} requires new content")

    generation_fd = open_generation_directory(
        root_fd,
        create=True,
        uid=uid,
        gid=owner_gid,
    )
    assert generation_fd is not None
    payload_temporary: str | None = None
    try:
        if current_marker is not None:
            os.unlink(spec.marker_name, dir_fd=generation_fd)
            os.fsync(generation_fd)
            injected_failure("after-marker-invalidation", testing=testing)
        if installed != source:
            payload_temporary = write_pending(
                root_fd,
                spec.filename,
                source,
                uid=uid,
                gid=application_gid if spec.group != 0 else owner_gid,
                mode=spec.mode,
            )
            os.replace(
                payload_temporary,
                spec.filename,
                src_dir_fd=root_fd,
                dst_dir_fd=root_fd,
            )
            payload_temporary = None
            os.fsync(root_fd)
        injected_failure("after-secret-replacement", testing=testing)
        publish_marker(
            generation_fd,
            spec,
            target,
            uid=uid,
            gid=owner_gid,
            testing=testing,
        )
    finally:
        if payload_temporary is not None:
            try:
                os.unlink(payload_temporary, dir_fd=root_fd)
            except FileNotFoundError:
                pass
        os.close(generation_fd)
    return True


def inspect_adoption_locked(
    root_fd: int,
    entries: dict[str, dict[str, Any]],
    spec: SecretSpec,
    *,
    uid: int,
    owner_gid: int,
    application_gid: int,
) -> tuple[bytes, bool]:
    entry = entries[spec.identifier]
    if entry["generation"] != 0 or entry["target_generation"] != 1:
        raise SecretError(
            f"existing-file adoption for {spec.identifier} is initial-only"
        )

    generation_fd = open_generation_directory(
        root_fd,
        create=False,
        uid=uid,
        gid=owner_gid,
    )
    try:
        installed = inspect_secret(
            root_fd,
            spec,
            uid=uid,
            owner_gid=owner_gid,
            application_gid=application_gid,
            read_content=True,
        )
        current_marker = read_marker(
            generation_fd,
            spec,
            entry,
            uid=uid,
            gid=owner_gid,
        )
    finally:
        if generation_fd is not None:
            os.close(generation_fd)

    if installed is None:
        raise SecretError(f"installed file for {spec.identifier} is missing")
    spec.validate_content(installed, "installed file content")
    return installed, current_marker is None


def adopt_existing_locked(
    root_fd: int,
    entries: dict[str, dict[str, Any]],
    spec: SecretSpec,
    *,
    uid: int,
    owner_gid: int,
    application_gid: int,
    testing: bool,
) -> bool:
    installed, adoption_required = inspect_adoption_locked(
        root_fd,
        entries,
        spec,
        uid=uid,
        owner_gid=owner_gid,
        application_gid=application_gid,
    )
    if not adoption_required:
        return False

    synchronized = inspect_secret(
        root_fd,
        spec,
        uid=uid,
        owner_gid=owner_gid,
        application_gid=application_gid,
        read_content=True,
        synchronize=True,
    )
    if synchronized != installed:
        raise SecretError(f"installed file for {spec.identifier} changed")
    os.fsync(root_fd)
    injected_failure("after-existing-secret-sync", testing=testing)

    generation_fd = open_generation_directory(
        root_fd,
        create=True,
        uid=uid,
        gid=owner_gid,
    )
    assert generation_fd is not None
    try:
        verified = inspect_secret(
            root_fd,
            spec,
            uid=uid,
            owner_gid=owner_gid,
            application_gid=application_gid,
            read_content=True,
        )
        if verified != installed:
            raise SecretError(f"installed file for {spec.identifier} changed")
        spec.validate_content(verified, "installed file content")
        publish_marker(
            generation_fd,
            spec,
            1,
            uid=uid,
            gid=owner_gid,
            testing=testing,
        )
    finally:
        os.close(generation_fd)
    return True


def context(arguments: argparse.Namespace) -> tuple[Path, Path, int, int, int, bool]:
    testing = arguments.test_root is not None or arguments.test_registry is not None
    if testing:
        if (
            arguments.test_root is None
            or arguments.test_registry is None
            or os.geteuid() == 0
            or os.environ.get(TEST_GUARD) != "1"
        ):
            raise SecretError("test mode requires its explicit unprivileged guard")
        return (
            arguments.test_root,
            arguments.test_registry,
            os.geteuid(),
            os.getegid(),
            os.getegid(),
            True,
        )
    if os.geteuid() != 0:
        raise SecretError("production secret operation requires root")
    return PRODUCTION_ROOT, PRODUCTION_REGISTRY, 0, 0, 10001, False


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true")
    mode.add_argument(
        "--install-from",
        nargs=2,
        metavar=("SOURCE", "SECRET_ID"),
    )
    mode.add_argument("--adopt-existing", metavar="SECRET_ID")
    mode.add_argument("--check-adopt-existing", metavar="SECRET_ID")
    parser.add_argument("--test-root", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--test-registry", type=Path, help=argparse.SUPPRESS)
    return parser.parse_args()


def main() -> int:
    try:
        arguments = parse_args()
        root, registry, uid, owner_gid, application_gid, testing = context(arguments)
        entries = read_registry(registry, uid=uid, gid=owner_gid)
        root_fd = open_root(root, uid=uid, gid=owner_gid)
        try:
            read_only = arguments.check or arguments.check_adopt_existing is not None
            fcntl.flock(root_fd, fcntl.LOCK_SH if read_only else fcntl.LOCK_EX)
            selected: SecretSpec | None = None
            source: bytes | None = None
            if arguments.install_from is not None:
                source_value, identifier = arguments.install_from
                selected = SPECS.get(identifier)
                if selected is None:
                    raise SecretError("secret identifier is outside the closed contract")
                source = read_source(
                    Path(source_value),
                    selected,
                    uid=uid,
                    gid=owner_gid,
                )
            elif arguments.adopt_existing is not None:
                selected = SPECS.get(arguments.adopt_existing)
                if selected is None:
                    raise SecretError("secret identifier is outside the closed contract")
            elif arguments.check_adopt_existing is not None:
                selected = SPECS.get(arguments.check_adopt_existing)
                if selected is None:
                    raise SecretError("secret identifier is outside the closed contract")

            pending_generation_fd = open_generation_directory(
                root_fd,
                create=False,
                uid=uid,
                gid=owner_gid,
            )
            try:
                recover_pending_locked(
                    root_fd,
                    pending_generation_fd,
                    entries,
                    mutate=not read_only,
                    uid=uid,
                    owner_gid=owner_gid,
                    application_gid=application_gid,
                )
            finally:
                if pending_generation_fd is not None:
                    os.close(pending_generation_fd)
            changed = False
            adoption_required: bool | None = None
            if arguments.install_from is not None:
                assert selected is not None and source is not None
                changed = install_locked(
                    root_fd,
                    entries,
                    selected,
                    source,
                    uid=uid,
                    owner_gid=owner_gid,
                    application_gid=application_gid,
                    testing=testing,
                )
            elif arguments.adopt_existing is not None:
                assert selected is not None
                changed = adopt_existing_locked(
                    root_fd,
                    entries,
                    selected,
                    uid=uid,
                    owner_gid=owner_gid,
                    application_gid=application_gid,
                    testing=testing,
                )
            elif arguments.check_adopt_existing is not None:
                assert selected is not None
                _installed, adoption_required = inspect_adoption_locked(
                    root_fd,
                    entries,
                    selected,
                    uid=uid,
                    owner_gid=owner_gid,
                    application_gid=application_gid,
                )
            generation_fd = open_generation_directory(
                root_fd,
                create=False,
                uid=uid,
                gid=owner_gid,
            )
            try:
                audit = audit_locked(
                    root_fd,
                    generation_fd,
                    entries,
                    uid=uid,
                    owner_gid=owner_gid,
                    application_gid=application_gid,
                )
            finally:
                if generation_fd is not None:
                    os.close(generation_fd)
        finally:
            os.close(root_fd)
        output: dict[str, object] = {
            "changed": changed,
            "entries": audit,
            "mode": (
                "check"
                if arguments.check
                else "check-adopt"
                if arguments.check_adopt_existing is not None
                else "adopt"
                if arguments.adopt_existing is not None
                else "install"
            ),
        }
        if arguments.check_adopt_existing is not None:
            output["adoption_required"] = adoption_required
            output["secret_id"] = arguments.check_adopt_existing
        print(
            canonical_json(output).decode("ascii"),
            end="",
        )
        return 0
    except SecretError as exc:
        print(f"Mon Florian secret operation refused: {exc}", file=sys.stderr)
        return EX_CONFIG


if __name__ == "__main__":
    raise SystemExit(main())
