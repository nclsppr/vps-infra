#!/usr/bin/env bash
set -Eeuo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

readonly EX_USAGE=64
readonly EX_UNAVAILABLE=69
readonly EX_TEMPFAIL=75
readonly EX_CONFIG=78
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly SCRIPT_DIR

if [[ $# -ne 1 || ! $1 =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: deploy <40-character-lowercase-git-sha>" >&2
  exit "$EX_USAGE"
fi
readonly requested_sha=$1

# Overrides are accepted only for unprivileged local tests. A root invocation
# with a test flag is an operator error. It must stop before any file mutation.
if [[ ${VPS_CONTROLLER_TESTING:-0} == 1 && ${EUID} -eq 0 ]]; then
  echo "deploy refused: root cannot use controller test mode" >&2
  exit "$EX_CONFIG"
fi
if [[ ${VPS_CONTROLLER_TESTING:-0} == 1 ]]; then
  readonly production_mode=0
  readonly repository_dir=${VPS_REPOSITORY_DIR:?VPS_REPOSITORY_DIR is required in test mode}
  readonly state_dir=${VPS_STATE_DIR:?VPS_STATE_DIR is required in test mode}
  readonly lock_dir=${VPS_LOCK_DIR:?VPS_LOCK_DIR is required in test mode}
  readonly enable_file=${VPS_PRODUCTION_ENABLE_FILE:?VPS_PRODUCTION_ENABLE_FILE is required in test mode}
  readonly validator=${VPS_VALIDATE_RELEASE:-"$SCRIPT_DIR/validate-release"}
  readonly reconciler=${VPS_RECONCILE:-"$SCRIPT_DIR/reconcile"}
  readonly state_verifier=${VPS_STATE_VERIFIER:-"$SCRIPT_DIR/verify-state"}
  readonly evidence_verifier=${VPS_EVIDENCE_VERIFIER:-"$SCRIPT_DIR/verify-github-evidence"}
  readonly expected_origin=${VPS_EXPECTED_ORIGIN:?VPS_EXPECTED_ORIGIN is required in test mode}
  readonly schema_file=${VPS_SCHEMA_FILE:-"$SCRIPT_DIR/../schemas/production-release.schema.json"}
else
  readonly production_mode=1
  readonly repository_dir=/srv/vps/repository
  readonly state_dir=/var/lib/vps-controller
  readonly lock_dir=/run/lock/vps-deploy.lock
  readonly enable_file=/etc/vps/production-enabled
  readonly validator=/usr/local/libexec/vps/validate-release
  readonly reconciler=/usr/local/libexec/vps/reconcile
  readonly state_verifier=/usr/local/libexec/vps/verify-state
  readonly evidence_verifier=/usr/local/libexec/vps/verify-github-evidence
  readonly expected_origin=https://github.com/nclsppr/vps-infra.git
  readonly schema_file=/usr/local/share/vps-infra/schemas/production-release.schema.json
fi

readonly desired_dir="$state_dir/desired"
readonly active_dir="$state_dir/active"
readonly quarantine_dir="$state_dir/quarantine"
readonly plans_dir="$state_dir/plans"
readonly journal_file="$state_dir/journal.jsonl"
lock_acquired=0
staging_dir=

# shellcheck disable=SC2329  # The trap invokes this function indirectly.
cleanup() {
  local exit_status=$?
  if [[ -n ${staging_dir:-} && -d $staging_dir ]]; then
    case "$staging_dir" in
      "$state_dir"/staging.*) rm -rf -- "$staging_dir" ;;
      *) echo "deploy: refusing to clean unexpected temporary path: $staging_dir" >&2 ;;
    esac
  fi
  if [[ $lock_acquired -eq 1 ]]; then
    rm -f -- "$lock_dir/owner"
    rmdir -- "$lock_dir" 2>/dev/null || true
  fi
  exit "$exit_status"
}
trap cleanup EXIT HUP INT TERM

fail() {
  local message=$1
  local status=${2:-1}
  echo "deploy refused: $message" >&2
  exit "$status"
}

require_root_owned_immutable() {
  local path=$1
  local metadata owner mode mode_value
  [[ $production_mode -eq 1 ]] || return 0
  [[ -e $path && ! -L $path ]] || fail "trusted path is missing or is a symlink: $path" "$EX_CONFIG"
  metadata=$(stat -c '%u %a' -- "$path") || fail "cannot stat trusted path: $path" "$EX_CONFIG"
  read -r owner mode <<<"$metadata"
  [[ $owner == 0 ]] || fail "trusted path is not owned by root: $path" "$EX_CONFIG"
  mode_value=$((8#$mode))
  (( (mode_value & 8#022) == 0 )) || \
    fail "trusted path is writable by group or others: $path" "$EX_CONFIG"
}

verify_existing_state_pair() {
  local label=$1
  local pair_dir="$state_dir/$label"
  local state_file="$pair_dir/state.json"
  local manifest_file="$pair_dir/manifest.json"
  if [[ -f $state_file && -f $manifest_file ]]; then
    "$state_verifier" \
      --label "$label" \
      --state "$state_file" \
      --manifest "$manifest_file" \
      --repository "$repository_dir" \
      --schema "$schema_file" >/dev/null || \
      fail "$label state integrity verification failed; refusing reconciliation"
  elif [[ -e $state_file || -e $manifest_file ]]; then
    fail "$label state pair is incomplete; refusing reconciliation"
  fi
}

atomic_copy() {
  local source=$1
  local destination=$2
  local temporary="${destination}.tmp.$$"
  install -m 0600 -- "$source" "$temporary"
  mv -f -- "$temporary" "$destination"
}

sha256_file() {
  local file=$1
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -- "$file" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 -- "$file" | awk '{print $1}'
  else
    fail "neither sha256sum nor shasum is installed" "$EX_UNAVAILABLE"
  fi
}

write_metadata() {
  local destination=$1
  local commit=$2
  local manifest_hash=$3
  local timestamp=$4
  local temporary="${destination}.tmp.$$"
  printf '{"schema":1,"commit":"%s","manifest_sha256":"%s","recorded_at":"%s"}\n' \
    "$commit" "$manifest_hash" "$timestamp" >"$temporary"
  chmod 0600 "$temporary"
  mv -f -- "$temporary" "$destination"
}

append_journal() {
  local result=$1
  local mode=$2
  local timestamp=$3
  printf '{"schema":1,"commit":"%s","mode":"%s","result":"%s","recorded_at":"%s"}\n' \
    "$requested_sha" "$mode" "$result" "$timestamp" >>"$journal_file"
  chmod 0600 "$journal_file"
}

install -d -m 0700 -- "$state_dir" \
  "$quarantine_dir/commits" "$quarantine_dir/artifacts" "$plans_dir"
mkdir -p -- "$(dirname -- "$lock_dir")"

if ! mkdir -m 0700 -- "$lock_dir" 2>/dev/null; then
  owner=unknown
  if [[ -r $lock_dir/owner ]]; then
    owner=$(<"$lock_dir/owner")
  fi
  fail "another deployment owns $lock_dir (owner $owner); stale locks require explicit operator review" "$EX_TEMPFAIL"
fi
lock_acquired=1
printf '%s\n' "$$" >"$lock_dir/owner"

[[ -x $validator ]] || fail "validator is not executable: $validator" "$EX_CONFIG"
[[ -x $reconciler ]] || fail "reconciler is not executable: $reconciler" "$EX_CONFIG"
[[ -x $state_verifier ]] || fail "state verifier is not executable: $state_verifier" "$EX_CONFIG"
[[ -x $evidence_verifier ]] || fail "evidence verifier is not executable: $evidence_verifier" "$EX_CONFIG"
[[ -d $repository_dir/.git || -f $repository_dir/HEAD ]] || fail "repository is not initialized: $repository_dir" "$EX_CONFIG"
if [[ $production_mode -eq 1 ]]; then
  require_root_owned_immutable "$0"
  require_root_owned_immutable "$validator"
  require_root_owned_immutable "$reconciler"
  require_root_owned_immutable "$state_verifier"
  require_root_owned_immutable "$evidence_verifier"
  require_root_owned_immutable "$schema_file"
  require_root_owned_immutable "$repository_dir"
  require_root_owned_immutable "$repository_dir/.git/config"
  if [[ -e $enable_file ]]; then
    require_root_owned_immutable "$enable_file"
  fi
fi

export GIT_OPTIONAL_LOCKS=0
for variable_name in "${!GIT_CONFIG_KEY_@}" "${!GIT_CONFIG_VALUE_@}"; do
  unset "$variable_name"
done
unset GIT_CONFIG GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_CONFIG_SYSTEM \
  GIT_DIR GIT_WORK_TREE \
  GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_COMMON_DIR GIT_NAMESPACE GIT_EXEC_PATH GIT_TEMPLATE_DIR \
  GIT_SSH GIT_SSH_COMMAND GIT_SSH_VARIANT GIT_PROXY_COMMAND \
  PYTHONHOME PYTHONPATH VIRTUAL_ENV \
  http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY no_proxy
export GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL=/dev/null
actual_origin=$(git -C "$repository_dir" remote get-url origin 2>/dev/null) || \
  fail "repository has no fetch URL for the root-owned origin remote"
[[ $actual_origin == "$expected_origin" ]] || \
  fail "origin URL differs from the controller allowlist"

fetch_command=(
  git -C "$repository_dir"
  -c protocol.file.allow=never
  fetch
  --force
  --no-tags
  --no-recurse-submodules
  origin
  +refs/heads/main:refs/remotes/origin/main
)
if [[ $production_mode -eq 1 ]]; then
  "${fetch_command[@]}" || \
    fail "bounded HTTPS fetch of origin/main failed; active state is unchanged" "$EX_TEMPFAIL"
else
  # Local tests use a temporary file remote. Production accepts only the fixed
  # public HTTPS origin and rejects file:// through protocol.file.allow=never.
  git -C "$repository_dir" fetch --force --no-tags --no-recurse-submodules \
    origin +refs/heads/main:refs/remotes/origin/main || \
    fail "bounded fetch of origin/main failed in test mode" "$EX_TEMPFAIL"
fi

git -C "$repository_dir" cat-file -e "${requested_sha}^{commit}" 2>/dev/null || \
  fail "commit is not available after the bounded origin/main fetch"
resolved_sha=$(git -C "$repository_dir" rev-parse "${requested_sha}^{commit}")
[[ $resolved_sha == "$requested_sha" ]] || fail "requested object did not resolve to the exact commit"
git -C "$repository_dir" show-ref --verify --quiet refs/remotes/origin/main || \
  fail "refs/remotes/origin/main is unavailable; controller never deploys an unanchored commit"
git -C "$repository_dir" merge-base --is-ancestor "$requested_sha" refs/remotes/origin/main || \
  fail "commit is not reachable from origin/main"

verify_existing_state_pair desired
verify_existing_state_pair active

[[ ! -e $quarantine_dir/commits/${requested_sha}.json ]] || \
  fail "commit is quarantined; a reviewed manifest change or explicit operator action is required"

staging_dir=$(mktemp -d "$state_dir/staging.XXXXXX")
git -C "$repository_dir" show "${requested_sha}:releases/production.yaml" >"$staging_dir/manifest.json" || \
  fail "commit does not contain releases/production.yaml"
validator_args=(--schema "$schema_file")
if [[ $production_mode -eq 1 ]]; then
  validator_args+=(--require-json-schema)
fi
validator_args+=(--print-platform-integration-revision)
if ! platform_integration_revision=$("$validator" \
  "${validator_args[@]}" "$staging_dir/manifest.json"); then
  fail "target release manifest is invalid"
fi

if [[ -n $platform_integration_revision ]]; then
  [[ $platform_integration_revision =~ ^[0-9a-f]{40}$ ]] || \
    fail "validated platform integration revision has an unexpected format"
  git -C "$repository_dir" cat-file -e "${platform_integration_revision}^{commit}" 2>/dev/null || \
    fail "platform integration source revision is unavailable in the infrastructure repository"
  git -C "$repository_dir" merge-base --is-ancestor \
    "$platform_integration_revision" "$requested_sha" || \
    fail "platform integration source revision is not an ancestor of the requested release commit"
fi

manifest_hash=$(sha256_file "$staging_dir/manifest.json")

deployment_mode=dry-run
if [[ -e $enable_file ]]; then
  deployment_mode=live
fi

"$evidence_verifier" "$staging_dir/manifest.json" >/dev/null || {
  append_journal "evidence-refused" "$deployment_mode" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  fail "independent GitHub Actions evidence verification failed; desired and active state are unchanged"
}
timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# The installed release policy accepts only activation_policy=locked. A marker
# cannot override that policy. A future live path requires a separately audited
# policy and controller revision.
if [[ $deployment_mode == live ]]; then
  append_journal "activation-locked" "live" "$timestamp"
  fail "activation_policy=locked refuses live deployment; desired and active state are unchanged" "$EX_CONFIG"
fi

reconcile_args=(
  --desired "$staging_dir/manifest.json"
  --desired-commit "$requested_sha"
  --quarantine-dir "$quarantine_dir"
  --output "$plans_dir/${requested_sha}.json"
)
if [[ -f $active_dir/manifest.json ]]; then
  reconcile_args+=(--active-manifest "$active_dir/manifest.json")
fi
if [[ -f $active_dir/state.json ]]; then
  reconcile_args+=(--active-state "$active_dir/state.json")
fi
"$reconciler" "${reconcile_args[@]}" || fail "desired state cannot be reconciled safely"
install -d -m 0700 -- "$desired_dir"
atomic_copy "$staging_dir/manifest.json" "$desired_dir/manifest.json"
write_metadata "$desired_dir/state.json" "$requested_sha" "$manifest_hash" "$timestamp"

append_journal "validated" "dry-run" "$timestamp"
printf '{"schema":1,"mode":"dry-run","result":"validated","desired":"%s","active":"unchanged","plan":"%s"}\n' \
  "$requested_sha" "$plans_dir/${requested_sha}.json"
exit "$EX_CONFIG"
