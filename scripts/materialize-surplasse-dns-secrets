#!/usr/bin/env python3
"""Validate or atomically materialize the Surplasse OVH DNS credentials."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import secrets
import stat
import sys
import time
from dataclasses import dataclass
from pathlib import Path

EX_USAGE = 64
EX_CONFIG = 78
PRODUCTION_ROOT = Path("/etc/vps/secrets/dns/surplasse")
DEPLOYMENT_LOCK_PATH = Path("/run/lock/vps-static.lock")
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
MAX_CREDENTIAL_BYTES = 129
MAX_MANIFEST_BYTES = 2048
LOCK_TIMEOUT_SECONDS = 30
MANIFEST_NAME = "surplasse-dns-credential-manifest.json"
LOCK_NAME = ".surplasse-dns-credentials.lock"
MANIFEST_CONTRACT = "surplasse-ovh-dns-credentials"
MANIFEST_VERSION = 1
CREDENTIAL_PATTERN = re.compile(rb"[A-Za-z0-9_-]{16,128}\n")


class CredentialError(RuntimeError):
    """Raised when a credential tree differs from the reviewed contract."""


class UsageParser(argparse.ArgumentParser):
    """Return the standard command-line usage status."""

    def error(self, message: str) -> None:
        self.print_usage(sys.stderr)
        print(f"{self.prog}: error: {message}", file=sys.stderr)
        raise SystemExit(EX_USAGE)


@dataclass(frozen=True)
class CredentialSpec:
    name: str


CREDENTIAL_SPECS = (
    CredentialSpec("ovh-application-key"),
    CredentialSpec("ovh-application-secret"),
    CredentialSpec("ovh-consumer-key"),
)
CREDENTIAL_NAMES = {spec.name for spec in CREDENTIAL_SPECS}
FINAL_INVENTORY = CREDENTIAL_NAMES | {MANIFEST_NAME, LOCK_NAME}


def fail(message: str) -> int:
    print(f"Surplasse DNS credential operation refused: {message}", file=sys.stderr)
    return EX_CONFIG


def open_directory(path: Path, label: str) -> int:
    try:
        return os.open(path, DIRECTORY_FLAGS)
    except OSError as exc:
        raise CredentialError(f"cannot open {label}: {exc.strerror}") from exc


def validate_directory(
    descriptor: int, label: str, *, owner: int, group: int, mode: int
) -> None:
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != owner
        or metadata.st_gid != group
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        raise CredentialError(
            f"{label} must be a {owner}:{group} directory with mode {mode:04o}"
        )


def directory_at(
    parent_fd: int,
    name: str,
    label: str,
    *,
    create: bool,
    mode: int,
) -> int:
    if create:
        try:
            os.mkdir(name, mode=mode, dir_fd=parent_fd)
            os.fsync(parent_fd)
        except FileExistsError:
            pass
        except OSError as exc:
            raise CredentialError(f"cannot create {label}: {exc.strerror}") from exc
    try:
        descriptor = os.open(name, DIRECTORY_FLAGS, dir_fd=parent_fd)
    except OSError as exc:
        raise CredentialError(f"cannot open {label}: {exc.strerror}") from exc
    try:
        validate_directory(descriptor, label, owner=0, group=0, mode=mode)
    except Exception:
        os.close(descriptor)
        raise
    return descriptor


def production_directory(*, create: bool) -> tuple[int, list[int]]:
    descriptors: list[int] = []
    root_fd = open_directory(Path("/"), "filesystem root")
    descriptors.append(root_fd)
    try:
        etc_fd = os.open("etc", DIRECTORY_FLAGS, dir_fd=root_fd)
    except OSError as exc:
        raise CredentialError(f"cannot open /etc: {exc.strerror}") from exc
    descriptors.append(etc_fd)
    for name, label, mode in (
        ("vps", "/etc/vps", 0o755),
        ("secrets", "/etc/vps/secrets", 0o700),
        ("dns", "/etc/vps/secrets/dns", 0o700),
        ("surplasse", str(PRODUCTION_ROOT), 0o700),
    ):
        descriptor = directory_at(
            descriptors[-1], name, label, create=create, mode=mode
        )
        descriptors.append(descriptor)
    return descriptors[-1], descriptors


def test_directory(path: Path, label: str) -> tuple[int, list[int]]:
    if os.geteuid() == 0 or os.environ.get("VPS_SURPLASSE_DNS_SECRET_TESTING") != "1":
        raise CredentialError(
            "test-only mode requires an explicit unprivileged test guard"
        )
    if not path.is_absolute():
        raise CredentialError(f"{label} must be absolute")
    descriptor = open_directory(path, label)
    try:
        validate_directory(
            descriptor,
            label,
            owner=os.geteuid(),
            group=os.getegid(),
            mode=0o700,
        )
    except Exception:
        os.close(descriptor)
        raise
    return descriptor, [descriptor]


def read_credential(
    directory_fd: int,
    spec: CredentialSpec,
    *,
    owner: int,
    group: int,
    source: bool,
) -> bytes:
    try:
        descriptor = os.open(spec.name, FILE_FLAGS, dir_fd=directory_fd)
    except FileNotFoundError as exc:
        raise CredentialError(f"credential {spec.name} is missing") from exc
    except OSError as exc:
        raise CredentialError(f"credential {spec.name} is unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        mode = stat.S_IMODE(metadata.st_mode)
        expected_modes = {0o400, 0o600} if source else {0o400}
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != group
            or mode not in expected_modes
        ):
            location = "source" if source else "installed"
            raise CredentialError(
                f"{location} credential {spec.name} has unsafe metadata"
            )
        content = os.read(descriptor, MAX_CREDENTIAL_BYTES + 1)
        if CREDENTIAL_PATTERN.fullmatch(content) is None:
            raise CredentialError(
                f"credential {spec.name} is not one bounded ASCII token"
            )
        return content
    finally:
        os.close(descriptor)


def validate_values(contents: dict[str, bytes]) -> None:
    if contents["ovh-application-secret"] == contents["ovh-consumer-key"]:
        raise CredentialError(
            "OVH application secret and consumer key must be distinct"
        )


def render_manifest(contents: dict[str, bytes]) -> bytes:
    document = {
        "contract": MANIFEST_CONTRACT,
        "sha256": {
            spec.name: hashlib.sha256(contents[spec.name]).hexdigest()
            for spec in CREDENTIAL_SPECS
        },
        "version": MANIFEST_VERSION,
    }
    return (json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n").encode(
        "ascii"
    )


def read_manifest(directory_fd: int, *, owner: int, group: int) -> bytes:
    try:
        descriptor = os.open(MANIFEST_NAME, FILE_FLAGS, dir_fd=directory_fd)
    except FileNotFoundError as exc:
        raise CredentialError("credential manifest is missing") from exc
    except OSError as exc:
        raise CredentialError("credential manifest is unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != group
            or stat.S_IMODE(metadata.st_mode) != 0o400
        ):
            raise CredentialError("credential manifest has unsafe metadata")
        content = os.read(descriptor, MAX_MANIFEST_BYTES + 1)
        if not content or len(content) > MAX_MANIFEST_BYTES or b"\0" in content:
            raise CredentialError("credential manifest has invalid framing")
        return content
    finally:
        os.close(descriptor)


def validate_installed(
    directory_fd: int, *, owner: int, group: int
) -> dict[str, bytes]:
    inventory = set(os.listdir(directory_fd))
    if inventory != FINAL_INVENTORY:
        raise CredentialError(
            "installed credential directory has an unexpected inventory"
        )
    contents = {
        spec.name: read_credential(
            directory_fd, spec, owner=owner, group=group, source=False
        )
        for spec in CREDENTIAL_SPECS
    }
    validate_values(contents)
    if read_manifest(directory_fd, owner=owner, group=group) != render_manifest(
        contents
    ):
        raise CredentialError("credential manifest does not match installed files")
    return contents


def read_source(source_root: Path, *, owner: int, group: int) -> dict[str, bytes]:
    if not source_root.is_absolute():
        raise CredentialError("credential source directory must be absolute")
    source_fd = open_directory(source_root, "credential source directory")
    try:
        validate_directory(
            source_fd,
            "credential source directory",
            owner=owner,
            group=group,
            mode=0o700,
        )
        if set(os.listdir(source_fd)) != CREDENTIAL_NAMES:
            raise CredentialError("credential source directory has an unexpected entry")
        contents = {
            spec.name: read_credential(
                source_fd, spec, owner=owner, group=group, source=True
            )
            for spec in CREDENTIAL_SPECS
        }
        validate_values(contents)
        return contents
    finally:
        os.close(source_fd)


def acquire_lock(
    path: Path,
    *,
    owner: int,
    group: int,
    create: bool,
    label: str,
) -> int:
    flags = os.O_RDWR | os.O_NOFOLLOW
    if create:
        flags |= os.O_CREAT
    try:
        descriptor = os.open(path, flags, 0o600)
    except OSError as exc:
        raise CredentialError(f"cannot open {label}") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != group
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            raise CredentialError(f"{label} has unsafe metadata")
        deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return descriptor
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise CredentialError(f"{label} is busy")
                time.sleep(0.05)
    except Exception:
        os.close(descriptor)
        raise


def acquire_bundle_lock(
    directory_fd: int, *, owner: int, group: int, create: bool
) -> int:
    flags = os.O_RDWR | os.O_NOFOLLOW
    if create:
        flags |= os.O_CREAT
    try:
        descriptor = os.open(LOCK_NAME, flags, 0o600, dir_fd=directory_fd)
    except OSError as exc:
        raise CredentialError("cannot open the credential bundle lock") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != group
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            raise CredentialError("credential bundle lock has unsafe metadata")
        deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return descriptor
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise CredentialError("credential bundle lock is busy")
                time.sleep(0.05)
    except Exception:
        os.close(descriptor)
        raise


def validate_preexisting_target(
    directory_fd: int, *, owner: int, group: int
) -> dict[str, bytes] | None:
    inventory = set(os.listdir(directory_fd))
    if not inventory.issubset(FINAL_INVENTORY):
        raise CredentialError("installed credential directory has an unexpected entry")
    if inventory == {LOCK_NAME}:
        return None
    if inventory != FINAL_INVENTORY:
        raise CredentialError("installed credential directory is incomplete")
    return validate_installed(directory_fd, owner=owner, group=group)


def stage_file(
    directory_fd: int,
    canonical_name: str,
    content: bytes,
    *,
    owner: int,
    group: int,
) -> str:
    temporary_name = f".{canonical_name}.{secrets.token_hex(12)}.pending"
    descriptor = os.open(
        temporary_name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o600,
        dir_fd=directory_fd,
    )
    try:
        try:
            view = memoryview(content)
            while view:
                written = os.write(descriptor, view)
                if written <= 0:
                    raise CredentialError(f"cannot stage {canonical_name}")
                view = view[written:]
            os.fchown(descriptor, owner, group)
            os.fchmod(descriptor, 0o400)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    except Exception:
        try:
            os.unlink(temporary_name, dir_fd=directory_fd)
        except OSError:
            pass
        raise
    else:
        return temporary_name


def install_bundle(
    directory_fd: int,
    contents: dict[str, bytes],
    *,
    owner: int,
    group: int,
) -> None:
    current = validate_preexisting_target(directory_fd, owner=owner, group=group)
    if current == contents:
        return

    staged: dict[str, str] = {}
    try:
        for spec in CREDENTIAL_SPECS:
            staged[spec.name] = stage_file(
                directory_fd,
                spec.name,
                contents[spec.name],
                owner=owner,
                group=group,
            )
        staged[MANIFEST_NAME] = stage_file(
            directory_fd,
            MANIFEST_NAME,
            render_manifest(contents),
            owner=owner,
            group=group,
        )
        for spec in CREDENTIAL_SPECS:
            os.replace(
                staged[spec.name],
                spec.name,
                src_dir_fd=directory_fd,
                dst_dir_fd=directory_fd,
            )
            del staged[spec.name]
        os.fsync(directory_fd)
        os.replace(
            staged[MANIFEST_NAME],
            MANIFEST_NAME,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
        del staged[MANIFEST_NAME]
        os.fsync(directory_fd)
        validate_installed(directory_fd, owner=owner, group=group)
    finally:
        for temporary_name in staged.values():
            try:
                os.unlink(temporary_name, dir_fd=directory_fd)
            except OSError:
                pass


def parse_args() -> argparse.Namespace:
    parser = UsageParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--install-from", type=Path, metavar="ABSOLUTE_DIR")
    parser.add_argument("--test-root", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--test-deployment-lock", type=Path, help=argparse.SUPPRESS)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.test_root is None and args.test_deployment_lock is not None:
        return fail("test deployment lock requires the test credential root")
    if args.test_root is not None and (
        os.geteuid() == 0 or os.environ.get("VPS_SURPLASSE_DNS_SECRET_TESTING") != "1"
    ):
        return fail("test-only mode requires an explicit unprivileged test guard")
    if args.test_root is None and os.geteuid() != 0:
        return fail("production mode requires root")
    owner = 0 if args.test_root is None else os.geteuid()
    group = 0 if args.test_root is None else os.getegid()
    source: dict[str, bytes] | None = None
    if args.install_from is not None:
        try:
            source = read_source(args.install_from, owner=owner, group=group)
        except (OSError, CredentialError) as exc:
            return fail(str(exc))

    descriptors: list[int] = []
    deployment_lock_fd: int | None = None
    bundle_lock_fd: int | None = None
    try:
        if source is not None:
            deployment_lock = (
                DEPLOYMENT_LOCK_PATH
                if args.test_root is None
                else (
                    args.test_deployment_lock
                    if args.test_deployment_lock is not None
                    else args.test_root.parent / ".vps-static.lock"
                )
            )
            if not deployment_lock.is_absolute():
                raise CredentialError("shared deployment lock path must be absolute")
            deployment_lock_fd = acquire_lock(
                deployment_lock,
                owner=owner,
                group=group,
                create=True,
                label="shared deployment lock",
            )
        directory_fd, descriptors = (
            production_directory(create=source is not None)
            if args.test_root is None
            else test_directory(args.test_root, "test credential root")
        )
        inventory = set(os.listdir(directory_fd))
        if not inventory.issubset(FINAL_INVENTORY):
            raise CredentialError(
                "installed credential directory has an unexpected entry"
            )
        bundle_lock_fd = acquire_bundle_lock(
            directory_fd, owner=owner, group=group, create=source is not None
        )
        if source is None:
            validate_installed(directory_fd, owner=owner, group=group)
        else:
            install_bundle(
                directory_fd,
                source,
                owner=owner,
                group=group,
            )
    except (OSError, CredentialError) as exc:
        return fail(str(exc))
    finally:
        if bundle_lock_fd is not None:
            try:
                os.close(bundle_lock_fd)
            except OSError:
                pass
        for descriptor in reversed(descriptors):
            try:
                os.close(descriptor)
            except OSError:
                pass
        if deployment_lock_fd is not None:
            try:
                os.close(deployment_lock_fd)
            except OSError:
                pass
    print("Surplasse DNS credential contract valid")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
