#!/usr/bin/env python3
"""Validate or install the Parkventory provider credential bundle."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import secrets
import stat
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from urllib.parse import urlsplit


EX_CONFIG = 78
PRODUCTION_CREDENTIAL_ROOT = Path("/etc/vps/secrets/parkventory")
PRODUCTION_RUNTIME_ROOT = Path("/etc/vps/applications")
DEPLOYMENT_LOCK_PATH = Path("/run/lock/vps-static.lock")
RUNTIME_CONFIG_NAME = "parkventory.env"
LOCK_NAME = ".parkventory-provider-bundle.lock"
MARKER_NAME = "parkventory-provider-secret-generation.json"
MARKER_CONTRACT = "vps-infra.parkventory-provider-secret-generation.v1"
MATERIALIZER_NAME = "materialize-parkventory-provider-secrets"
TARGET_GENERATION = 1
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
MAX_CREDENTIAL_BYTES = 513
MAX_CONFIG_BYTES = 16 * 1024
MAX_MARKER_BYTES = 4096
LOCK_TIMEOUT_SECONDS = 30
TEST_GUARD = "VPS_PARKVENTORY_PROVIDER_TESTING"
PRINTABLE_LINE = re.compile(rb"[\x21-\x7e]{1,512}\n")
LONG_PRINTABLE_LINE = re.compile(rb"[\x21-\x7e]{32,512}\n")
CONFIG_KEY = re.compile(r"[A-Z][A-Z0-9_]{0,127}")
CONFIG_VALUE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,511}")
CLIENT_ID = re.compile(r"[A-Za-z0-9_-]{8,128}")


class ProviderError(RuntimeError):
    """The provider bundle differs from the reviewed contract."""


@dataclass(frozen=True)
class ProviderSpec:
    identifier: str
    name: str
    long_value: bool


PROVIDER_SPECS = (
    ProviderSpec(
        "parkventory.oidc-client-secret",
        "parkventory-oidc-client-secret",
        True,
    ),
)
CREDENTIAL_FILES = tuple(spec.name for spec in PROVIDER_SPECS)
SOURCE_INVENTORY = set(CREDENTIAL_FILES) | {RUNTIME_CONFIG_NAME}
RUNTIME_KEYS = (
    "PARKVENTORY_DB_MIGRATOR_USER",
    "PARKVENTORY_DB_RUNTIME_USER",
    "PARKVENTORY_JDBC_URL",
    "PARKVENTORY_OIDC_AUTH_SERVER_URL",
    "PARKVENTORY_OIDC_CLIENT_ID",
    "PARKVENTORY_OIDC_ISSUER",
    "PARKVENTORY_SMTP_FROM",
    "PARKVENTORY_SMTP_HOST",
    "PARKVENTORY_SMTP_PORT",
    "PARKVENTORY_WEB_BASE_URL",
)


def fail(message: str) -> int:
    print(f"Parkventory provider bundle refused: {message}", file=sys.stderr)
    return EX_CONFIG


def canonical_json(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode(
        "ascii"
    )


def generation_marker() -> bytes:
    return canonical_json(
        {
            "contract": MARKER_CONTRACT,
            "materializer": MATERIALIZER_NAME,
            "secrets": [
                {"file": spec.name, "id": spec.identifier}
                for spec in PROVIDER_SPECS
            ],
            "target_generation": TARGET_GENERATION,
        }
    )


def open_directory(path: Path, label: str) -> int:
    try:
        return os.open(path, DIRECTORY_FLAGS)
    except OSError as exc:
        raise ProviderError(f"cannot open {label}: {exc.strerror}") from exc


def require_directory(
    descriptor: int, label: str, *, owner: int, group: int, mode: int
) -> None:
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != owner
        or metadata.st_gid != group
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        raise ProviderError(
            f"{label} must be a {owner}:{group} directory with mode {mode:04o}"
        )


def production_directory(path: Path, *, create: bool) -> tuple[int, list[int]]:
    if path == PRODUCTION_CREDENTIAL_ROOT:
        expected = (
            (Path("/etc/vps"), 0o755),
            (Path("/etc/vps/secrets"), 0o700),
            (PRODUCTION_CREDENTIAL_ROOT, 0o700),
        )
    elif path == PRODUCTION_RUNTIME_ROOT:
        expected = (
            (Path("/etc/vps"), 0o755),
            (PRODUCTION_RUNTIME_ROOT, 0o700),
        )
    else:
        raise ProviderError("production directory is outside the fixed contract")
    descriptors: list[int] = []
    for current, mode in expected:
        if create:
            try:
                current.mkdir(mode=mode)
            except FileExistsError:
                pass
            except OSError as exc:
                raise ProviderError(
                    f"cannot create protected directory {current.name}: {exc.strerror}"
                ) from exc
        descriptor = open_directory(current, f"protected directory {current.name}")
        try:
            require_directory(
                descriptor,
                f"protected directory {current.name}",
                owner=0,
                group=0,
                mode=mode,
            )
        except Exception:
            os.close(descriptor)
            raise
        descriptors.append(descriptor)
    return descriptors[-1], descriptors


def test_directory(path: Path, label: str, *, create: bool) -> tuple[int, list[int]]:
    if not path.is_absolute():
        raise ProviderError(f"{label} must be absolute")
    if create:
        try:
            path.mkdir(mode=0o700)
        except FileExistsError:
            pass
    descriptor = open_directory(path, label)
    try:
        require_directory(
            descriptor,
            label,
            owner=os.geteuid(),
            group=os.getegid(),
            mode=0o700,
        )
    except Exception:
        os.close(descriptor)
        raise
    return descriptor, [descriptor]


def read_file(
    directory_fd: int,
    name: str,
    *,
    label: str,
    owner: int,
    group: int,
    modes: set[int],
    maximum: int,
    required: bool,
) -> bytes | None:
    try:
        descriptor = os.open(name, FILE_FLAGS, dir_fd=directory_fd)
    except FileNotFoundError:
        if required:
            raise ProviderError(f"{label} is missing")
        return None
    except OSError as exc:
        raise ProviderError(f"{label} is unsafe: {exc.strerror}") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != group
            or stat.S_IMODE(metadata.st_mode) not in modes
            or not 1 <= metadata.st_size <= maximum
        ):
            raise ProviderError(f"{label} has unsafe metadata")
        content = os.read(descriptor, maximum + 1)
        if len(content) != metadata.st_size:
            raise ProviderError(f"{label} changed while it was read")
        return content
    finally:
        os.close(descriptor)


def validate_provider_value(spec: ProviderSpec, content: bytes) -> None:
    pattern = LONG_PRINTABLE_LINE if spec.long_value else PRINTABLE_LINE
    if pattern.fullmatch(content) is None:
        raise ProviderError(f"provider input {spec.name} has an invalid format")


def parse_runtime_configuration(content: bytes) -> dict[str, str]:
    if (
        not content
        or len(content) > MAX_CONFIG_BYTES
        or not content.endswith(b"\n")
        or b"\r" in content
        or b"\0" in content
    ):
        raise ProviderError("Parkventory runtime configuration framing is invalid")
    try:
        lines = content.decode("ascii").splitlines()
    except UnicodeDecodeError as exc:
        raise ProviderError("Parkventory runtime configuration must be ASCII") from exc
    result: dict[str, str] = {}
    for line in lines:
        key, separator, value = line.partition("=")
        if (
            not separator
            or CONFIG_KEY.fullmatch(key) is None
            or CONFIG_VALUE.fullmatch(value) is None
            or key in result
        ):
            raise ProviderError("Parkventory runtime configuration has an invalid record")
        result[key] = value
    if set(result) != set(RUNTIME_KEYS):
        raise ProviderError("Parkventory runtime configuration key allowlist differs")
    canonical = "".join(f"{key}={result[key]}\n" for key in sorted(result)).encode(
        "ascii"
    )
    if content != canonical:
        raise ProviderError("Parkventory runtime configuration is not canonical")

    expected = {
        "PARKVENTORY_DB_MIGRATOR_USER": "parkventory_migrator",
        "PARKVENTORY_DB_RUNTIME_USER": "parkventory_runtime",
        "PARKVENTORY_JDBC_URL": "jdbc:postgresql://postgresql:5432/parkventory",
        "PARKVENTORY_SMTP_FROM": "no-reply@parkventory.com",
        "PARKVENTORY_SMTP_HOST": "smtp.tem.scaleway.com",
        "PARKVENTORY_SMTP_PORT": "587",
        "PARKVENTORY_WEB_BASE_URL": "https://parkventory.com",
    }
    for key, value in expected.items():
        if result[key] != value:
            raise ProviderError(f"Parkventory runtime configuration {key} differs")
    auth_server = result["PARKVENTORY_OIDC_AUTH_SERVER_URL"]
    try:
        parsed = urlsplit(auth_server)
        port = parsed.port
    except ValueError as exc:
        raise ProviderError("Parkventory OIDC issuer is invalid") from exc
    if (
        parsed.scheme != "https"
        or parsed.username is not None
        or parsed.password is not None
        or port not in {None, 443}
        or parsed.path != "/"
        or parsed.query
        or parsed.fragment
        or parsed.hostname is None
        or not parsed.hostname.endswith(".eu.auth0.com")
        or result["PARKVENTORY_OIDC_ISSUER"] != auth_server
    ):
        raise ProviderError("Parkventory OIDC issuer must be one Auth0 EU HTTPS origin")
    if CLIENT_ID.fullmatch(result["PARKVENTORY_OIDC_CLIENT_ID"]) is None:
        raise ProviderError("Parkventory OIDC client identifier is invalid")
    return result


def read_source(source_root: Path, *, owner: int, group: int) -> tuple[dict[str, bytes], bytes]:
    if not source_root.is_absolute():
        raise ProviderError("provider source directory must be absolute")
    source_fd = open_directory(source_root, "provider source directory")
    try:
        require_directory(
            source_fd,
            "provider source directory",
            owner=owner,
            group=group,
            mode=0o700,
        )
        if set(os.listdir(source_fd)) != SOURCE_INVENTORY:
            raise ProviderError("provider source directory has an unexpected entry")
        contents: dict[str, bytes] = {}
        for spec in PROVIDER_SPECS:
            content = read_file(
                source_fd,
                spec.name,
                label=f"provider input {spec.name}",
                owner=owner,
                group=group,
                modes={0o400, 0o600},
                maximum=MAX_CREDENTIAL_BYTES,
                required=True,
            )
            assert content is not None
            validate_provider_value(spec, content)
            contents[spec.name] = content
        runtime = read_file(
            source_fd,
            RUNTIME_CONFIG_NAME,
            label="Parkventory runtime configuration source",
            owner=owner,
            group=group,
            modes={0o400, 0o600},
            maximum=MAX_CONFIG_BYTES,
            required=True,
        )
        assert runtime is not None
        parse_runtime_configuration(runtime)
        return contents, runtime
    finally:
        os.close(source_fd)


def acquire_lock(
    path: Path, *, owner: int, group: int, create: bool, label: str
) -> int:
    flags = os.O_RDWR | os.O_NOFOLLOW
    if create:
        flags |= os.O_CREAT
    try:
        descriptor = os.open(path, flags, 0o600)
    except OSError as exc:
        raise ProviderError(f"cannot open {label}") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != group
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            raise ProviderError(f"{label} has unsafe metadata")
        deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return descriptor
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise ProviderError(f"{label} is busy")
                time.sleep(0.05)
    except Exception:
        os.close(descriptor)
        raise


def acquire_bundle_lock(
    directory_fd: int, *, owner: int, group: int, create: bool
) -> int:
    flags = os.O_RDWR | os.O_NOFOLLOW
    if create:
        flags |= os.O_CREAT
    try:
        descriptor = os.open(LOCK_NAME, flags, 0o600, dir_fd=directory_fd)
    except OSError as exc:
        raise ProviderError("cannot open provider bundle lock") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != owner
            or metadata.st_gid != group
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            raise ProviderError("provider bundle lock has unsafe metadata")
        deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return descriptor
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise ProviderError("provider bundle lock is busy")
                time.sleep(0.05)
    except Exception:
        os.close(descriptor)
        raise


def read_installed(
    credential_fd: int,
    runtime_fd: int,
    *,
    owner: int,
    application_group: int,
    root_group: int,
    required: bool,
) -> tuple[dict[str, bytes | None], bytes | None, bytes | None]:
    contents: dict[str, bytes | None] = {}
    for spec in PROVIDER_SPECS:
        content = read_file(
            credential_fd,
            spec.name,
            label=f"installed provider input {spec.name}",
            owner=owner,
            group=application_group,
            modes={0o440},
            maximum=MAX_CREDENTIAL_BYTES,
            required=required,
        )
        if content is not None:
            validate_provider_value(spec, content)
        contents[spec.name] = content
    runtime = read_file(
        runtime_fd,
        RUNTIME_CONFIG_NAME,
        label="installed Parkventory runtime configuration",
        owner=owner,
        group=root_group,
        modes={0o600},
        maximum=MAX_CONFIG_BYTES,
        required=required,
    )
    if runtime is not None:
        parse_runtime_configuration(runtime)
    marker = read_file(
        credential_fd,
        MARKER_NAME,
        label="Parkventory provider generation marker",
        owner=owner,
        group=root_group,
        modes={0o400},
        maximum=MAX_MARKER_BYTES,
        required=required,
    )
    if marker is not None and marker != generation_marker():
        raise ProviderError("Parkventory provider generation marker differs")
    return contents, runtime, marker


def stage_file(
    directory_fd: int,
    canonical_name: str,
    content: bytes,
    *,
    owner: int,
    group: int,
    mode: int,
) -> str:
    temporary = f".{canonical_name}.{secrets.token_hex(12)}.pending"
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o600,
        dir_fd=directory_fd,
    )
    try:
        try:
            view = memoryview(content)
            while view:
                written = os.write(descriptor, view)
                if written <= 0:
                    raise ProviderError(f"cannot stage {canonical_name}")
                view = view[written:]
            os.fchown(descriptor, owner, group)
            os.fchmod(descriptor, mode)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    except Exception:
        try:
            os.unlink(temporary, dir_fd=directory_fd)
        except OSError:
            pass
        raise
    return temporary


def pending_files(
    directory_fd: int, names: tuple[str, ...]
) -> dict[str, str]:
    result: dict[str, str] = {}
    for entry in sorted(os.listdir(directory_fd)):
        for canonical_name in names:
            prefix = f".{canonical_name}."
            if not entry.startswith(prefix) or not entry.endswith(".pending"):
                continue
            pattern = re.compile(
                rf"\.{re.escape(canonical_name)}\.[0-9a-f]{{24}}\.pending"
            )
            if pattern.fullmatch(entry) is None or canonical_name in result:
                raise ProviderError(
                    "Parkventory provider bundle has an unsafe staging file"
                )
            result[canonical_name] = entry
            break
    return result


def reject_pending(directory_fd: int, names: tuple[str, ...]) -> None:
    if pending_files(directory_fd, names):
        raise ProviderError("Parkventory provider bundle has a staging file")


def recover_pending(
    directory_fd: int,
    expectations: dict[str, tuple[set[tuple[int, int]], int]],
    *,
    owner: int,
) -> None:
    candidates = pending_files(directory_fd, tuple(expectations))
    validated: list[tuple[str, int, int]] = []
    for canonical_name, entry in candidates.items():
        allowed_metadata, maximum = expectations[canonical_name]
        try:
            descriptor = os.open(entry, FILE_FLAGS, dir_fd=directory_fd)
        except OSError as exc:
            raise ProviderError(
                "Parkventory provider bundle has an unsafe staging file"
            ) from exc
        try:
            metadata = os.fstat(descriptor)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_nlink != 1
                or metadata.st_uid != owner
                or (
                    metadata.st_gid,
                    stat.S_IMODE(metadata.st_mode),
                )
                not in allowed_metadata
                or not 0 <= metadata.st_size <= maximum
            ):
                raise ProviderError(
                    "Parkventory provider bundle has an unsafe staging file"
                )
            validated.append((entry, metadata.st_dev, metadata.st_ino))
        finally:
            os.close(descriptor)
    for entry, device, inode in validated:
        metadata = os.stat(entry, dir_fd=directory_fd, follow_symlinks=False)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_dev != device
            or metadata.st_ino != inode
        ):
            raise ProviderError(
                "Parkventory provider bundle staging file changed during recovery"
            )
    for entry, _, _ in validated:
        os.unlink(entry, dir_fd=directory_fd)
    if validated:
        os.fsync(directory_fd)


def install_bundle(
    credential_fd: int,
    runtime_fd: int,
    contents: dict[str, bytes],
    runtime: bytes,
    *,
    owner: int,
    application_group: int,
    root_group: int,
) -> bool:
    installed, installed_runtime, installed_marker = read_installed(
        credential_fd,
        runtime_fd,
        owner=owner,
        application_group=application_group,
        root_group=root_group,
        required=False,
    )
    if installed_marker is not None:
        complete, complete_runtime, _ = read_installed(
            credential_fd,
            runtime_fd,
            owner=owner,
            application_group=application_group,
            root_group=root_group,
            required=True,
        )
        if complete_runtime != runtime or any(
            complete[spec.name] != contents[spec.name] for spec in PROVIDER_SPECS
        ):
            raise ProviderError("provider rotation requires a new target generation")
        return False

    pending_credentials: dict[str, str] = {}
    pending_runtime: str | None = None
    pending_marker: str | None = None
    try:
        for spec in PROVIDER_SPECS:
            pending_credentials[spec.name] = stage_file(
                credential_fd,
                spec.name,
                contents[spec.name],
                owner=owner,
                group=application_group,
                mode=0o440,
            )
        pending_runtime = stage_file(
            runtime_fd,
            RUNTIME_CONFIG_NAME,
            runtime,
            owner=owner,
            group=root_group,
            mode=0o600,
        )
        pending_marker = stage_file(
            credential_fd,
            MARKER_NAME,
            generation_marker(),
            owner=owner,
            group=root_group,
            mode=0o400,
        )
        for spec in PROVIDER_SPECS:
            temporary = pending_credentials[spec.name]
            os.replace(
                temporary,
                spec.name,
                src_dir_fd=credential_fd,
                dst_dir_fd=credential_fd,
            )
            del pending_credentials[spec.name]
        os.fsync(credential_fd)
        os.replace(
            pending_runtime,
            RUNTIME_CONFIG_NAME,
            src_dir_fd=runtime_fd,
            dst_dir_fd=runtime_fd,
        )
        pending_runtime = None
        os.fsync(runtime_fd)
        os.replace(
            pending_marker,
            MARKER_NAME,
            src_dir_fd=credential_fd,
            dst_dir_fd=credential_fd,
        )
        pending_marker = None
        os.fsync(credential_fd)
        read_installed(
            credential_fd,
            runtime_fd,
            owner=owner,
            application_group=application_group,
            root_group=root_group,
            required=True,
        )
        return True
    finally:
        for temporary in pending_credentials.values():
            try:
                os.unlink(temporary, dir_fd=credential_fd)
            except OSError:
                pass
        if pending_runtime is not None:
            try:
                os.unlink(pending_runtime, dir_fd=runtime_fd)
            except OSError:
                pass
        if pending_marker is not None:
            try:
                os.unlink(pending_marker, dir_fd=credential_fd)
            except OSError:
                pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--validate-source", type=Path, metavar="ABSOLUTE_DIR")
    mode.add_argument("--install-from", type=Path, metavar="ABSOLUTE_DIR")
    mode.add_argument("--check", action="store_true")
    parser.add_argument("--test-root", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--test-runtime-root", type=Path, help=argparse.SUPPRESS)
    parser.add_argument("--test-deployment-lock", type=Path, help=argparse.SUPPRESS)
    return parser.parse_args()


def main() -> int:
    arguments = parse_args()
    testing = arguments.test_root is not None
    if testing and (
        os.geteuid() == 0
        or os.environ.get(TEST_GUARD) != "1"
        or arguments.test_runtime_root is None
    ):
        return fail("test mode requires its explicit unprivileged paths and guard")
    if not testing and (
        os.geteuid() != 0
        or arguments.test_runtime_root is not None
        or arguments.test_deployment_lock is not None
    ):
        return fail("production mode requires root and no test path")
    owner = os.geteuid() if testing else 0
    application_group = os.getegid() if testing else 10001
    root_group = os.getegid() if testing else 0
    source_root = arguments.validate_source or arguments.install_from

    if arguments.validate_source is not None:
        try:
            read_source(source_root, owner=owner, group=root_group)
        except (OSError, ProviderError) as exc:
            return fail(str(exc))
        print(canonical_json({"changed": False, "mode": "validate", "ready": True}).decode("ascii"), end="")
        return 0

    descriptors: list[int] = []
    deployment_lock_fd: int | None = None
    bundle_lock_fd: int | None = None
    try:
        mutating = arguments.install_from is not None
        if mutating:
            deployment_lock = (
                DEPLOYMENT_LOCK_PATH
                if not testing
                else arguments.test_deployment_lock
                or arguments.test_root.parent / ".vps-static.lock"
            )
            if not deployment_lock.is_absolute():
                raise ProviderError("shared deployment lock path must be absolute")
            deployment_lock_fd = acquire_lock(
                deployment_lock,
                owner=owner,
                group=root_group,
                create=True,
                label="shared deployment lock",
            )
        credential_fd, credential_descriptors = (
            production_directory(PRODUCTION_CREDENTIAL_ROOT, create=mutating)
            if not testing
            else test_directory(arguments.test_root, "test credential root", create=False)
        )
        descriptors.extend(credential_descriptors)
        runtime_fd, runtime_descriptors = (
            production_directory(PRODUCTION_RUNTIME_ROOT, create=mutating)
            if not testing
            else test_directory(
                arguments.test_runtime_root,
                "test runtime root",
                create=mutating,
            )
        )
        descriptors.extend(runtime_descriptors)
        bundle_lock_fd = acquire_bundle_lock(
            credential_fd,
            owner=owner,
            group=root_group,
            create=mutating,
        )
        credential_pending = {
            spec.name: (
                {
                    (root_group, 0o600),
                    (application_group, 0o600),
                    (application_group, 0o440),
                },
                MAX_CREDENTIAL_BYTES,
            )
            for spec in PROVIDER_SPECS
        }
        credential_pending[MARKER_NAME] = (
            {(root_group, 0o600), (root_group, 0o400)},
            MAX_MARKER_BYTES,
        )
        runtime_pending = {
            RUNTIME_CONFIG_NAME: ({(root_group, 0o600)}, MAX_CONFIG_BYTES)
        }
        if mutating:
            recover_pending(
                credential_fd,
                credential_pending,
                owner=owner,
            )
            recover_pending(runtime_fd, runtime_pending, owner=owner)
        else:
            reject_pending(credential_fd, tuple(credential_pending))
            reject_pending(runtime_fd, tuple(runtime_pending))
        if mutating:
            assert source_root is not None
            contents, runtime = read_source(
                source_root, owner=owner, group=root_group
            )
            changed = install_bundle(
                credential_fd,
                runtime_fd,
                contents,
                runtime,
                owner=owner,
                application_group=application_group,
                root_group=root_group,
            )
            mode = "install"
        else:
            read_installed(
                credential_fd,
                runtime_fd,
                owner=owner,
                application_group=application_group,
                root_group=root_group,
                required=True,
            )
            changed = False
            mode = "check"
    except (OSError, ProviderError) as exc:
        return fail(str(exc))
    finally:
        if bundle_lock_fd is not None:
            os.close(bundle_lock_fd)
        for descriptor in reversed(descriptors):
            os.close(descriptor)
        if deployment_lock_fd is not None:
            os.close(deployment_lock_fd)
    print(
        canonical_json({"changed": changed, "mode": mode, "ready": True}).decode(
            "ascii"
        ),
        end="",
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
