#!/usr/bin/env python3
"""Verify that a controller state pair matches an anchored Git manifest exactly."""

from __future__ import annotations

import argparse
import hashlib
import re
import subprocess
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR / "lib"))

from release_policy import PolicyError, SHA40_RE, load_manifest, strict_json_loads  # noqa: E402


HASH_RE = re.compile(r"^[0-9a-f]{64}$")
TIMESTAMP_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")


class StateError(ValueError):
    pass


def git(repository: Path, *arguments: str, capture: bool = False) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["git", "-C", str(repository), *arguments],
        check=False,
        stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
        stderr=subprocess.PIPE,
    )


def verify(
    label: str,
    state_path: Path,
    manifest_path: Path,
    repository: Path,
    schema_path: Path,
) -> str:
    try:
        schema = strict_json_loads(schema_path.read_text(encoding="utf-8"))
        if schema.get("$schema") != "https://json-schema.org/draft/2020-12/schema":
            raise StateError("unsupported JSON Schema dialect")
        state = strict_json_loads(state_path.read_text(encoding="utf-8"))
        manifest_bytes = manifest_path.read_bytes()
        load_manifest(manifest_path)
    except (OSError, PolicyError) as exc:
        raise StateError(str(exc)) from exc
    if not isinstance(state, dict) or set(state) != {
        "schema",
        "commit",
        "manifest_sha256",
        "recorded_at",
    }:
        raise StateError("state metadata must contain only schema, commit, manifest_sha256, recorded_at")
    if state["schema"] != 1:
        raise StateError("unsupported state schema")
    commit = state["commit"]
    manifest_hash = state["manifest_sha256"]
    recorded_at = state["recorded_at"]
    if not isinstance(commit, str) or not SHA40_RE.fullmatch(commit):
        raise StateError("state commit is not a full lowercase Git SHA")
    if not isinstance(manifest_hash, str) or not HASH_RE.fullmatch(manifest_hash):
        raise StateError("state manifest hash is invalid")
    if not isinstance(recorded_at, str) or not TIMESTAMP_RE.fullmatch(recorded_at):
        raise StateError("state timestamp is not strict UTC")
    actual_hash = hashlib.sha256(manifest_bytes).hexdigest()
    if actual_hash != manifest_hash:
        raise StateError("persisted manifest does not match state manifest_sha256")
    result = git(repository, "cat-file", "-e", f"{commit}^{{commit}}")
    if result.returncode != 0:
        raise StateError("state commit is unavailable in the infrastructure mirror")
    result = git(repository, "merge-base", "--is-ancestor", commit, "refs/remotes/origin/main")
    if result.returncode != 0:
        raise StateError("state commit is not anchored in origin/main")
    result = git(repository, "show", f"{commit}:releases/production.yaml", capture=True)
    if result.returncode != 0:
        raise StateError("state commit has no production manifest")
    if result.stdout != manifest_bytes:
        raise StateError("persisted manifest differs byte-for-byte from the state commit")
    return commit


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--label", required=True, choices=("desired", "active"))
    parser.add_argument("--state", required=True)
    parser.add_argument("--manifest", required=True)
    parser.add_argument("--repository", required=True)
    parser.add_argument("--schema", required=True)
    args = parser.parse_args()
    try:
        commit = verify(
            args.label,
            Path(args.state),
            Path(args.manifest),
            Path(args.repository),
            Path(args.schema),
        )
    except StateError as exc:
        print(f"{args.label} state verification failed: {exc}", file=sys.stderr)
        return 1
    print(f"{args.label} state valid: {commit}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
