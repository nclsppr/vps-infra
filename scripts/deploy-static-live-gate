#!/usr/bin/python3 -I

"""Root-side gate for one canonical static live-deployment request."""

from __future__ import annotations

import os
import re
import secrets
import signal
import subprocess
import sys


EXIT_USAGE = 64
EXIT_RUNTIME = 70
MAX_INPUT_BYTES = 1024
INPUT_TIMEOUT_SECONDS = 5
ACTIVATION_TIMEOUT_SECONDS = 2100
RECOVERY_TIMEOUT_SECONDS = 300
SYSTEMD_RUN_WAIT_TIMEOUT_SECONDS = (
    ACTIVATION_TIMEOUT_SECONDS + RECOVERY_TIMEOUT_SECONDS + 60
)
DEPLOY_STATIC_PATH = "/usr/local/libexec/vps/deploy-static"
SYSTEMD_RUN_PATH = "/usr/bin/systemd-run"
SAFE_ENVIRONMENT = {
    "HOME": "/root",
    "LANG": "C",
    "LC_ALL": "C",
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
}
APPLICATION_REPOSITORIES = {
    "personal": (
        "ghcr.io/nclsppr/personal/site",
        "ghcr.io/nclsppr/personal/routes",
    ),
    "papersempire": (
        "ghcr.io/nclsppr/papersempire/site",
        "ghcr.io/nclsppr/papersempire/routes",
    ),
    "parkventory": (
        "ghcr.io/nclsppr/parkventory-static-site",
        "ghcr.io/nclsppr/parkventory-static-routes",
    ),
}
PLATFORM_INTEGRATION_REPOSITORY = (
    "ghcr.io/nclsppr/vps-infra/platform-integration"
)
CADDY_REPOSITORY = "ghcr.io/nclsppr/vps-infra/caddy"
CADDY_REFERENCE_PATTERN = re.compile(
    re.escape(CADDY_REPOSITORY)
    + r"(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?"
    + r"@sha256:[0-9a-f]{64}",
    re.ASCII,
)
SHA40_PATTERN = re.compile(r"[0-9a-f]{40}", re.ASCII)
DIGEST_PATTERN = re.compile(r"[0-9a-f]{64}", re.ASCII)


class GateError(ValueError):
    """The supplied deployment request is outside the gate contract."""


def fail(message: str) -> None:
    print(f"deploy-static-live gate: {message}", file=sys.stderr)
    raise SystemExit(EXIT_USAGE)


def _read_timed_out(_signum: int, _frame: object) -> None:
    raise GateError("timed out waiting for a complete request")


def read_request() -> bytes:
    if any(os.isatty(descriptor) for descriptor in (0, 1, 2)):
        raise GateError("terminal input or output is forbidden")

    previous_handler = signal.signal(signal.SIGALRM, _read_timed_out)
    signal.alarm(INPUT_TIMEOUT_SECONDS)
    try:
        payload = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
    except OSError as error:
        raise GateError("could not read the request") from error
    finally:
        signal.alarm(0)
        signal.signal(signal.SIGALRM, previous_handler)

    if len(payload) > MAX_INPUT_BYTES:
        raise GateError("request exceeds the input limit")
    if not payload.endswith(b"\n") or payload.count(b"\n") != 1:
        raise GateError("request must end at exactly one newline")
    return payload


def _is_digest_reference(reference: str, repository: str) -> bool:
    prefix = f"{repository}@sha256:"
    return reference.startswith(prefix) and DIGEST_PATTERN.fullmatch(
        reference[len(prefix) :]
    ) is not None


def parse_request(payload: bytes) -> list[str]:
    if len(payload) > MAX_INPUT_BYTES:
        raise GateError("request exceeds the input limit")
    if not payload.endswith(b"\n") or payload.count(b"\n") != 1:
        raise GateError("request must end at exactly one newline")

    command_bytes = payload[:-1]
    if not command_bytes or any(
        byte < 0x20 or byte > 0x7E for byte in command_bytes
    ):
        raise GateError("request must contain printable ASCII only")
    command = command_bytes.decode("ascii")
    fields = command.split(" ")
    if any(not field for field in fields) or command != " ".join(fields):
        raise GateError("request spacing is not canonical")
    if len(fields) != 8 or fields[0] != "deploy-static-live":
        raise GateError("request shape is invalid")

    (
        _,
        application,
        source_sha,
        site_reference,
        routes_reference,
        integration_sha,
        integration_reference,
        caddy_reference,
    ) = fields

    repositories = APPLICATION_REPOSITORIES.get(application)
    if repositories is None:
        raise GateError("application is outside the allowlist")
    site_repository, routes_repository = repositories
    if SHA40_PATTERN.fullmatch(source_sha) is None:
        raise GateError("source revision is invalid")
    if not _is_digest_reference(site_reference, site_repository):
        raise GateError("site reference is invalid")
    if not _is_digest_reference(routes_reference, routes_repository):
        raise GateError("routes reference is invalid")
    if SHA40_PATTERN.fullmatch(integration_sha) is None:
        raise GateError("integration revision is invalid")
    if not _is_digest_reference(
        integration_reference,
        PLATFORM_INTEGRATION_REPOSITORY,
    ):
        raise GateError("platform integration reference is invalid")
    if CADDY_REFERENCE_PATTERN.fullmatch(caddy_reference) is None:
        raise GateError("Caddy reference is invalid")

    return fields[1:]


def build_activation_command(arguments: list[str]) -> list[str]:
    application = arguments[0]
    random_suffix = secrets.token_hex(12)
    if re.fullmatch(r"[0-9a-f]{24}", random_suffix, re.ASCII) is None:
        raise GateError("could not generate a bounded transient unit name")
    runtime_name = f"vps-static-live-{application}-{random_suffix}"
    unit_name = f"{runtime_name}.service"
    properties = [
        "KillMode=control-group",
        "SendSIGKILL=yes",
        "FinalKillSignal=SIGKILL",
        "Restart=no",
        "UMask=0077",
        "StandardInput=null",
        "StandardOutput=journal",
        "StandardError=journal",
        f"TimeoutStartSec={ACTIVATION_TIMEOUT_SECONDS}s",
        f"RuntimeMaxSec={ACTIVATION_TIMEOUT_SECONDS}s",
        "RuntimeRandomizedExtraSec=0",
        f"RuntimeDirectory={runtime_name}",
        "RuntimeDirectoryMode=0700",
        "RuntimeDirectoryPreserve=no",
        f"TimeoutStopSec={RECOVERY_TIMEOUT_SECONDS}s",
        f"ExecStopPost={DEPLOY_STATIC_PATH} --recover-live {application}",
        "Environment=HOME=/root",
        "Environment=LANG=C",
        "Environment=LC_ALL=C",
        f"Environment=PATH={SAFE_ENVIRONMENT['PATH']}",
        f"Environment=VPS_STATIC_RUNTIME_DIRECTORY=/run/{runtime_name}",
    ]
    command = [
        SYSTEMD_RUN_PATH,
        "--system",
        "--no-ask-password",
        f"--unit={unit_name}",
        "--service-type=exec",
        "--wait",
        "--collect",
        "--quiet",
        "--expand-environment=no",
        "--uid=root",
        "--gid=root",
        "--working-directory=/",
    ]
    for property_value in properties:
        command.extend(("--property", property_value))
    command.extend((
        "--",
        DEPLOY_STATIC_PATH,
        "--activate-live",
        *arguments,
    ))
    return command


def main() -> None:
    if len(sys.argv) != 1:
        fail("arguments are forbidden")
    if os.geteuid() != 0:
        fail("effective root is required")
    os.environ.clear()
    os.environ.update(SAFE_ENVIRONMENT)
    os.umask(0o077)
    try:
        arguments = parse_request(read_request())
    except GateError as error:
        fail(str(error))
    try:
        activation_command = build_activation_command(arguments)
    except (OSError, GateError) as error:
        fail(str(error))

    application = arguments[0]
    activation_failed = False
    try:
        activation = subprocess.run(
            activation_command,
            check=False,
            close_fds=True,
            env=SAFE_ENVIRONMENT,
            shell=False,
            stdin=subprocess.DEVNULL,
            timeout=SYSTEMD_RUN_WAIT_TIMEOUT_SECONDS,
        )
        activation_failed = activation.returncode != 0
    except (OSError, subprocess.TimeoutExpired):
        activation_failed = True

    if not activation_failed:
        return

    print(
        "deploy-static-live gate: activation failed; recovering its transaction",
        file=sys.stderr,
    )
    try:
        recovery = subprocess.run(
            [DEPLOY_STATIC_PATH, "--recover-live", application],
            check=False,
            close_fds=True,
            env=SAFE_ENVIRONMENT,
            shell=False,
            stdin=subprocess.DEVNULL,
            timeout=RECOVERY_TIMEOUT_SECONDS,
        )
        if recovery.returncode != 0:
            print(
                "deploy-static-live gate: immediate transaction recovery failed",
                file=sys.stderr,
            )
    except (OSError, subprocess.TimeoutExpired):
        print(
            "deploy-static-live gate: immediate transaction recovery failed",
            file=sys.stderr,
        )
    raise SystemExit(EXIT_RUNTIME)


if __name__ == "__main__":
    main()
