#!/bin/sh
set -eu
set -f

LANG=C
LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LANG LC_ALL PATH
unset CDPATH ENV BASH_ENV DRY_RUN VPS_CONTROLLER_TESTING VPS_REPOSITORY_DIR \
  VPS_STATE_DIR VPS_LOCK_DIR VPS_PRODUCTION_ENABLE_FILE VPS_VALIDATE_RELEASE \
  VPS_RECONCILE VPS_PLAN_DIGEST_READER VPS_APPLY_EXECUTABLE \
  VPS_EXPECTED_ORIGIN VPS_SCHEMA_FILE GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 \
  GIT_CONFIG_VALUE_0

if [ "$#" -ne 0 ]; then
  echo "forced-command wrapper: arguments are forbidden" >&2
  exit 64
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
original_command=${SSH_ORIGINAL_COMMAND-}
"$script_dir/parse-forced-command" "$original_command" >/dev/null || exit $?

case "$original_command" in
  "deploy "*)
    sha=${original_command#"deploy "}
    exec /usr/bin/sudo -n -- /usr/local/libexec/vps/deploy "$sha"
    ;;
  "deploy-static-live "*)
    printf '%s\n' "$original_command" |
      /usr/bin/sudo -n -- /usr/local/libexec/vps/deploy-static-live-gate
    ;;
  *)
    echo "forced-command wrapper: validated command has no dispatcher" >&2
    exit 70
    ;;
esac
