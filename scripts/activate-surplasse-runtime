import hashlib
import json
import os
import re
import socket
import stat
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, ContextManager, Protocol, Sequence

EX_CONFIG = 78
SHA40 = re.compile(r"[0-9a-f]{40}")
CONTAINER_ID = re.compile(r"[0-9a-f]{12,64}")
OPERATOR_MANIFEST = "surplasse-operator-bundle-manifest.json"
OPERATOR_LOCK = ".surplasse-operator-bundle.lock"
OPERATOR_CONTRACT = "surplasse-operator-bundle"
ACTIVATION_LOCK = "surplasse-activation.lock"
ACTIVATION_STATE = "surplasse-activation.json"
ACTIVATION_STATE_CONTRACT = "surplasse-activation"
ACTIVATION_AUTHORIZATION_ENV = "VPS_SURPLASSE_ACTIVATION_TOKEN"
ACTIVATION_AUTHORIZATION_RE = re.compile(r"[0-9a-f]{64}")
ACTIVATION_LEASE_ROOT = Path("/run/vps-surplasse-activation")
ACTIVATION_IMPLEMENTATION_BLOCKERS = (
    "activation-controller-implementation",
    "application-release-evidence",
    "integration-artifact-materialization",
    "platform-runtime-provenance",
    "runtime-crash-safety",
)
RUNTIME_SERVICES = ("backend", "commande", "dashboard", "docs", "onboarding")
OPERATOR_FILES = (
    "ovh-application-key",
    "ovh-application-secret",
    "ovh-consumer-key",
    "surplasse-jwt-jwks",
    "surplasse-jwt-key-id",
