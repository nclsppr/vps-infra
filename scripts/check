#!/usr/bin/env bash
set -Eeuo pipefail

export PYTHONDONTWRITEBYTECODE=1

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly SCRIPT_DIR
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd -P)
readonly REPOSITORY_ROOT

platform_integration_revision=$("$SCRIPT_DIR/validate-release" \
  --require-json-schema \
  --print-platform-integration-revision \
  "$REPOSITORY_ROOT/releases/production.yaml")
if [[ -n $platform_integration_revision ]]; then
  git -C "$REPOSITORY_ROOT" cat-file -e \
    "${platform_integration_revision}^{commit}" 2>/dev/null || {
      echo "révision source de l'intégration plateforme indisponible ; récupérer l'historique Git complet" >&2
      exit 1
    }
  git -C "$REPOSITORY_ROOT" merge-base --is-ancestor \
    "$platform_integration_revision" HEAD || {
      echo "la révision source de l'intégration plateforme n'est pas un ancêtre de HEAD" >&2
      exit 1
    }
fi
echo "manifeste de release valide : $REPOSITORY_ROOT/releases/production.yaml"
"$SCRIPT_DIR/verify-github-evidence" \
  "$REPOSITORY_ROOT/releases/production.yaml"
"$SCRIPT_DIR/check-public-safe" --root "$REPOSITORY_ROOT"
"$SCRIPT_DIR/check-governance"
"$SCRIPT_DIR/validate-application-state" --root "$REPOSITORY_ROOT"
"$REPOSITORY_ROOT/tests/run"

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck \
    "$SCRIPT_DIR/bootstrap" \
    "$SCRIPT_DIR/check" \
    "$SCRIPT_DIR/converge" \
    "$SCRIPT_DIR/deploy" \
    "$SCRIPT_DIR/doctor" \
    "$SCRIPT_DIR/forced-command" \
    "$SCRIPT_DIR/parse-forced-command" \
    "$REPOSITORY_ROOT/tests/run"
else
  echo "shellcheck unavailable: shell analysis skipped" >&2
fi
