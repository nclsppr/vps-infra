#!/usr/bin/env python3
"""Create the four internal platform secrets without replacing existing data."""

from __future__ import annotations

import argparse
import os
import re
import secrets
import stat
import sys
from dataclasses import dataclass
from pathlib import Path


EX_USAGE = 64
EX_CONFIG = 78
PRODUCTION_ROOT = Path("/etc/vps/secrets/platform")
RANDOM_VALUE_PATTERN = re.compile(rb"[A-Za-z0-9_-]{64}\n")
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW


class SecretError(RuntimeError):
    """Raised when the secret tree differs from the strict contract."""


@dataclass(frozen=True)
class SecretSpec:
    name: str
    group: int


def fail(message: str, status: int = EX_CONFIG) -> int:
    print(f"secret materialization refused: {message}", file=sys.stderr)
    return status


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--test-root",
        type=Path,
        help=argparse.SUPPRESS,
    )
    return parser.parse_args()


def open_directory(path: Path) -> int:
    try:
        return os.open(path, DIRECTORY_FLAGS)
    except OSError as exc:
        raise SecretError(f"cannot open protected directory {path}: {exc.strerror}") from exc


def ensure_directory_at(parent_fd: int, name: str, mode: int) -> int:
    try:
        os.mkdir(name, mode=mode, dir_fd=parent_fd)
    except FileExistsError:
        pass
    except OSError as exc:
        raise SecretError(f"cannot create protected directory {name}: {exc.strerror}") from exc
    try:
        descriptor = os.open(name, DIRECTORY_FLAGS, dir_fd=parent_fd)
    except OSError as exc:
        raise SecretError(f"protected directory {name} is unsafe: {exc.strerror}") from exc
    metadata = os.fstat(descriptor)
    if not stat.S_ISDIR(metadata.st_mode):
        os.close(descriptor)
        raise SecretError(f"protected path {name} is not a directory")
    if metadata.st_uid != 0 or metadata.st_gid != 0:
        os.close(descriptor)
        raise SecretError(f"protected directory {name} is not owned by root:root")
    if stat.S_IMODE(metadata.st_mode) != mode:
        os.close(descriptor)
        raise SecretError(f"protected directory {name} does not have mode {mode:04o}")
    return descriptor


def validate_secret(descriptor: int, spec: SecretSpec, owner: int) -> None:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
        raise SecretError(f"existing secret {spec.name} is not one regular file")
    if metadata.st_uid != owner or metadata.st_gid != spec.group:
        raise SecretError(f"existing secret {spec.name} has an unexpected owner")
    if stat.S_IMODE(metadata.st_mode) != 0o440:
        raise SecretError(f"existing secret {spec.name} does not have mode 0440")
    content = os.read(descriptor, 66)
    if RANDOM_VALUE_PATTERN.fullmatch(content) is None:
        raise SecretError(f"existing secret {spec.name} has an invalid format")


def materialize_secret(directory_fd: int, spec: SecretSpec, owner: int) -> None:
    try:
        descriptor = os.open(
            spec.name,
            os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
    except FileExistsError:
        try:
            descriptor = os.open(spec.name, FILE_FLAGS, dir_fd=directory_fd)
        except OSError as exc:
            raise SecretError(
                f"existing secret {spec.name} cannot be opened safely: {exc.strerror}"
            ) from exc
        try:
            validate_secret(descriptor, spec, owner)
        finally:
            os.close(descriptor)
        return
    except OSError as exc:
        raise SecretError(f"cannot create secret {spec.name}: {exc.strerror}") from exc

    try:
        content = secrets.token_urlsafe(48).encode("ascii") + b"\n"
        if RANDOM_VALUE_PATTERN.fullmatch(content) is None:
            raise SecretError("the operating system returned an invalid random value")
        view = memoryview(content)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise SecretError(f"cannot write secret {spec.name}")
            view = view[written:]
        os.fchown(descriptor, owner, spec.group)
        os.fchmod(descriptor, 0o440)
        os.fsync(descriptor)
        os.lseek(descriptor, 0, os.SEEK_SET)
        validate_secret(descriptor, spec, owner)
    except Exception:
        os.close(descriptor)
        try:
            os.unlink(spec.name, dir_fd=directory_fd)
        except OSError:
            pass
        raise
    os.close(descriptor)


def production_directory() -> tuple[int, list[int]]:
    descriptors: list[int] = []
    root_fd = open_directory(Path("/"))
    descriptors.append(root_fd)
    root_metadata = os.fstat(root_fd)
    if root_metadata.st_uid != 0 or not stat.S_ISDIR(root_metadata.st_mode):
        raise SecretError("the filesystem root is outside the root trust boundary")
    etc_fd = os.open("etc", DIRECTORY_FLAGS, dir_fd=root_fd)
    descriptors.append(etc_fd)
    vps_fd = ensure_directory_at(etc_fd, "vps", 0o755)
    descriptors.append(vps_fd)
    secrets_fd = ensure_directory_at(vps_fd, "secrets", 0o700)
    descriptors.append(secrets_fd)
    platform_fd = ensure_directory_at(secrets_fd, "platform", 0o700)
    descriptors.append(platform_fd)
    return platform_fd, descriptors


def test_directory(path: Path) -> tuple[int, list[int]]:
    if os.geteuid() == 0:
        raise SecretError("root cannot use the test-only directory mode")
    if os.environ.get("VPS_INTERNAL_SECRET_TESTING") != "1":
        raise SecretError("test-only directory mode requires an explicit test guard")
    if not path.is_absolute():
        raise SecretError("test-only directory must be absolute")
    descriptor = open_directory(path)
    metadata = os.fstat(descriptor)
    if metadata.st_uid != os.geteuid() or stat.S_IMODE(metadata.st_mode) != 0o700:
        os.close(descriptor)
        raise SecretError("test-only directory must be caller-owned with mode 0700")
    return descriptor, [descriptor]


def main() -> int:
    args = parse_args()
    if args.test_root is None:
        if os.geteuid() != 0:
            return fail("production mode requires root")
        owner = 0
        specs = (
            SecretSpec("postgres-superuser-password", 70),
            SecretSpec("postgres-exporter-password", 70),
            SecretSpec("grafana-admin-password", 472),
            SecretSpec("grafana-secret-key", 472),
        )
    else:
        owner = os.geteuid()
        specs = tuple(
            SecretSpec(name, os.getegid())
            for name in (
                "postgres-superuser-password",
                "postgres-exporter-password",
                "grafana-admin-password",
                "grafana-secret-key",
            )
        )

    descriptors: list[int] = []
    try:
        directory_fd, descriptors = (
            production_directory()
            if args.test_root is None
            else test_directory(args.test_root)
        )
        for spec in specs:
            materialize_secret(directory_fd, spec, owner)
        os.fsync(directory_fd)
    except (OSError, SecretError) as exc:
        return fail(str(exc))
    finally:
        for descriptor in reversed(descriptors):
            try:
                os.close(descriptor)
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
