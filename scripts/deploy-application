def validate_public_edge_cutover(state: ApplicationState, work: Path) -> None:
    profile = PROFILES[state.application]
    release = state_release(state)
    bundle = bundle_from_release(release, state)
    route_relative = f"caddy/{state.application}.caddy"
    route_path = (
        PARKVENTORY_PUBLIC_EDGE_ROUTE
        if state.application == "parkventory"
        else PUBLIC_EDGE_RUNTIME_ROOT / "routes" / f"{state.application}.caddy"
    )
    require_protected_file(
        route_path,
        f"{state.application} public edge route",
        allowed_modes=frozenset({0o444}),
        maximum_size=MAX_CONFIG_BYTES,
    )
    try:
        route_bytes = route_path.read_bytes()
    except OSError as exc:
        fail(f"cannot read {state.application} public edge route: {exc}")
    if route_bytes != bundle.files[route_relative]:
        fail("public edge route is not the attested application route")
    if state.application == "surplasse":
        validate_surplasse_public_edge_attachment(release)
    elif state.application == "parkventory":
        validate_parkventory_public_edge_attachment(release)
    else:
        network = f"app_{state.application}"
        inspected = _run_bounded(
            [
                str(DOCKER_PATH),
                "container",
                "inspect",
                "--format",
                (
                    "{{.State.Status}}\t"
                    "{{if .State.Health}}{{.State.Health.Status}}{{end}}\t"
                    "{{index .Config.Labels \"com.docker.compose.project\"}}\t"
                    f"{{{{if index .NetworkSettings.Networks \"{network}\"}}}}"
                    "attached{{end}}"
                ),
                PUBLIC_EDGE_CONTAINER,
            ],
            environment=safe_environment(release),
            timeout=30,
            maximum_stdout=256,
        )
        if (
            inspected.stdout
            != "running\thealthy\tvps-public-static-edge\tattached\n"
            or inspected.stderr
        ):
            fail(
                "public edge is not healthy and attached to the exact "
                "application network"
            )
    if profile.default_public_host not in route_bytes.decode("utf-8"):
        fail("public edge route does not name the canonical application host")
    public_probes = bundle.probes.get("public")
    if not isinstance(public_probes, list):
        fail("application public probe inventory is invalid")
    identity_probes = [
        probe
        for probe in public_probes
        if isinstance(probe, dict)
        and isinstance(probe.get("path"), str)
        and probe["path"].startswith("/.well-known/")
        and isinstance(probe.get("body_contains"), str)
    ]
    if len(identity_probes) != 1:
        fail("application edge identity probe is not exact")
    identity = identity_probes[0]
    host = str(identity.get("host", profile.default_public_host))
    _probe_http(
        f"https://{host}{identity['path']}",
        expected_status=int(identity["status"]),
        expected_body=str(identity["body_contains"]),
        work=work,
        resolve_host=host,
    )


def read_parkventory_public_edge_route() -> bytes:
    require_protected_directory(
        PARKVENTORY_PUBLIC_EDGE_STATE_ROOT,
        "Parkventory public edge state root",
    )
    metadata = require_protected_file(
        PARKVENTORY_PUBLIC_EDGE_ROUTE,
        "Parkventory public edge route",
        allowed_modes=frozenset({0o444}),
        maximum_size=MAX_CONFIG_BYTES,
    )
    route = STATIC.read_bounded_file(
        PARKVENTORY_PUBLIC_EDGE_ROUTE,
        MAX_CONFIG_BYTES,
        "Parkventory public edge route",
    )
    if len(route) != metadata.st_size:
        fail("Parkventory public edge route changed while it was read")
    validate_parkventory_route_bytes(route, "Parkventory public edge route")
    return route


def write_parkventory_public_edge_route(route: bytes) -> None:
    validate_parkventory_route_bytes(route, "Parkventory public edge route")
    require_protected_directory(
        PARKVENTORY_PUBLIC_EDGE_STATE_ROOT,
        "Parkventory public edge state root",
    )
    directory_fd = os.open(
        PARKVENTORY_PUBLIC_EDGE_STATE_ROOT,
        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
    )
    temporary_name = f".route.caddy-{secrets.token_hex(8)}"
    descriptor: int | None = None
    try:
        descriptor = os.open(
            temporary_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o444,
            dir_fd=directory_fd,
        )
        view = memoryview(route)
        while view:
            written = os.write(descriptor, view)
            view = view[written:]
        os.fchmod(descriptor, 0o444)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = None
        os.replace(
            temporary_name,
            PARKVENTORY_PUBLIC_EDGE_ROUTE.name,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
        os.fsync(directory_fd)
    except OSError as exc:
        fail(f"cannot atomically replace the Parkventory public edge route: {exc}")
    finally:
        if descriptor is not None:
            os.close(descriptor)
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary_name, dir_fd=directory_fd)
        os.close(directory_fd)


def read_optional_parkventory_public_edge_route() -> bytes | None:
    try:
        PARKVENTORY_PUBLIC_EDGE_ROUTE.lstat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        fail(f"cannot inspect the Parkventory public edge route: {exc}")
    return read_parkventory_public_edge_route()


def remove_parkventory_public_edge_route() -> None:
    require_protected_directory(
        PARKVENTORY_PUBLIC_EDGE_STATE_ROOT,
        "Parkventory public edge state root",
    )
    directory_fd = os.open(
        PARKVENTORY_PUBLIC_EDGE_STATE_ROOT,
        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
    )
    try:
        try:
            metadata = os.stat(
                PARKVENTORY_PUBLIC_EDGE_ROUTE.name,
                dir_fd=directory_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            return
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_gid != 0
            or metadata.st_nlink != 1
            or stat.S_IMODE(metadata.st_mode) != 0o444
        ):
            fail("Parkventory public edge route is not safe to remove")
        os.unlink(PARKVENTORY_PUBLIC_EDGE_ROUTE.name, dir_fd=directory_fd)
        os.fsync(directory_fd)
    except OSError as exc:
        fail(f"cannot remove the Parkventory public edge route: {exc}")
    finally:
        os.close(directory_fd)


def validate_public_edge_base_release(release: Path) -> None:
    parsed = public_edge_base_release_from_value(
        str(release), "public edge base release"
    )
    if parsed != release:
        fail("public edge base release path is not canonical")
    require_protected_directory(
        PUBLIC_EDGE_RELEASE_ROOT,
        "public edge immutable release root",
        mode=0o755,
    )
    require_protected_directory(
        release,
        "public edge immutable release",
        mode=0o555,
    )
    require_protected_directory(
        release / "routes",
        "public edge immutable route directory",
        mode=0o555,
    )
    for path, label, modes in (
        (release / "Caddyfile", "public edge Caddyfile", frozenset({0o444})),
        (release / "compose.yaml", "public edge Compose file", frozenset({0o444})),
        (
            release / "routes" / "parkventory.caddy",
            "public edge Parkventory static route",
            frozenset({0o444}),
        ),
    ):
        require_protected_file(
            path,
            label,
            allowed_modes=modes,
            maximum_size=MAX_CONFIG_BYTES,
        )


def public_edge_compose_document(release: Path) -> dict[str, object]:
    validate_public_edge_base_release(release)
    rendered = _run_bounded(
        [
            str(DOCKER_PATH),
            "compose",
            "--project-directory",
            str(release),
            "--file",
            str(release / "compose.yaml"),
            "config",
            "--format",
            "json",
        ],
        environment=safe_environment(release),
        timeout=60,
        maximum_stdout=MAX_RENDERED_COMPOSE_BYTES,
    )
    if rendered.stderr:
        fail("public edge Compose rendering returned unexpected diagnostics")
    value = strict_json(
        rendered.stdout.encode("utf-8"),
        "public edge rendered Compose document",
        maximum=MAX_RENDERED_COMPOSE_BYTES,
    )
    if not isinstance(value, dict):
        fail("public edge rendered Compose document is not an object")
    return value


def public_edge_release_has_route_selector(release: Path) -> bool:
    document = public_edge_compose_document(release)
    services = document.get("services")
    caddy = services.get("caddy") if isinstance(services, dict) else None
    volumes = caddy.get("volumes") if isinstance(caddy, dict) else None
    if not isinstance(volumes, list):
        fail("public edge rendered Caddy volumes are invalid")
    selectors = [
        item
        for item in volumes
        if isinstance(item, dict)
        and item.get("target") == "/etc/caddy/routes/parkventory.caddy"
    ]
    if len(selectors) > 1:
        fail("public edge rendered Caddy route selector is ambiguous")
    if not selectors:
        return False
    selector = selectors[0]
    if (
        selector.get("type") != "bind"
        or selector.get("source") != str(PARKVENTORY_PUBLIC_EDGE_ROUTE)
        or selector.get("read_only") is not True
    ):
        fail("public edge rendered Caddy route selector differs from policy")
    return True


def read_public_edge_runtime_release() -> Path | None:
    require_protected_directory(
        PUBLIC_EDGE_RUNTIME_ROOT.parent,
        "public edge runtime parent",
        mode=0o755,
    )
    try:
        metadata = PUBLIC_EDGE_RUNTIME_ROOT.lstat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        fail(f"cannot inspect the public edge runtime link: {exc}")
    if (
        not stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_gid != 0
        or metadata.st_nlink != 1
    ):
        fail("public edge runtime path is not one protected symbolic link")
    try:
        raw_target = os.readlink(PUBLIC_EDGE_RUNTIME_ROOT)
    except OSError as exc:
        fail(f"cannot read the public edge runtime link: {exc}")
    target = Path(raw_target)
    if not target.is_absolute():
        target = PUBLIC_EDGE_RUNTIME_ROOT.parent / target
    target = public_edge_base_release_from_value(
        str(target), "public edge runtime release"
    )
    validate_public_edge_base_release(target)
    return target


def switch_public_edge_runtime_release(release: Path | None) -> None:
    if release is not None:
        validate_public_edge_base_release(release)
    parent = PUBLIC_EDGE_RUNTIME_ROOT.parent
    require_protected_directory(parent, "public edge runtime parent", mode=0o755)
    directory_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    temporary = f".public-static-edge-{secrets.token_hex(8)}"
    try:
        if release is None:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(PUBLIC_EDGE_RUNTIME_ROOT.name, dir_fd=directory_fd)
        else:
            os.symlink(str(release), temporary, dir_fd=directory_fd)
            os.replace(
                temporary,
                PUBLIC_EDGE_RUNTIME_ROOT.name,
                src_dir_fd=directory_fd,
                dst_dir_fd=directory_fd,
            )
        os.fsync(directory_fd)
    except OSError as exc:
        fail(f"cannot switch the public edge runtime release: {exc}")
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary, dir_fd=directory_fd)
        os.close(directory_fd)


def public_edge_unit_state(release: Path) -> tuple[bool, bool]:
    active = _run_bounded_status(
        [str(SYSTEMCTL_PATH), "is-active", PUBLIC_EDGE_UNIT],
        environment=safe_environment(release),
        timeout=30,
        maximum_stdout=1024,
    )
    if active.returncode == 0 and active.stdout == "active\n" and not active.stderr:
        is_active = True
    elif (
        active.returncode == 3
        and active.stdout == "inactive\n"
        and not active.stderr
    ):
        is_active = False
    else:
        fail("public edge systemd unit returned an unexpected active state")
    enabled = _run_bounded_status(
        [str(SYSTEMCTL_PATH), "is-enabled", PUBLIC_EDGE_UNIT],
        environment=safe_environment(release),
        timeout=30,
        maximum_stdout=1024,
    )
    if (
        enabled.returncode == 0
        and enabled.stdout == "enabled\n"
        and not enabled.stderr
    ):
        is_enabled = True
    elif (
        enabled.returncode == 1
        and enabled.stdout == "disabled\n"
        and not enabled.stderr
    ):
        is_enabled = False
    else:
        fail("public edge systemd unit returned an unexpected enablement state")
    return is_active, is_enabled


def run_public_edge_systemctl(release: Path, *arguments: str) -> None:
    command = [str(SYSTEMCTL_PATH)]
    if arguments in {("start",), ("restart",)}:
        # These starts run while the controller owns the shared recovery lock.
        # Scheduling the unit's recovery dependencies would make them wait on
        # that same lock. Their journals are proved absent before the durable
        # base transaction is created, so only this controller-owned job is
        # admitted here; ordinary boot still runs every recovery dependency.
        command.append("--job-mode=ignore-dependencies")
    command.extend(arguments)
    if arguments != ("daemon-reload",):
        command.append(PUBLIC_EDGE_UNIT)
    _run_bounded(
        command,
        environment=safe_environment(release),
        timeout=300,
        maximum_stdout=64 * 1024,
    )


def validate_public_edge_bind_identities(
    release: Path,
    *,
    include_route_selector: bool,
) -> None:
    inspected = _run_bounded(
        [
            str(DOCKER_PATH),
            "container",
            "inspect",
            "--format",
            (
                "{{.State.Status}}\t"
                "{{if .State.Health}}{{.State.Health.Status}}{{end}}\t"
                "{{.State.Pid}}\t"
                "{{index .Config.Labels \"com.docker.compose.project\"}}"
            ),
            PUBLIC_EDGE_CONTAINER,
        ],
        environment=safe_environment(release),
        timeout=30,
        maximum_stdout=1024,
    )
    fields = inspected.stdout.removesuffix("\n").split("\t")
    if (
        len(fields) != 4
        or fields[0] != "running"
        or fields[1] != "healthy"
        or not fields[2].isdigit()
        or int(fields[2]) <= 0
        or fields[3] != "vps-public-static-edge"
        or inspected.stderr
        or not inspected.stdout.endswith("\n")
    ):
        fail("public edge Caddy process identity is invalid")
    pid = int(fields[2])
    sources = [release / "Caddyfile", release / "routes"]
    targets = [
        Path(f"/proc/{pid}/root/etc/caddy/Caddyfile"),
        Path(f"/proc/{pid}/root/etc/caddy/routes"),
    ]
    if include_route_selector:
        sources.append(PARKVENTORY_PUBLIC_EDGE_ROUTE)
        targets.append(
            Path(f"/proc/{pid}/root/etc/caddy/routes/parkventory.caddy")
        )
    for source, target in zip(sources, targets):
        try:
            source_metadata = source.stat()
            target_metadata = target.stat()
        except OSError as exc:
            fail(f"cannot inspect public edge bind identity: {exc}")
        if (
            source_metadata.st_dev != target_metadata.st_dev
            or source_metadata.st_ino != target_metadata.st_ino
        ):
            fail("public edge Caddy uses a stale or foreign bind identity")


def validate_public_edge_base_live(release: Path) -> None:
    include_route_selector = public_edge_release_has_route_selector(release)
    validate_public_edge_bind_identities(
        release,
        include_route_selector=include_route_selector,
    )
    if include_route_selector:
        validate_parkventory_public_edge_attachment(release)


def refuse_surplasse_public_edge_owner() -> None:
    for path in (
        PUBLIC_EDGE_SURPLASSE_STATE_ROOT / "active.json",
        PUBLIC_EDGE_SURPLASSE_STATE_ROOT / "transaction.json",
    ):
        try:
            path.lstat()
        except FileNotFoundError:
            continue
        except OSError as exc:
            fail(f"cannot inspect Surplasse public edge ownership: {exc}")
        fail(
            "base edge convergence cannot replace an active or interrupted "
            "Surplasse extension"
        )


def parkventory_base_route_for_candidate(release: Path) -> bytes:
    if read_transaction("parkventory") is not None:
        fail("Parkventory application transaction must recover before a base switch")
    if parkventory_handoff_path_present():
        fail("Parkventory public handoff must recover before a base switch")
    refuse_static_deployment_transactions()
    active = read_state(
        ACTIVE_STATE_ROOT,
        "parkventory.json",
        "active Parkventory application state",
    )
    if active is not None:
        route = read_optional_parkventory_public_edge_route()
        if route is None:
            fail("dynamic Parkventory ownership has no durable public route")
        return route
    static_state = STATIC.read_deployment_state_file(
        STATIC_ACTIVE_STATE_ROOT,
        "parkventory.json",
        "Parkventory static active state",
    )
    static_releases = STATIC_PARKVENTORY_CURRENT.parent / "releases"
    static_target = STATIC.get_current_target(
        STATIC_PARKVENTORY_CURRENT,
        static_releases,
    )
    if (
        static_state is None
        or static_target != STATIC.release_target_for_state(static_state)
    ):
        fail("Parkventory has no complete static or dynamic public owner")
    STATIC.validate_persisted_release(static_state, static_releases)
    route_path = release / "routes" / "parkventory.caddy"
    route = STATIC.read_bounded_file(
        route_path,
        MAX_CONFIG_BYTES,
        "candidate Parkventory static route",
    )
    validate_parkventory_route_bytes(route, "candidate Parkventory static route")
    return route


def restore_public_edge_service_state(
    transaction: PublicEdgeBaseTransaction,
    previous: Path | None,
) -> None:
    environment_release = previous or Path("/root")
    if previous is not None and transaction.previous_unit_active:
        run_public_edge_systemctl(previous, "daemon-reload")
        run_public_edge_systemctl(previous, "start")
        force_recreate_public_edge_for_parkventory(previous)
        validate_public_edge_base_live(previous)
    else:
        run_public_edge_systemctl(environment_release, "stop")
    run_public_edge_systemctl(
        environment_release,
        "enable" if transaction.previous_unit_enabled else "disable",
    )


def public_edge_unit_installed() -> bool:
    try:
        PUBLIC_EDGE_UNIT_PATH.lstat()
    except FileNotFoundError:
        return False
    except OSError as exc:
        fail(f"cannot inspect the public edge systemd unit: {exc}")
    require_protected_file(
        PUBLIC_EDGE_UNIT_PATH,
        "public edge systemd unit",
        allowed_modes=frozenset({0o644}),
        maximum_size=MAX_CONFIG_BYTES,
    )
    return True


def public_edge_project_container_ids(
    release: Path,
    *,
    include_stopped: bool,
) -> tuple[str, ...]:
    command = [str(DOCKER_PATH), "ps"]
    if include_stopped:
        command.append("--all")
    command.extend(
        (
            "--quiet",
            "--no-trunc",
            "--filter",
            "label=com.docker.compose.project=vps-public-static-edge",
        )
    )
    listed = _run_bounded(
        command,
        environment=safe_environment(release),
        timeout=30,
        maximum_stdout=64 * 1024,
    )
    identifiers = tuple(listed.stdout.splitlines())
    if (
        listed.stderr
        or (listed.stdout and not listed.stdout.endswith("\n"))
        or len(identifiers) > 64
        or len(set(identifiers)) != len(identifiers)
        or any(re.fullmatch(r"[0-9a-f]{64}", value) is None for value in identifiers)
    ):
        fail("public edge project container inventory is invalid")
    return identifiers


def refuse_public_edge_stop_journals_locked() -> None:
    if read_public_edge_base_transaction() is not None:
        fail("public edge base recovery must finish before stopping the edge")
    for application in sorted(PROFILES):
        if read_transaction(application) is not None:
            fail(
                f"{application} application recovery must finish before "
                "stopping the edge"
            )
    if parkventory_handoff_path_present():
        fail("Parkventory handoff recovery must finish before stopping the edge")
    refuse_static_deployment_transactions()
    surplasse_transaction = PUBLIC_EDGE_SURPLASSE_STATE_ROOT / "transaction.json"
    try:
        surplasse_transaction.lstat()
    except FileNotFoundError:
        pass
    except OSError as exc:
        fail(f"cannot inspect the Surplasse public edge transaction: {exc}")
    else:
        fail("Surplasse public edge recovery must finish before stopping the edge")


def stop_public_edge_base_locked() -> None:
    refuse_public_edge_stop_journals_locked()
    release = read_public_edge_runtime_release()
    environment_release = release or Path("/root")
    if public_edge_unit_installed():
        # Disable first so a crash cannot make a partially stopped edge return
        # automatically at boot. The immutable runtime link remains available
        # to ExecStop and to a later controlled start.
        run_public_edge_systemctl(environment_release, "disable")
        run_public_edge_systemctl(environment_release, "stop")
        active, enabled = public_edge_unit_state(environment_release)
        if active or enabled:
            fail("public edge systemd unit remained active or enabled")
    for identifier in public_edge_project_container_ids(
        environment_release,
        include_stopped=True,
    ):
        stopped = _run_bounded(
            [str(DOCKER_PATH), "stop", "--time", "30", identifier],
            environment=safe_environment(environment_release),
            timeout=60,
            maximum_stdout=1024,
        )
        if stopped.stdout != f"{identifier}\n" or stopped.stderr:
            fail("public edge residual container stop returned an invalid result")
    if public_edge_project_container_ids(
        environment_release,
        include_stopped=False,
    ):
        fail("public edge project still owns a running container")


def rollback_public_edge_base_locked(
    transaction: PublicEdgeBaseTransaction,
) -> None:
    if transaction.phase != "rollback":
        transaction = dataclasses.replace(transaction, phase="rollback")
        write_public_edge_base_transaction(transaction)
    candidate = Path(transaction.candidate_release)
    validate_public_edge_base_release(candidate)
    previous = (
        None
        if transaction.previous_release is None
        else Path(transaction.previous_release)
    )
    if previous is not None:
        validate_public_edge_base_release(previous)
    current = read_public_edge_runtime_release()
    if current not in {candidate, previous}:
        fail("public edge base rollback found a foreign runtime release")
    current_route = read_optional_parkventory_public_edge_route()
    allowed_routes = {
        transaction.candidate_route.encode("utf-8"),
        (
            None
            if transaction.previous_route is None
            else transaction.previous_route.encode("utf-8")
        ),
    }
    if current_route not in allowed_routes:
        fail("public edge base rollback found a foreign Parkventory route")
    if previous is None:
        # Keep the candidate link available to the unit's ExecStop command.
        # A first-activation rollback may remove it only after Caddy is down.
        restore_public_edge_service_state(transaction, None)
        if transaction.previous_route is None:
            remove_parkventory_public_edge_route()
        else:
            write_parkventory_public_edge_route(
                transaction.previous_route.encode("utf-8")
            )
        switch_public_edge_runtime_release(None)
    else:
        if transaction.previous_route is None:
            remove_parkventory_public_edge_route()
        else:
            write_parkventory_public_edge_route(
                transaction.previous_route.encode("utf-8")
            )
        switch_public_edge_runtime_release(previous)
        restore_public_edge_service_state(transaction, previous)
    remove_public_edge_base_transaction()


def recover_public_edge_base_locked() -> None:
    transaction = read_public_edge_base_transaction()
    if transaction is None:
        return
    rollback_public_edge_base_locked(transaction)


def prepare_public_edge_base_locked(candidate: Path) -> None:
    if read_public_edge_base_transaction() is not None:
        fail("a public edge base transaction already exists")
    refuse_public_edge_stop_journals_locked()
    validate_public_edge_base_release(candidate)
    if not public_edge_release_has_route_selector(candidate):
        fail("candidate public edge release has no durable Parkventory selector")
    refuse_surplasse_public_edge_owner()
    previous = read_public_edge_runtime_release()
    previous_route = read_optional_parkventory_public_edge_route()
    candidate_route = parkventory_base_route_for_candidate(candidate)
    active, enabled = public_edge_unit_state(candidate)
    transaction = PublicEdgeBaseTransaction(
        candidate_release=str(candidate),
        previous_release=None if previous is None else str(previous),
        candidate_route=candidate_route.decode("utf-8"),
        previous_route=(
            None if previous_route is None else previous_route.decode("utf-8")
        ),
        previous_unit_active=active,
        previous_unit_enabled=enabled,
        phase="prepared",
    )
    write_public_edge_base_transaction(transaction)
    try:
        write_parkventory_public_edge_route(candidate_route)
        switch_public_edge_runtime_release(candidate)
        run_public_edge_systemctl(candidate, "daemon-reload")
        run_public_edge_systemctl(candidate, "enable")
        run_public_edge_systemctl(candidate, "restart")
        force_recreate_public_edge_for_parkventory(candidate)
        validate_public_edge_base_live(candidate)
        write_public_edge_base_transaction(
            dataclasses.replace(transaction, phase="reconciled")
        )
    except BaseException as switch_error:
        try:
            persisted = read_public_edge_base_transaction()
            if persisted is not None:
                rollback_public_edge_base_locked(persisted)
        except BaseException as rollback_error:
            raise ApplicationDeploymentError(
                "public edge base switch and rollback both failed: "
                f"{switch_error}; {rollback_error}"
            ) from rollback_error
        raise


def commit_public_edge_base_locked(candidate: Path) -> None:
    transaction = read_public_edge_base_transaction()
    if transaction is None:
        fail("public edge base commit has no durable transaction")
    if (
        transaction.phase != "reconciled"
        or transaction.candidate_release != str(candidate)
    ):
        fail("public edge base commit differs from its reconciled candidate")
    if read_public_edge_runtime_release() != candidate:
        fail("public edge base commit found a different runtime release")
    route = read_parkventory_public_edge_route()
    if route != transaction.candidate_route.encode("utf-8"):
        fail("public edge base commit found a different Parkventory route")
    active, enabled = public_edge_unit_state(candidate)
    if not active or not enabled:
        fail("public edge base commit found an inactive systemd unit")
    validate_public_edge_base_live(candidate)
    remove_public_edge_base_transaction()


def public_edge_unit_is_active(release: Path) -> bool:
    active = _run_bounded_status(
        [str(SYSTEMCTL_PATH), "is-active", PUBLIC_EDGE_UNIT],
        environment=safe_environment(release),
        timeout=30,
        maximum_stdout=1024,
    )
    if active.returncode == 0 and active.stdout == "active\n" and not active.stderr:
        return True
    if active.returncode == 3 and active.stdout == "inactive\n" and not active.stderr:
        return False
    fail("public edge systemd unit returned an unexpected active state")


def validate_public_edge_compose_configuration(release: Path) -> None:
    configured = _run_bounded(
        [
            str(DOCKER_PATH),
            "compose",
            "--project-directory",
            str(PUBLIC_EDGE_RUNTIME_ROOT),
            "--file",
            str(PUBLIC_EDGE_RUNTIME_ROOT / "compose.yaml"),
            "config",
            "--quiet",
        ],
        environment=safe_environment(release),
        timeout=60,
        maximum_stdout=1024,
    )
    if configured.stdout or configured.stderr:
        fail("public edge Compose validation returned unexpected output")


def parkventory_public_edge_container_is_live(release: Path) -> bool:
    listed = _run_bounded(
        [
            str(DOCKER_PATH),
            "ps",
            "--quiet",
            "--no-trunc",
            "--filter",
            "label=com.docker.compose.project=vps-public-static-edge",
            "--filter",
            "label=com.docker.compose.service=caddy",
        ],
        environment=safe_environment(release),
        timeout=30,
        maximum_stdout=1024,
    )
    if not listed.stdout and not listed.stderr:
        return False
    identifiers = listed.stdout.splitlines()
    if (
        len(identifiers) != 1
        or CONTAINER_ID_RE.fullmatch(identifiers[0]) is None
        or listed.stderr
    ):
        fail("public edge running container inventory is not exact")
    identifier = identifiers[0]
    inspected = _run_bounded(
        [
            str(DOCKER_PATH),
            "container",
            "inspect",
            "--format",
            (
                "{{.Id}}\t{{.Name}}\t{{.State.Status}}\t"
                "{{if .State.Health}}{{.State.Health.Status}}{{end}}\t"
                "{{index .Config.Labels \"com.docker.compose.project\"}}\t"
                "{{index .Config.Labels \"com.docker.compose.service\"}}\t"
                "{{range .Mounts}}"
                "{{if eq .Destination \"/etc/caddy/routes/parkventory.caddy\"}}"
                "{{.Type}}\t{{.Source}}\t{{.RW}}{{end}}{{end}}"
            ),
            identifier,
        ],
        environment=safe_environment(release),
        timeout=30,
        maximum_stdout=2048,
    )
    expected = (
        f"{identifier}\t/{PUBLIC_EDGE_CONTAINER}\trunning\thealthy\t"
        "vps-public-static-edge\tcaddy\tbind\t"
        f"{PARKVENTORY_PUBLIC_EDGE_ROUTE}\tfalse\n"
    )
    if inspected.stdout != expected or inspected.stderr:
        fail("live public edge does not use the protected Parkventory route bind")
    return True


def force_recreate_public_edge_for_parkventory(release: Path) -> None:
    _run_bounded(
        [
            str(DOCKER_PATH),
            "compose",
            "--project-directory",
            str(PUBLIC_EDGE_RUNTIME_ROOT),
            "--file",
            str(PUBLIC_EDGE_RUNTIME_ROOT / "compose.yaml"),
            "up",
            "--detach",
            "--wait",
            "--no-build",
            "--pull",
            "never",
            "--force-recreate",
            "--remove-orphans",
            "caddy",
        ],
        environment=safe_environment(release),
        timeout=300,
        maximum_stdout=64 * 1024,
    )


def reconcile_public_edge_for_parkventory(release: Path) -> None:
    if not public_edge_unit_is_active(release):
        fail("public edge systemd unit is not active")
    force_recreate_public_edge_for_parkventory(release)


def begin_parkventory_handoff(
    state: ApplicationState,
    work: Path,
) -> ParkventoryHandoff:
    if state.application != "parkventory":
        fail("only Parkventory can release its static public identity")
    if parkventory_handoff_path_present():
        fail("a Parkventory handoff journal already exists")
    if STATIC.read_deployment_transaction("parkventory") is not None:
        fail("Parkventory static deployment has an unfinished transaction")
    static_state = STATIC.read_deployment_state_file(
        STATIC_ACTIVE_STATE_ROOT,
        "parkventory.json",
        "Parkventory static active state",
    )
    releases = STATIC_PARKVENTORY_CURRENT.parent / "releases"
    static_target = STATIC.get_current_target(
        STATIC_PARKVENTORY_CURRENT,
        releases,
    )
    if static_state is None or static_target is None:
        fail("Parkventory static ownership is incomplete before handoff")
    if static_target != STATIC.release_target_for_state(static_state):
        fail("Parkventory static active state differs from its current link")
    STATIC.validate_persisted_release(static_state, releases)
    static_route = read_parkventory_public_edge_route()
    runtime_static_route_path = (
        PUBLIC_EDGE_RUNTIME_ROOT / "routes" / "parkventory.caddy"
    )
    require_protected_file(
        runtime_static_route_path,
        "Parkventory retained static edge route",
        allowed_modes=frozenset({0o444}),
        maximum_size=MAX_CONFIG_BYTES,
    )
    retained_static_route = STATIC.read_bounded_file(
        runtime_static_route_path,
        MAX_CONFIG_BYTES,
        "Parkventory retained static edge route",
    )
    if static_route != retained_static_route:
        fail("Parkventory stable route does not match the retained static route")
    release = state_release(state)
    bundle = bundle_from_release(release, state)
    candidate_route = bundle.files.get("caddy/parkventory.caddy")
    if not isinstance(candidate_route, bytes):
        fail("Parkventory application bundle has no exact Caddy route")
    validate_parkventory_route_bytes(candidate_route, "attested Parkventory route")
    handoff = ParkventoryHandoff(
        candidate=state,
        static_state=static_state,
        static_target=static_target,
        static_route=static_route.decode("utf-8"),
        static_route_digest=content_digest(static_route),
        candidate_route_digest=content_digest(candidate_route),
        phase="prepared",
    )
    if handoff.static_route_digest == handoff.candidate_route_digest:
        fail("Parkventory static and application routes are not distinguishable")
    write_parkventory_handoff(handoff)
    write_parkventory_public_edge_route(candidate_route)
    handoff = dataclasses.replace(handoff, phase="route-switched")
    write_parkventory_handoff(handoff)
    reconcile_public_edge_for_parkventory(release)
    validate_public_edge_cutover(state, work)
    handoff = dataclasses.replace(handoff, phase="edge-verified")
    write_parkventory_handoff(handoff)
    STATIC.remove_protected_state_file(
        STATIC_ACTIVE_STATE_ROOT,
        "parkventory.json",
        "Parkventory static active state",
    )
    STATIC.restore_current_target(
        STATIC_PARKVENTORY_CURRENT,
        None,
        releases,
    )
    handoff = dataclasses.replace(handoff, phase="static-released")
    write_parkventory_handoff(handoff)
    return handoff


def restore_parkventory_static_handoff(handoff: ParkventoryHandoff) -> None:
    app_root = APPLICATION_ROOT / "parkventory"
    app_releases = app_root / "releases"
    active = read_state(
        ACTIVE_STATE_ROOT,
        "parkventory.json",
        "active application state",
    )
    target = current_target(app_root / "current", app_releases)
    expected_target = release_target(handoff.candidate)
    if (active, target) not in (
        (handoff.candidate, expected_target),
        (None, expected_target),
        (None, None),
    ):
        fail("Parkventory handoff found an unexpected Compose active tuple")
    static_releases = STATIC_PARKVENTORY_CURRENT.parent / "releases"
    static_transaction = STATIC.read_deployment_transaction("parkventory")
    if static_transaction is not None:
        fail("Parkventory handoff found an unexpected static transaction")
    static_active = STATIC.read_deployment_state_file(
        STATIC_ACTIVE_STATE_ROOT,
        "parkventory.json",
        "Parkventory static active state",
    )
    static_target = STATIC.get_current_target(
        STATIC_PARKVENTORY_CURRENT,
        static_releases,
    )
    if (static_active, static_target) not in (
        (handoff.static_state, handoff.static_target),
        (None, handoff.static_target),
        (None, None),
    ):
        fail("Parkventory handoff found an unexpected static active tuple")
    STATIC.validate_persisted_release(handoff.static_state, static_releases)
    inventory = STATIC.read_persisted_inventory(handoff.static_state)
    release = state_release(handoff.candidate)
    validate_public_edge_compose_configuration(release)
    if handoff.phase != "restoring-static":
        handoff = dataclasses.replace(handoff, phase="restoring-static")
        write_parkventory_handoff(handoff)

    # The rollback journal is durable before ownership changes. Remove the
    # Compose state before its current link, so recovery can distinguish every
    # reachable partial tuple and can never observe candidate state with no
    # candidate link.
    remove_state(
        ACTIVE_STATE_ROOT,
        "parkventory.json",
        "active application state",
    )
    switch_current(app_root / "current", None, app_releases)
    STATIC.restore_current_target(
        STATIC_PARKVENTORY_CURRENT,
        handoff.static_target,
        static_releases,
    )
    static_route = handoff.static_route.encode("utf-8")
    write_parkventory_public_edge_route(static_route)
    force_recreate_public_edge_for_parkventory(release)
    validate_parkventory_public_edge_attachment(release)
    with tempfile.TemporaryDirectory(
        prefix="vps-parkventory-static-restore-",
        dir="/var/tmp",
    ) as temporary_name:
        work = Path(temporary_name)
        work.chmod(0o755)
        STATIC.probe_live_health(
            inventory,
            STATIC.PROFILES["parkventory"],
            work,
            STATIC.PROFILES["parkventory"].probe_timeout_seconds,
        )
    # Publish static ownership only after the restored route has passed its
    # public probe. The candidate runtime keeps running until that boundary.
    STATIC.write_deployment_state_file(
        STATIC_ACTIVE_STATE_ROOT,
        "parkventory.json",
        handoff.static_state,
        "Parkventory static active state",
    )
    stop_runtime(handoff.candidate)
    write_state(
        QUARANTINE_ROOT,
        quarantine_name(handoff.candidate),
        handoff.candidate,
        "quarantined application state",
    )
    remove_parkventory_handoff()


def recover_parkventory_handoff(*, preserve_forward_journal: bool = False) -> None:
    if not parkventory_handoff_path_present():
        return
    handoff = read_parkventory_handoff()
    if handoff is None:
        fail("Parkventory handoff journal disappeared during recovery")
    app_root = APPLICATION_ROOT / "parkventory"
    releases = app_root / "releases"
    active = read_state(
        ACTIVE_STATE_ROOT,
        "parkventory.json",
        "active application state",
    )
    target = current_target(app_root / "current", releases)
    if handoff.phase == "restoring-static" or static_parkventory_owner_present():
        # A restored static state, transaction, or current link is a durable
        # rollback signal. Finish that rollback even if the Compose tuple is
        # still complete and would otherwise look eligible for forward repair.
        restore_parkventory_static_handoff(handoff)
        return
    if active == handoff.candidate and target == release_target(handoff.candidate):
        try:
            revalidate_parkventory_backup_before_runtime()
            with tempfile.TemporaryDirectory(
                prefix="vps-parkventory-handoff-forward-",
                dir="/var/tmp",
            ) as temporary_name:
                work = Path(temporary_name)
                work.chmod(0o755)
                validate_public_edge_cutover(handoff.candidate, work)
                probe_runtime(handoff.candidate, work)
        except BaseException:
            restore_parkventory_static_handoff(handoff)
            return
        if not preserve_forward_journal:
            remove_parkventory_handoff()
        return
    expected_target = release_target(handoff.candidate)
    if (active, target) in ((None, expected_target), (None, None)):
        restore_parkventory_static_handoff(handoff)
        return
    fail("Parkventory handoff found a foreign Compose active tuple")


def complete_parkventory_handoff(state: ApplicationState) -> None:
    if not parkventory_handoff_path_present():
        return
    handoff = read_parkventory_handoff()
    if (
        handoff is None
        or handoff.candidate != state
        or handoff.phase != "static-released"
    ):
        fail("Parkventory committed tuple differs from its public handoff")
    route = read_parkventory_public_edge_route()
    if content_digest(route) != handoff.candidate_route_digest:
        fail("Parkventory committed route differs from its public handoff")
    remove_parkventory_handoff()


def static_parkventory_owner_present() -> bool:
    for path in (
        STATIC_ACTIVE_STATE_ROOT / "parkventory.json",
        STATIC_TRANSACTION_ROOT / "parkventory.json",
        STATIC_PARKVENTORY_CURRENT,
    ):
        try:
            path.lstat()
        except FileNotFoundError:
            continue
        except OSError as exc:
            fail(f"cannot inspect Parkventory static ownership path {path}: {exc}")
        return True
    return False


def refuse_static_deployment_transactions() -> None:
    for application in sorted(STATIC.PROFILES):
        if STATIC.read_deployment_transaction(application) is not None:
            fail(
                f"{application} static deployment recovery must finish before "
                "the public edge can change"
            )


def parkventory_static_handoff_preflight() -> bool:
    """Prove the complete static tuple before fetch or database mutation."""
    refuse_static_deployment_transactions()
    if parkventory_handoff_path_present():
        fail("Parkventory handoff recovery must finish before a new activation")
    static_state = STATIC.read_deployment_state_file(
        STATIC_ACTIVE_STATE_ROOT,
        "parkventory.json",
        "Parkventory static active state",
    )
    releases = STATIC_PARKVENTORY_CURRENT.parent / "releases"
    static_target = STATIC.get_current_target(
        STATIC_PARKVENTORY_CURRENT,
        releases,
    )
    if static_state is None and static_target is None:
        return False
    if (
        static_state is None
        or static_target is None
        or static_target != STATIC.release_target_for_state(static_state)
    ):
        fail("Parkventory static ownership is incomplete before handoff")
    STATIC.validate_persisted_release(static_state, releases)
    static_route = read_parkventory_public_edge_route()
    retained_route_path = PUBLIC_EDGE_RUNTIME_ROOT / "routes" / "parkventory.caddy"
    require_protected_file(
        retained_route_path,
        "Parkventory retained static edge route",
        allowed_modes=frozenset({0o444}),
        maximum_size=MAX_CONFIG_BYTES,
    )
    retained_route = STATIC.read_bounded_file(
        retained_route_path,
        MAX_CONFIG_BYTES,
        "Parkventory retained static edge route",
    )
    if static_route != retained_route:
        fail("Parkventory stable route does not match the retained static route")
    return True


def prepare_transaction(
    state: ApplicationState,
    *,
    allow_static_handoff: bool = False,
) -> tuple[bool, ApplicationState | None]:
    application = state.application
    app_root = APPLICATION_ROOT / application
    releases = app_root / "releases"
    recover_application(application)
    if (
        application == "parkventory"
        and static_parkventory_owner_present()
        and not allow_static_handoff
    ):
        fail("Parkventory static state still owns the public application identity")
    quarantined = read_state(
        QUARANTINE_ROOT,
        quarantine_name(state),
        "quarantined application state",
    )
    if quarantined is not None:
        if quarantined != state:
            fail("application quarantine fingerprint collision")
        fail("application candidate is quarantined after an earlier failure")
    active = read_state(
        ACTIVE_STATE_ROOT,
        f"{application}.json",
        "active application state",
    )
    target = current_target(app_root / "current", releases)
    if (
        application == "parkventory"
        and static_parkventory_owner_present()
        and not allow_static_handoff
    ):
        fail("Parkventory static state still owns the public application identity")
    if active is None and target is not None:
        fail("application current link exists without active state")
    if active is not None:
        validate_materialized_release(state_release(active), active)
        if target != release_target(active):
            fail("active application state does not match the current link")
        assert_source_revision_descends_from_active(
            PROFILES[application],
            active.source_revision,
            state.source_revision,
        )
    if active == state:
        return False, active
    return True, active


def restore_previous(transaction: ApplicationTransaction) -> None:
    if transaction.phase != "rollback":
        transaction = dataclasses.replace(transaction, phase="rollback")
        # Persist the one-way rollback decision before starting, stopping, or
        # switching any runtime. Recovery must never reinterpret a partially
        # restored tuple as permission to forward-commit the candidate.
        write_transaction(transaction)
    application = transaction.candidate.application
    app_root = APPLICATION_ROOT / application
    releases = app_root / "releases"
    if transaction.previous_state is None:
        remove_state(ACTIVE_STATE_ROOT, f"{application}.json", "active application state")
        switch_current(app_root / "current", None, releases)
        stop_runtime(transaction.candidate)
    else:
        validate_materialized_release(
            state_release(transaction.previous_state), transaction.previous_state
        )
        start_runtime(transaction.previous_state)
        write_state(
            ACTIVE_STATE_ROOT,
            f"{application}.json",
            transaction.previous_state,
            "active application state",
        )
        switch_current(
            app_root / "current", transaction.previous_target, releases
        )


def rollback_and_quarantine_candidate(
    transaction: ApplicationTransaction,
) -> None:
    application = transaction.candidate.application
    restore_previous(transaction)
    write_state(
        QUARANTINE_ROOT,
        quarantine_name(transaction.candidate),
        transaction.candidate,
        "quarantined application state",
    )
    remove_state(
        TRANSACTION_ROOT,
        f"{application}.json",
        "application transaction",
    )


def contain_parkventory_untrusted_database(
    transaction: ApplicationTransaction,
) -> None:
    if (
        transaction.candidate.application != "parkventory"
        or transaction.phase not in PARKVENTORY_UNTRUSTED_DATABASE_PHASES
    ):
        fail("Parkventory database containment received an invalid transaction")
    failures: list[str] = []
    for label, action in (
        ("runtime stop", lambda: stop_runtime(transaction.candidate)),
        (
            "migration container removal",
            lambda: remove_migration_container(transaction.candidate),
        ),
    ):
        try:
            action()
        except BaseException as exc:
            failures.append(f"{label}: {exc}")
    if failures:
        fail(
            "Parkventory database containment did not reach a safe state: "
            + "; ".join(failures)
        )


def application_tuple_is_active(transaction: ApplicationTransaction) -> bool:
    application = transaction.candidate.application
    app_root = APPLICATION_ROOT / application
    releases = app_root / "releases"
    active = read_state(
        ACTIVE_STATE_ROOT,
        f"{application}.json",
        "active application state",
    )
    target = current_target(app_root / "current", releases)
    return active == transaction.candidate and target == transaction.expected_target


def _recover_application_transaction(application: str) -> None:
    if application not in PROFILES:
        fail("application recovery target is outside the allowlist")
    transaction = read_transaction(application)
    if transaction is None:
        return
    untrusted_parkventory_database = (
        application == "parkventory"
        and transaction.phase in PARKVENTORY_UNTRUSTED_DATABASE_PHASES
    )
    if untrusted_parkventory_database:
        contain_parkventory_untrusted_database(transaction)
    elif transaction.phase != "prepared":
        remove_migration_container(transaction.candidate)
    else:
        require_migration_container_absent(transaction.candidate)
    app_root = APPLICATION_ROOT / application
    releases = app_root / "releases"
    active = read_state(
        ACTIVE_STATE_ROOT,
        f"{application}.json",
        "active application state",
    )
    target = current_target(app_root / "current", releases)
    if transaction.phase == "rollback":
        if (active, target) not in (
            (transaction.candidate, transaction.expected_target),
            (transaction.previous_state, transaction.expected_target),
            (transaction.previous_state, transaction.previous_target),
        ):
            fail("application rollback found an unreachable active tuple")
        restore_previous(transaction)
        write_state(
            QUARANTINE_ROOT,
            quarantine_name(transaction.candidate),
            transaction.candidate,
            "quarantined application state",
        )
        remove_state(
            TRANSACTION_ROOT,
            f"{application}.json",
            "application transaction",
        )
        return
    if application == "parkventory" and static_parkventory_owner_present():
        if (
            active is not None
            or target is not None
            or transaction.previous_state is not None
            or transaction.previous_target is not None
        ):
            fail("Parkventory static and Compose recovery ownership overlap")
        if transaction.phase != "prepared" and not untrusted_parkventory_database:
            restore_previous(transaction)
        if transaction.phase != "prepared":
            write_state(
                QUARANTINE_ROOT,
                quarantine_name(transaction.candidate),
                transaction.candidate,
                "quarantined application state",
            )
        remove_state(
            TRANSACTION_ROOT,
            f"{application}.json",
            "application transaction",
        )
        return
    if untrusted_parkventory_database:
        if (
            active != transaction.previous_state
            or target != transaction.previous_target
        ):
            fail(
                "untrusted Parkventory database transaction changed the active tuple"
            )
        write_state(
            QUARANTINE_ROOT,
            quarantine_name(transaction.candidate),
            transaction.candidate,
            "quarantined application state",
        )
        remove_state(
            TRANSACTION_ROOT,
            f"{application}.json",
            "application transaction",
        )
        return
    if transaction.phase == "probed" and not any(
        active == expected_active and target == expected_target
        for expected_active, expected_target in (
            (transaction.previous_state, transaction.previous_target),
            (transaction.previous_state, transaction.expected_target),
            (transaction.candidate, transaction.expected_target),
        )
    ):
        fail("probed application transaction found an unexpected active tuple")
    if active == transaction.candidate and target == transaction.expected_target:
        if transaction.phase != "probed":
            fail("unprobed application transaction already owns the active tuple")
        validate_materialized_release(
            state_release(transaction.candidate),
            transaction.candidate,
        )
        if application == "parkventory":
            try:
                revalidate_parkventory_backup_before_runtime()
            except BaseException:
                if parkventory_handoff_path_present():
                    raise
                rollback_and_quarantine_candidate(transaction)
                return
        start_runtime(transaction.candidate, precommit=True)
        promote_runtime_restart_policy(transaction.candidate)
        remove_state(
            TRANSACTION_ROOT,
            f"{application}.json",
            "application transaction",
        )
        return
    if transaction.phase == "probed":
        validate_materialized_release(
            state_release(transaction.candidate), transaction.candidate
        )
        if application == "parkventory":
            try:
                revalidate_parkventory_backup_before_runtime()
            except BaseException:
                if parkventory_handoff_path_present():
                    raise
                rollback_and_quarantine_candidate(transaction)
                return
        start_runtime(transaction.candidate, precommit=True)
        switch_current(app_root / "current", transaction.expected_target, releases)
        write_state(
            ACTIVE_STATE_ROOT,
            f"{application}.json",
            transaction.candidate,
            "active application state",
        )
        promote_runtime_restart_policy(transaction.candidate)
        remove_state(
            TRANSACTION_ROOT,
            f"{application}.json",
            "application transaction",
        )
        return
    if active is not None and active != transaction.previous_state:
        fail("interrupted application transaction found an unexpected active state")
    allowed_targets = {transaction.previous_target, transaction.expected_target}
    if target not in allowed_targets:
        fail("interrupted application transaction found an unexpected current link")
    if transaction.phase != "prepared":
        restore_previous(transaction)
        write_state(
            QUARANTINE_ROOT,
            quarantine_name(transaction.candidate),
            transaction.candidate,
            "quarantined application state",
        )
    else:
        switch_current(app_root / "current", transaction.previous_target, releases)
    remove_state(
        TRANSACTION_ROOT,
        f"{application}.json",
        "application transaction",
    )


def recover_application(application: str) -> None:
    if application != "parkventory":
        _recover_application_transaction(application)
        return

    recover_parkventory_handoff(preserve_forward_journal=True)
    try:
        _recover_application_transaction(application)
    except BaseException as transaction_error:
        if not parkventory_handoff_path_present():
            raise
        handoff = read_parkventory_handoff()
        if handoff is None:
            fail("Parkventory handoff journal disappeared during rollback")
        try:
            restore_parkventory_static_handoff(handoff)
            _recover_application_transaction(application)
        except BaseException as rollback_error:
            raise ApplicationDeploymentError(
                "Parkventory transaction recovery and static rollback both failed: "
                f"{transaction_error}; {rollback_error}"
            ) from rollback_error
        return
    if parkventory_handoff_path_present():
        recover_parkventory_handoff()


def commit_probed_candidate(transaction: ApplicationTransaction) -> None:
    if transaction.phase != "probed":
        fail("only a probed application transaction can be committed")
    application = transaction.candidate.application
    app_root = APPLICATION_ROOT / application
    releases = app_root / "releases"
    try:
        write_transaction(transaction)
        start_runtime(transaction.candidate, precommit=True)
        switch_current(app_root / "current", transaction.expected_target, releases)
        write_state(
            ACTIVE_STATE_ROOT,
            f"{application}.json",
            transaction.candidate,
            "active application state",
        )
        # Candidate containers run with restart=no until the durable active tuple
        # exists. Promote that policy in place, preserving the exact container
        # identities that passed the pre-commit health boundary.
        promote_runtime_restart_policy(transaction.candidate)
        remove_state(
            TRANSACTION_ROOT,
            f"{application}.json",
            "application transaction",
        )
    except BaseException as commit_error:
        try:
            recover_application(application)
            if application_tuple_is_active(transaction):
                return
        except BaseException as recovery_error:
            raise ApplicationDeploymentError(
                "application commit and forward recovery both failed: "
                f"{commit_error}; {recovery_error}"
            ) from recovery_error
        raise commit_error


def activate_candidate(
    state: ApplicationState,
    work: Path,
    *,
    static_handoff_required: bool | None = None,
) -> None:
    application = state.application
    if application == "parkventory" and static_handoff_required is None:
        static_handoff_required = parkventory_static_handoff_preflight()
    if application == "parkventory":
        validate_parkventory_secret_materializers()
    validate_materialized_runtime_policy(state)
    static_handoff_required = bool(static_handoff_required)
    proceed, previous = prepare_transaction(
        state,
        allow_static_handoff=static_handoff_required,
    )
    if not proceed:
        probe_runtime(state, work)
        print(
            f"application release already active and healthy: {state.application} "
            f"{state.release_reference}"
        )
        return
    app_root = APPLICATION_ROOT / application
    releases = app_root / "releases"
    transaction = ApplicationTransaction(
        candidate=state,
        previous_state=previous,
        previous_target=current_target(app_root / "current", releases),
        expected_target=release_target(state),
        phase="prepared",
    )
    write_transaction(transaction)
    try:
        pull_and_verify_images(state)
        if not static_handoff_required:
            validate_public_edge_cutover(state, work)
        if PROFILES[application].migration_strategy == "dedicated":
            transaction = dataclasses.replace(
                transaction,
                phase="migration-running",
            )
            write_transaction(transaction)
            run_migration(state)
            if application == "parkventory":
                transaction = dataclasses.replace(
                    transaction,
                    phase="postgres-unverified",
                )
                write_transaction(transaction)
                validate_parkventory_postgres_live(
                    reconcile_application_schema=True
                )
            transaction = dataclasses.replace(transaction, phase="migrated")
            write_transaction(transaction)
            if application == "parkventory":
                revalidate_parkventory_backup_before_runtime()
        start_runtime(state, precommit=True)
        transaction = dataclasses.replace(transaction, phase="started")
        write_transaction(transaction)
        if static_handoff_required:
            begin_parkventory_handoff(state, work)
        probe_runtime(state, work)
        assert_exact_source_head(PROFILES[application], state.source_revision)
        if application == "parkventory":
            revalidate_parkventory_backup_before_runtime()
    except BaseException as activation_error:
        try:
            current = read_transaction(application)
            if current is not None and current.phase == "started":
                write_transaction(dataclasses.replace(current, phase="probe-rejected"))
            recover_application(application)
        except BaseException as recovery_error:
            raise ApplicationDeploymentError(
                "application activation and immediate recovery both failed: "
                f"{activation_error}; {recovery_error}"
            ) from recovery_error
        raise
    commit_probed_candidate(dataclasses.replace(transaction, phase="probed"))
    if application == "parkventory":
        complete_parkventory_handoff(state)


def deployment_temporary_root(application: str, activate_live: bool) -> Path:
    configured = os.environ.get(RUNTIME_DIRECTORY_ENV)
    if not activate_live:
        if configured is not None:
            fail("application runtime directory is reserved for live activation")
        return Path("/var/tmp")
    expected = re.fullmatch(
        rf"/run/(vps-application-live-{re.escape(application)}-[0-9a-f]{{24}})",
        configured or "",
    )
    if expected is None:
        fail("live activation requires its exact transient runtime directory")
    root = Path(configured)
    require_protected_directory(root, "live application runtime directory")
    # The shared worker runtime remaps transient input files into each worker's
    # private directory. The complete candidate can therefore remain in the
    # root-only outer RuntimeDirectory instead of leaking into a global tmpfs.
    return root


def deploy(
    application: str,
    source_revision: str,
    release_reference: str,
    *,
    activate_live: bool,
) -> None:
    profile = PROFILES.get(application)
    if profile is None:
        fail("application is outside the Compose allowlist")
    if SHA40_RE.fullmatch(source_revision) is None:
        fail("source revision must be one full lowercase Git SHA")
    parse_digest_reference(
        release_reference,
        f"ghcr.io/nclsppr/{application}/application-release",
        "application release reference",
    )
    require_protected_file(
        APPLICATION_PRODUCTION_CONTRACT,
        "application production contract",
        allowed_modes=frozenset({0o444, 0o644}),
        maximum_size=64 * 1024,
    )
    require_protected_file(
        STATIC_PRODUCTION_CONTRACT,
        "static production contract",
        allowed_modes=frozenset({0o444, 0o644}),
        maximum_size=64 * 1024,
    )
    contract = load_production_contract(
        APPLICATION_PRODUCTION_CONTRACT,
        STATIC_PRODUCTION_CONTRACT,
    )
    policy = next(item for item in contract.applications if item.name == application)
    if not policy.enabled:
        fail("application is disabled by the protected production contract")
    validate_runtime()
    with deployment_lock():
        refuse_public_edge_base_transaction()
        static_handoff_required: bool | None = None
        if application == "parkventory":
            static_handoff_required = parkventory_static_handoff_preflight()
        validate_smtp_input_commit(application)
        cleanup_application_filesystem_residue(application)
        STATIC.refuse_isolated_worker_residue_locked()
        if application == "parkventory":
            validate_parkventory_readiness(policy)
        if activate_live:
            assert_exact_source_head(profile, source_revision)
        temporary_root = deployment_temporary_root(application, activate_live)
        with tempfile.TemporaryDirectory(
            prefix=f"vps-application-{application}-",
            dir=temporary_root,
        ) as temporary_name:
            temporary = Path(temporary_name)
            temporary.chmod(0o755)
            state, bundle, evidence = fetch_and_validate_candidate(
                policy,
                profile,
                source_revision,
                release_reference,
                temporary,
            )
            release = materialize_candidate(state, profile, bundle, evidence)
            if activate_live:
                activate_candidate(
                    state,
                    temporary,
                    static_handoff_required=static_handoff_required,
                )
                print(
                    f"application release activated after policy and probes: "
                    f"{application} {release_reference}"
                )
            else:
                print(
                    f"application release materialized without activation: "
                    f"{application} {release}"
                )


def recover_live(application: str | None) -> None:
    validate_recovery_state_runtime()
    applications = sorted(PROFILES) if application is None else [application]
    if any(item not in PROFILES for item in applications):
        fail("application recovery target is invalid")
    with deployment_lock():
        for item in applications:
            cleanup_application_filesystem_residue(item)
        has_public_edge_base_transaction = (
            public_edge_base_transaction_path_present()
        )
        has_transaction = any(
            read_transaction(item) is not None for item in applications
        )
        has_parkventory_handoff = (
            "parkventory" in applications and parkventory_handoff_path_present()
        )
        if (
            not has_public_edge_base_transaction
            and not has_transaction
            and not has_parkventory_handoff
        ):
            return
        validate_runtime()
        if has_public_edge_base_transaction:
            recover_public_edge_base_locked()
            STATIC.recover_live_deployments_locked()
        for item in applications:
            recover_application(item)


def control_public_edge_base(action: str, candidate_value: str) -> None:
    candidate = public_edge_base_release_from_value(
        candidate_value, "public edge base candidate"
    )
    validate_runtime()
    with deployment_lock():
        if action == "prepare":
            prepare_public_edge_base_locked(candidate)
            print(f"public edge base prepared for external probes: {candidate}")
            return
        transaction = read_public_edge_base_transaction()
        if transaction is None or transaction.candidate_release != str(candidate):
            fail("public edge base action differs from its durable transaction")
        if action == "commit":
            commit_public_edge_base_locked(candidate)
            print(f"public edge base committed after revalidation: {candidate}")
            return
        if action == "rollback":
            rollback_public_edge_base_locked(transaction)
            print(f"public edge base rollback complete: {candidate}")
            return
        fail("public edge base action is invalid")


def stop_public_edge_base() -> None:
    validate_runtime()
    with deployment_lock():
        stop_public_edge_base_locked()
    print("public edge base stopped under the shared deployment lock")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("--activate-live", action="store_true")
    parser.add_argument("application", choices=sorted(PROFILES))
    parser.add_argument("source_revision")
    parser.add_argument("release_reference")
    return parser


def main(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    try:
        if arguments and arguments[0] == "--source-head-worker":
            if len(arguments) != 3:
                fail("source-head worker argument count is invalid")
            run_source_head_worker(arguments[1], arguments[2])
            return 0
        if arguments and arguments[0] == "--source-ancestry-worker":
            if len(arguments) != 4:
                fail("source-ancestry worker argument count is invalid")
            run_source_ancestry_worker(arguments[1], arguments[2], arguments[3])
            return 0
        if arguments and arguments[0] == "--recover-live":
            if len(arguments) not in {1, 2}:
                fail("application recovery argument count is invalid")
            recover_live(None if len(arguments) == 1 else arguments[1])
            return 0
        if arguments and arguments[0] == "--stop-public-edge-base":
            if len(arguments) != 1:
                fail("public edge base stop argument count is invalid")
            stop_public_edge_base()
            return 0
        public_edge_base_modes = {
            "--prepare-public-edge-base": "prepare",
            "--commit-public-edge-base": "commit",
            "--rollback-public-edge-base": "rollback",
        }
        if arguments and arguments[0] in public_edge_base_modes:
            if len(arguments) != 2:
                fail("public edge base action argument count is invalid")
            control_public_edge_base(
                public_edge_base_modes[arguments[0]], arguments[1]
            )
            return 0
        parsed = build_parser().parse_args(arguments)
        deploy(
            parsed.application,
            parsed.source_revision,
            parsed.release_reference,
            activate_live=parsed.activate_live,
        )
    except (
        OSError,
        KeyError,
        ApplicationBundleError,
        ApplicationDeploymentError,
        ApplicationReleaseError,
        STATIC.StaticDeploymentError,
    ) as exc:
        print(f"application deployment refused: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
