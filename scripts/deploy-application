CONTAINER_ID_RE = re.compile(r"^[0-9a-f]{64}$")
CONFIG_KEY_RE = re.compile(r"^[A-Z][A-Z0-9_]{0,127}$")
CONFIG_VALUE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,511}$")

