def observe(container: str) -> dict[str, object]:
    raw = psql(container, "parkventory", proof_sql())
    try:
        proof = json.loads(raw, object_pairs_hook=unique_object)
    except json.JSONDecodeError as exc:
        raise ProvisionError("PostgreSQL returned invalid readiness JSON") from exc
    if proof != EXPECTED_PROOF:
        raise ProvisionError("effective database roles or default privileges differ from the contract")
    return proof


def evidence_document(
    contract_digest: str,
    image: str,
    proof: dict[str, object],
    credential_digests: dict[str, str],
) -> bytes:
    return canonical_json(
        {
            "contract": "vps-infra.parkventory-postgres-readiness.v1",
            "database_contract_sha256": contract_digest,
            "postgres_image": image,
            "proof": proof,
            "secret_files": {
                "migrator": {
                    "path": str(CREDENTIAL_ROOT / "parkventory-postgres-migrator-password"),
                    "sha256": credential_digests["migrator"],
                    "uid": 0,
                    "gid": 10001,
                    "mode": "0440",
                },
                "runtime": {
                    "path": str(CREDENTIAL_ROOT / "parkventory-postgres-runtime-password"),
                    "sha256": credential_digests["runtime"],
                    "uid": 0,
                    "gid": 10001,
                    "mode": "0440",
                },
            },
            "transport": {
                "network": "db_parkventory",
                "subnet": "172.30.21.0/24",
                "internal": True,
                "postgres_attached": True,
                "published_postgres_port": False,
                "tls": False,
            },
            "validity": {
                "requires_live_check": True,
                "requires_postgres_network_attachment": True,
            },
        }
    )


def require_evidence(expected: bytes) -> None:
    try:
        descriptor = os.open(EVIDENCE_PATH, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as exc:
        raise ProvisionError("PostgreSQL readiness evidence is missing or unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != 0
            or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o400
            or metadata.st_size != len(expected)
        ):
            raise ProvisionError("PostgreSQL readiness evidence has unsafe metadata")
        if os.read(descriptor, MAX_FILE_BYTES + 1) != expected:
            raise ProvisionError("PostgreSQL readiness evidence is stale")
    finally:
        os.close(descriptor)


def require_safe_evidence_target() -> None:
    try:
        metadata = EVIDENCE_PATH.lstat()
    except FileNotFoundError:
        return
    except OSError as exc:
        raise ProvisionError("cannot inspect PostgreSQL readiness evidence") from exc
    if (
        not stat.S_ISREG(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_nlink != 1
        or metadata.st_uid != 0
        or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o400
        or not 1 <= metadata.st_size <= MAX_FILE_BYTES
    ):
        raise ProvisionError("PostgreSQL readiness evidence target is unsafe")


def write_evidence(content: bytes) -> None:
    for path in (Path("/var/lib/vps-readiness"), EVIDENCE_PATH.parent):
        try:
            path.mkdir(mode=0o700)
        except FileExistsError:
            pass
        metadata = path.lstat()
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o700
        ):
            raise ProvisionError(f"readiness directory {path} is unsafe")
    require_safe_evidence_target()
    temporary = EVIDENCE_PATH.parent / f".postgres.{secrets.token_hex(16)}.pending"
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o400,
    )
    try:
        os.fchown(descriptor, 0, 0)
        os.fchmod(descriptor, 0o400)
        written = 0
        while written < len(content):
            written += os.write(descriptor, content[written:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    try:
        os.replace(temporary, EVIDENCE_PATH)
        directory = os.open(EVIDENCE_PATH.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--apply", dest="mode", action="store_const", const="apply")
    modes.add_argument("--check", dest="mode", action="store_const", const="check")
    modes.add_argument("--dry-run", dest="mode", action="store_const", const="dry-run")
    parser.set_defaults(mode="check")
    parser.add_argument("--validate-contract", action="store_true")
    parser.add_argument("--contract", type=Path, default=CONTRACT_PATH)
    return parser.parse_args()


def main() -> int:
    arguments = parse_args()
    try:
        contract, contract_digest = load_contract(arguments.contract)
        if arguments.validate_contract:
            print(f"Parkventory PostgreSQL contract valid: {arguments.contract}")
            return 0
        if os.geteuid() != 0 or arguments.contract != CONTRACT_PATH:
            raise ProvisionError("live PostgreSQL verification requires root and the fixed contract")
        container, image = resolve_postgres(
            contract, require_network=arguments.mode in {"apply", "check"}
        )
        if arguments.mode == "dry-run":
            print(canonical_json({"changed": True, "mode": "dry-run", "ready": False}).decode(), end="")
            return 0
        migrator, migrator_digest = read_password(
            CREDENTIAL_ROOT / "parkventory-postgres-migrator-password"
        )
        runtime, runtime_digest = read_password(
            CREDENTIAL_ROOT / "parkventory-postgres-runtime-password"
        )
        if migrator == runtime:
            raise ProvisionError("migrator and runtime passwords must be distinct")
        credential_digests = {
            "migrator": migrator_digest,
            "runtime": runtime_digest,
        }
        changed = False
        if arguments.mode == "apply":
            require_safe_evidence_target()
            try:
                proof = observe(container)
                evidence = evidence_document(
                    contract_digest, image, proof, credential_digests
                )
                require_evidence(evidence)
            except ProvisionError:
                apply_database(container, migrator, runtime)
                proof = observe(container)
                evidence = evidence_document(
                    contract_digest, image, proof, credential_digests
                )
                write_evidence(evidence)
                changed = True
        else:
            proof = observe(container)
            evidence = evidence_document(
                contract_digest, image, proof, credential_digests
            )
            require_evidence(evidence)
    except ProvisionError as exc:
        return fail(str(exc))
    print(
        canonical_json(
            {"changed": changed, "mode": arguments.mode, "ready": True}
        ).decode(),
        end="",
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
