POSTGRES_IMAGE_RE = re.compile(
    r"^ghcr\.io/nclsppr/vps-infra/postgres:[A-Za-z0-9_.-]+@sha256:[0-9a-f]{64}$"
)
MAX_FILE_BYTES = 64 * 1024


def rls_policy(
    table: str,
    name: str,
    command: str,
    using: str | None,
    with_check: str | None,
) -> dict[str, object]:
    return {
        "table": table,
        "name": name,
        "command": command,
        "permissive": True,
        "roles": ["PUBLIC"],
        "using": using,
        "with_check": with_check,
    }


