class ProvisionError(RuntimeError):
    """The live database boundary differs from the reviewed contract."""


def fail(message: str) -> int:
    print(f"Parkventory PostgreSQL provisioning refused: {message}", file=sys.stderr)
    return EX_CONFIG


def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ProvisionError(f"JSON contains duplicate key {key!r}")
        result[key] = value
    return result


def canonical_json(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode(
        "utf-8"
    )


def load_contract(path: Path) -> tuple[dict[str, object], str]:
    try:
        raw = path.read_bytes()
    except OSError as exc:
        raise ProvisionError(f"cannot read PostgreSQL contract {path}: {exc}") from exc
    if not 1 <= len(raw) <= MAX_FILE_BYTES:
        raise ProvisionError("PostgreSQL contract size is outside the limit")
    try:
        value = json.loads(
            raw.decode("utf-8", errors="strict"),
            object_pairs_hook=unique_object,
            parse_constant=lambda item: (_ for _ in ()).throw(
                ProvisionError(f"JSON constant {item!r} is forbidden")
            ),
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ProvisionError("PostgreSQL contract is not strict UTF-8 JSON") from exc
    if value != EXPECTED_CONTRACT:
        raise ProvisionError("PostgreSQL contract differs from the reviewed 17.10 boundary")
    return value, f"sha256:{hashlib.sha256(raw).hexdigest()}"


def command(
    arguments: list[str],
    *,
    input_text: str | None = None,
    environment: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    command_environment = {"PATH": "/usr/bin:/bin", "LC_ALL": "C.UTF-8"}
    if environment is not None:
        command_environment.update(environment)
    try:
        return subprocess.run(
            arguments,
            input=input_text,
            check=False,
            capture_output=True,
            text=True,
            env=command_environment,
            timeout=60,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise ProvisionError(f"cannot execute bounded command {arguments[0]}") from exc


def docker_json(arguments: list[str], label: str) -> Any:
    result = command(["/usr/bin/docker", *arguments])
    if result.returncode != 0:
        raise ProvisionError(f"cannot inspect {label}")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise ProvisionError(f"Docker returned invalid JSON for {label}") from exc


def resolve_postgres(contract: dict[str, object], *, require_network: bool) -> tuple[str, str]:
    postgres = contract["postgres"]
    network = contract["network"]
    assert isinstance(postgres, dict) and isinstance(network, dict)
    result = command(
        [
            "/usr/bin/docker",
            "ps",
            "--quiet",
            "--filter",
            f"label=com.docker.compose.project={postgres['project']}",
            "--filter",
            f"label=com.docker.compose.service={postgres['service']}",
        ]
    )
    containers = [line for line in result.stdout.splitlines() if line]
    if result.returncode != 0 or len(containers) != 1:
        raise ProvisionError("expected exactly one running shared PostgreSQL container")
    container = containers[0]
    inspected = docker_json(["inspect", container], "shared PostgreSQL")
    if not isinstance(inspected, list) or len(inspected) != 1:
        raise ProvisionError("shared PostgreSQL inspection is incomplete")
    state = inspected[0]
    labels = state.get("Config", {}).get("Labels", {})
    networks = state.get("NetworkSettings", {}).get("Networks", {})
    ports = state.get("NetworkSettings", {}).get("Ports", {})
    image = state.get("Config", {}).get("Image")
    parkventory_network = (
        networks.get(network["name"], {}) if isinstance(networks, dict) else {}
    )
    if (
        labels.get("com.docker.compose.project") != postgres["project"]
        or labels.get("com.docker.compose.service") != postgres["service"]
        or state.get("State", {}).get("Health", {}).get("Status") != "healthy"
        or not isinstance(image, str)
        or POSTGRES_IMAGE_RE.fullmatch(image) is None
        or image != postgres["image"]
        or not isinstance(ports, dict)
        or any(
            bindings is not None and bindings != [] for bindings in ports.values()
        )
        or (
            require_network
            and (
                not isinstance(parkventory_network, dict)
                or "postgresql" not in parkventory_network.get("Aliases", [])
            )
        )
    ):
        raise ProvisionError("shared PostgreSQL differs from the healthy immutable boundary")
    network_state = docker_json(["network", "inspect", str(network["name"])], "database network")
    if not isinstance(network_state, list) or len(network_state) != 1:
        raise ProvisionError("database network inspection is incomplete")
    candidate = network_state[0]
    subnets = [item.get("Subnet") for item in candidate.get("IPAM", {}).get("Config", [])]
    if (
        candidate.get("Name") != network["name"]
        or candidate.get("Driver") != "bridge"
        or candidate.get("Internal") is not True
        or subnets != [network["subnet"]]
        or candidate.get("Labels", {}).get("com.nclsppr.vps-infra.managed") != "true"
    ):
        raise ProvisionError("db_parkventory differs from the managed private network")
    return container, image


def read_password(path: Path) -> tuple[str, str]:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as exc:
        raise ProvisionError(f"cannot open protected password {path.name}") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != 0
            or metadata.st_gid != 10001
            or stat.S_IMODE(metadata.st_mode) != 0o440
        ):
            raise ProvisionError(f"password {path.name} has unsafe metadata")
        content = os.read(descriptor, 130)
        if CREDENTIAL_RE.fullmatch(content) is None:
            raise ProvisionError(f"password {path.name} has an invalid format")
        return content[:-1].decode("ascii"), f"sha256:{hashlib.sha256(content).hexdigest()}"
    finally:
        os.close(descriptor)


def sql_literal(value: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9_-]{64}", value) is None:
        raise ProvisionError("a password left the validated character set")
    return "'" + value + "'"


def psql(container: str, database: str, sql: str) -> str:
    result = command(
        [
            "/usr/bin/docker",
            "exec",
            "--interactive",
            container,
            "psql",
            "--no-password",
            "--username",
            "platform_admin",
            "--dbname",
            database,
            "--set",
            "ON_ERROR_STOP=1",
            "--no-psqlrc",
            "--tuples-only",
            "--no-align",
            "--quiet",
        ],
        input_text=sql,
    )
    if result.returncode != 0:
        raise ProvisionError("PostgreSQL rejected the bounded operation")
    return result.stdout.strip()


def credential_probe(
    container: str,
    role: str,
    role_auth: str,
) -> subprocess.CompletedProcess[str]:
    if role not in {"parkventory_migrator", "parkventory_runtime"}:
        raise ProvisionError("credential verification role is outside the allowlist")
    if re.fullmatch(r"[A-Za-z0-9_-]{64}", role_auth) is None:
        raise ProvisionError("credential verification password is invalid")
    return command(
        [
            "/usr/bin/docker",
            "exec",
            "--env",
            "PGPASSWORD",
            "--env",
            "PGCONNECT_TIMEOUT=5",
            container,
            "psql",
            "--no-password",
            "--host",
            "postgresql",
            "--username",
            role,
            "--dbname",
            "parkventory",
            "--set",
            "ON_ERROR_STOP=1",
            "--no-psqlrc",
            "--tuples-only",
            "--no-align",
            "--quiet",
            "--command",
            "SELECT concat_ws('|', session_user, current_user, current_database());",
        ],
        environment={"PGPASSWORD": role_auth},
    )


def verify_database_credentials(
    container: str,
    migrator_auth: str,
    runtime_auth: str,
) -> None:
    expected_identities = (
        (
            "parkventory_migrator",
            migrator_auth,
            "parkventory_migrator|parkventory_owner|parkventory\n",
        ),
        (
            "parkventory_runtime",
            runtime_auth,
            "parkventory_runtime|parkventory_runtime|parkventory\n",
        ),
    )
    for role, role_auth, expected_identity in expected_identities:
        accepted = credential_probe(container, role, role_auth)
        if (
            accepted.returncode != 0
            or accepted.stdout != expected_identity
            or accepted.stderr
        ):
            raise ProvisionError(
                f"PostgreSQL rejected the protected {role} credential"
            )
        replacement = "A" if role_auth[0] != "A" else "B"
        rejected = credential_probe(container, role, replacement + role_auth[1:])
        if rejected.returncode == 0:
            raise ProvisionError(
                f"PostgreSQL network authentication does not enforce the {role} credential"
            )


def apply_database(container: str, migrator_password: str, runtime_password: str) -> None:
    cluster_sql = f"""
BEGIN;
DO $provision$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'parkventory_owner') THEN
    CREATE ROLE parkventory_owner NOLOGIN;
  END IF;
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'parkventory_migrator') THEN
    CREATE ROLE parkventory_migrator LOGIN;
  END IF;
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'parkventory_runtime') THEN
    CREATE ROLE parkventory_runtime LOGIN;
  END IF;
END
$provision$;
ALTER ROLE parkventory_owner NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS CONNECTION LIMIT -1 PASSWORD NULL;
ALTER ROLE parkventory_migrator LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS CONNECTION LIMIT 4 PASSWORD {sql_literal(migrator_password)} VALID UNTIL 'infinity';
ALTER ROLE parkventory_runtime LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS CONNECTION LIMIT 20 PASSWORD {sql_literal(runtime_password)} VALID UNTIL 'infinity';
DO $memberships$
DECLARE
  edge record;
BEGIN
  FOR edge IN
    SELECT parent.rolname AS parent_name, member.rolname AS member_name
    FROM pg_auth_members membership
    JOIN pg_roles parent ON parent.oid = membership.roleid
    JOIN pg_roles member ON member.oid = membership.member
    WHERE (
      parent.rolname IN ('parkventory_owner', 'parkventory_migrator', 'parkventory_runtime')
      OR member.rolname IN ('parkventory_owner', 'parkventory_migrator', 'parkventory_runtime')
    )
      AND NOT (
        parent.rolname = 'parkventory_owner'
        AND member.rolname = 'parkventory_migrator'
      )
  LOOP
    EXECUTE format('REVOKE %I FROM %I', edge.parent_name, edge.member_name);
  END LOOP;
END
$memberships$;
GRANT parkventory_owner TO parkventory_migrator
  WITH ADMIN FALSE, INHERIT FALSE, SET TRUE;
COMMIT;
SELECT 'CREATE DATABASE parkventory OWNER parkventory_owner TEMPLATE template0 ENCODING ''UTF8'''
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'parkventory')\\gexec
REVOKE ALL PRIVILEGES ON DATABASE parkventory FROM PUBLIC;
REVOKE ALL PRIVILEGES ON DATABASE parkventory FROM parkventory_migrator, parkventory_runtime;
DO $database_acl$
DECLARE
  unexpected_role text;
BEGIN
  FOR unexpected_role IN
    SELECT DISTINCT role.rolname
    FROM pg_database database
    CROSS JOIN LATERAL aclexplode(database.datacl) acl
    JOIN pg_roles role ON role.oid = acl.grantee
    WHERE database.datname = 'parkventory'
      AND role.rolname NOT IN (
        'parkventory_owner', 'parkventory_migrator', 'parkventory_runtime'
      )
  LOOP
    EXECUTE format(
      'REVOKE ALL PRIVILEGES ON DATABASE parkventory FROM %I',
      unexpected_role
    );
  END LOOP;
END
$database_acl$;
GRANT CONNECT ON DATABASE parkventory TO parkventory_migrator, parkventory_runtime;
ALTER DATABASE parkventory OWNER TO parkventory_owner;
ALTER ROLE parkventory_owner RESET ALL;
ALTER ROLE parkventory_migrator RESET ALL;
ALTER ROLE parkventory_runtime RESET ALL;
ALTER DATABASE parkventory RESET ALL;
ALTER ROLE parkventory_owner IN DATABASE parkventory RESET ALL;
ALTER ROLE parkventory_migrator IN DATABASE parkventory RESET ALL;
ALTER ROLE parkventory_runtime IN DATABASE parkventory RESET ALL;
ALTER ROLE parkventory_migrator IN DATABASE parkventory SET ROLE TO parkventory_owner;
ALTER ROLE parkventory_migrator IN DATABASE parkventory SET search_path TO public;
ALTER ROLE parkventory_runtime IN DATABASE parkventory SET search_path TO public;
"""
    psql(container, "postgres", cluster_sql)
    database_sql = """
BEGIN;
ALTER SCHEMA public OWNER TO parkventory_owner;
REVOKE ALL ON SCHEMA public FROM PUBLIC;
REVOKE ALL ON SCHEMA public FROM parkventory_migrator, parkventory_runtime;
DO $object_acl$
DECLARE
  candidate record;
  column_acl record;
  role_name text;
BEGIN
  FOR role_name IN
    SELECT rolname
    FROM pg_roles
    WHERE rolname NOT IN ('parkventory_owner', 'parkventory_runtime')
  LOOP
    EXECUTE format('REVOKE ALL ON SCHEMA public FROM %I', role_name);
    EXECUTE format(
      'REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM %I',
      role_name
    );
    EXECUTE format(
      'REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM %I',
      role_name
    );
    EXECUTE format(
      'REVOKE ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA public FROM %I',
      role_name
    );
  END LOOP;
  FOR candidate IN
    SELECT namespace.nspname, type.typname
    FROM pg_type type
    JOIN pg_namespace namespace ON namespace.oid = type.typnamespace
    LEFT JOIN pg_depend extension_dependency
      ON extension_dependency.classid = 'pg_type'::regclass
     AND extension_dependency.objid = type.oid
     AND extension_dependency.objsubid = 0
     AND extension_dependency.refclassid = 'pg_extension'::regclass
     AND extension_dependency.deptype = 'e'
    WHERE namespace.nspname = 'public'
      AND type.typisdefined
      AND type.typelem = 0
      AND (
        type.typtype <> 'c'
        OR EXISTS (
          SELECT 1 FROM pg_class composite
          WHERE composite.oid = type.typrelid AND composite.relkind = 'c'
        )
      )
  LOOP
    EXECUTE format(
      'REVOKE ALL PRIVILEGES ON TYPE %I.%I FROM PUBLIC',
      candidate.nspname,
      candidate.typname
    );
    FOR role_name IN
      SELECT rolname
      FROM pg_roles
      WHERE rolname NOT IN ('parkventory_owner', 'parkventory_runtime')
    LOOP
      EXECUTE format(
        'REVOKE ALL PRIVILEGES ON TYPE %I.%I FROM %I',
        candidate.nspname,
        candidate.typname,
        role_name
      );
    END LOOP;
    EXECUTE format(
      'REVOKE ALL PRIVILEGES ON TYPE %I.%I FROM parkventory_runtime',
      candidate.nspname,
      candidate.typname
    );
  END LOOP;
  FOR column_acl IN
    SELECT DISTINCT
      namespace.nspname,
      relation.relname,
      attribute.attname,
      acl.grantee,
      grantee.rolname AS grantee_name
    FROM pg_attribute attribute
    JOIN pg_class relation ON relation.oid = attribute.attrelid
    JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
    CROSS JOIN LATERAL aclexplode(attribute.attacl) acl
    LEFT JOIN pg_roles grantee ON grantee.oid = acl.grantee
    WHERE namespace.nspname = 'public'
      AND relation.relkind IN ('r', 'p', 'v', 'm', 'f')
      AND attribute.attnum > 0
      AND NOT attribute.attisdropped
  LOOP
    IF column_acl.grantee = 0 THEN
      EXECUTE format(
        'REVOKE ALL PRIVILEGES (%I) ON TABLE %I.%I FROM PUBLIC',
        column_acl.attname,
        column_acl.nspname,
        column_acl.relname
      );
    ELSE
      EXECUTE format(
        'REVOKE ALL PRIVILEGES (%I) ON TABLE %I.%I FROM %I',
        column_acl.attname,
        column_acl.nspname,
        column_acl.relname,
        column_acl.grantee_name
      );
    END IF;
  END LOOP;
END
$object_acl$;
REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM PUBLIC, parkventory_runtime;
REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM PUBLIC, parkventory_runtime;
REVOKE ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA public FROM PUBLIC, parkventory_runtime;
GRANT USAGE ON SCHEMA public TO parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner REVOKE ALL ON TABLES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner REVOKE ALL ON SEQUENCES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner REVOKE ALL ON FUNCTIONS FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner REVOKE ALL ON TYPES FROM PUBLIC;
DO $global_default_acl$
DECLARE
  role_name text;
BEGIN
  FOR role_name IN
    SELECT rolname
    FROM pg_roles
    WHERE rolname != 'parkventory_owner'
  LOOP
    EXECUTE format(
      'ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner REVOKE ALL ON TABLES FROM %I',
      role_name
    );
    EXECUTE format(
      'ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner REVOKE ALL ON SEQUENCES FROM %I',
      role_name
    );
    EXECUTE format(
      'ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner REVOKE ALL ON FUNCTIONS FROM %I',
      role_name
    );
    EXECUTE format(
      'ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner REVOKE ALL ON TYPES FROM %I',
      role_name
    );
  END LOOP;
END
$global_default_acl$;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON TABLES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON TABLES FROM parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON SEQUENCES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON SEQUENCES FROM parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON FUNCTIONS FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON FUNCTIONS FROM parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON TYPES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON TYPES FROM parkventory_runtime;
DO $default_acl$
DECLARE
  role_name text;
BEGIN
  FOR role_name IN
    SELECT rolname
    FROM pg_roles
    WHERE rolname NOT IN ('parkventory_owner', 'parkventory_runtime')
  LOOP
    EXECUTE format(
      'ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON TABLES FROM %I',
      role_name
    );
    EXECUTE format(
      'ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON SEQUENCES FROM %I',
      role_name
    );
    EXECUTE format(
      'ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON FUNCTIONS FROM %I',
      role_name
    );
    EXECUTE format(
      'ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public REVOKE ALL ON TYPES FROM %I',
      role_name
    );
  END LOOP;
END
$default_acl$;
COMMIT;
"""
    psql(container, "parkventory", database_sql)


def proof_sql() -> str:
    privilege_array = """
      SELECT COALESCE(json_agg(privilege_type ORDER BY privilege_type), '[]'::json)
      FROM pg_default_acl d
      CROSS JOIN LATERAL aclexplode(d.defaclacl) a
      WHERE d.defaclrole = (SELECT oid FROM pg_roles WHERE rolname = 'parkventory_owner')
        AND d.defaclnamespace = (SELECT oid FROM pg_namespace WHERE nspname = 'public')
        AND d.defaclobjtype = {object_type}
        AND a.grantee = (SELECT oid FROM pg_roles WHERE rolname = 'parkventory_runtime')
    """
    fields = (
            "'server_version_num', current_setting('server_version_num')::integer",
            "'owner_can_login', (SELECT rolcanlogin FROM pg_roles WHERE rolname='parkventory_owner')",
            "'owner_inherits', (SELECT rolinherit FROM pg_roles WHERE rolname='parkventory_owner')",
            "'owner_is_superuser', (SELECT rolsuper FROM pg_roles WHERE rolname='parkventory_owner')",
            "'owner_can_create_database', (SELECT rolcreatedb FROM pg_roles WHERE rolname='parkventory_owner')",
            "'owner_can_create_role', (SELECT rolcreaterole FROM pg_roles WHERE rolname='parkventory_owner')",
            "'owner_can_replicate', (SELECT rolreplication FROM pg_roles WHERE rolname='parkventory_owner')",
            "'owner_bypasses_rls', (SELECT rolbypassrls FROM pg_roles WHERE rolname='parkventory_owner')",
            "'owner_connection_limit', (SELECT rolconnlimit FROM pg_roles WHERE rolname='parkventory_owner')",
            "'owner_memberships', (SELECT COALESCE(json_agg(json_build_object('role',parent.rolname,'admin_option',membership.admin_option,'inherit_option',membership.inherit_option,'set_option',membership.set_option) ORDER BY parent.rolname),'[]'::json) FROM pg_auth_members membership JOIN pg_roles member ON membership.member=member.oid JOIN pg_roles parent ON membership.roleid=parent.oid WHERE member.rolname='parkventory_owner')",
            "'owner_members', (SELECT COALESCE(json_agg(json_build_object('member',member.rolname,'admin_option',membership.admin_option,'inherit_option',membership.inherit_option,'set_option',membership.set_option) ORDER BY member.rolname),'[]'::json) FROM pg_auth_members membership JOIN pg_roles member ON membership.member=member.oid JOIN pg_roles parent ON membership.roleid=parent.oid WHERE parent.rolname='parkventory_owner')",
            "'migrator_can_login', (SELECT rolcanlogin FROM pg_roles WHERE rolname='parkventory_migrator')",
            "'migrator_inherits', (SELECT rolinherit FROM pg_roles WHERE rolname='parkventory_migrator')",
            "'migrator_is_superuser', (SELECT rolsuper FROM pg_roles WHERE rolname='parkventory_migrator')",
            "'migrator_can_create_database', (SELECT rolcreatedb FROM pg_roles WHERE rolname='parkventory_migrator')",
            "'migrator_can_create_role', (SELECT rolcreaterole FROM pg_roles WHERE rolname='parkventory_migrator')",
            "'migrator_can_replicate', (SELECT rolreplication FROM pg_roles WHERE rolname='parkventory_migrator')",
            "'migrator_bypasses_rls', (SELECT rolbypassrls FROM pg_roles WHERE rolname='parkventory_migrator')",
            "'migrator_connection_limit', (SELECT rolconnlimit FROM pg_roles WHERE rolname='parkventory_migrator')",
            "'migrator_memberships', (SELECT COALESCE(json_agg(json_build_object('role',parent.rolname,'admin_option',membership.admin_option,'inherit_option',membership.inherit_option,'set_option',membership.set_option) ORDER BY parent.rolname),'[]'::json) FROM pg_auth_members membership JOIN pg_roles member ON membership.member=member.oid JOIN pg_roles parent ON membership.roleid=parent.oid WHERE member.rolname='parkventory_migrator')",
            "'migrator_members', (SELECT COALESCE(json_agg(json_build_object('member',member.rolname,'admin_option',membership.admin_option,'inherit_option',membership.inherit_option,'set_option',membership.set_option) ORDER BY member.rolname),'[]'::json) FROM pg_auth_members membership JOIN pg_roles member ON membership.member=member.oid JOIN pg_roles parent ON membership.roleid=parent.oid WHERE parent.rolname='parkventory_migrator')",
            "'runtime_can_login', (SELECT rolcanlogin FROM pg_roles WHERE rolname='parkventory_runtime')",
            "'runtime_inherits', (SELECT rolinherit FROM pg_roles WHERE rolname='parkventory_runtime')",
            "'runtime_is_superuser', (SELECT rolsuper FROM pg_roles WHERE rolname='parkventory_runtime')",
            "'runtime_can_create_database', (SELECT rolcreatedb FROM pg_roles WHERE rolname='parkventory_runtime')",
            "'runtime_can_create_role', (SELECT rolcreaterole FROM pg_roles WHERE rolname='parkventory_runtime')",
            "'runtime_can_replicate', (SELECT rolreplication FROM pg_roles WHERE rolname='parkventory_runtime')",
            "'runtime_bypasses_rls', (SELECT rolbypassrls FROM pg_roles WHERE rolname='parkventory_runtime')",
            "'runtime_connection_limit', (SELECT rolconnlimit FROM pg_roles WHERE rolname='parkventory_runtime')",
            "'runtime_memberships', (SELECT COALESCE(json_agg(json_build_object('role',parent.rolname,'admin_option',membership.admin_option,'inherit_option',membership.inherit_option,'set_option',membership.set_option) ORDER BY parent.rolname),'[]'::json) FROM pg_auth_members membership JOIN pg_roles member ON membership.member=member.oid JOIN pg_roles parent ON membership.roleid=parent.oid WHERE member.rolname='parkventory_runtime')",
            "'runtime_members', (SELECT COALESCE(json_agg(json_build_object('member',member.rolname,'admin_option',membership.admin_option,'inherit_option',membership.inherit_option,'set_option',membership.set_option) ORDER BY member.rolname),'[]'::json) FROM pg_auth_members membership JOIN pg_roles member ON membership.member=member.oid JOIN pg_roles parent ON membership.roleid=parent.oid WHERE parent.rolname='parkventory_runtime')",
            "'database_owner', (SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname='parkventory')",
            "'database_encoding', (SELECT pg_encoding_to_char(encoding) FROM pg_database WHERE datname='parkventory')",
            "'public_can_connect', EXISTS (SELECT 1 FROM pg_database d CROSS JOIN LATERAL aclexplode(COALESCE(d.datacl,acldefault('d',d.datdba))) a WHERE d.datname='parkventory' AND a.grantee=0 AND a.privilege_type='CONNECT')",
            "'public_can_temp', EXISTS (SELECT 1 FROM pg_database d CROSS JOIN LATERAL aclexplode(COALESCE(d.datacl,acldefault('d',d.datdba))) a WHERE d.datname='parkventory' AND a.grantee=0 AND a.privilege_type='TEMPORARY')",
            "'public_can_create_database_objects', EXISTS (SELECT 1 FROM pg_database d CROSS JOIN LATERAL aclexplode(COALESCE(d.datacl,acldefault('d',d.datdba))) a WHERE d.datname='parkventory' AND a.grantee=0 AND a.privilege_type='CREATE')",
            "'migrator_can_connect', has_database_privilege('parkventory_migrator','parkventory','CONNECT')",
            "'migrator_can_create_database_objects', has_database_privilege('parkventory_migrator','parkventory','CREATE')",
            "'migrator_can_temp', has_database_privilege('parkventory_migrator','parkventory','TEMPORARY')",
            "'runtime_can_connect', has_database_privilege('parkventory_runtime','parkventory','CONNECT')",
            "'runtime_can_create_database_objects', has_database_privilege('parkventory_runtime','parkventory','CREATE')",
            "'runtime_can_temp', has_database_privilege('parkventory_runtime','parkventory','TEMPORARY')",
            "'unexpected_database_grantee', EXISTS (SELECT 1 FROM pg_database d CROSS JOIN LATERAL aclexplode(COALESCE(d.datacl,acldefault('d',d.datdba))) a WHERE d.datname='parkventory' AND a.grantee NOT IN ((SELECT oid FROM pg_roles WHERE rolname='parkventory_owner'),(SELECT oid FROM pg_roles WHERE rolname='parkventory_migrator'),(SELECT oid FROM pg_roles WHERE rolname='parkventory_runtime')))",
            "'schema_owner', (SELECT pg_get_userbyid(nspowner) FROM pg_namespace WHERE nspname='public')",
            "'public_can_use_schema', EXISTS (SELECT 1 FROM pg_namespace n CROSS JOIN LATERAL aclexplode(COALESCE(n.nspacl,acldefault('n',n.nspowner))) a WHERE n.nspname='public' AND a.grantee=0 AND a.privilege_type='USAGE')",
            "'public_can_create_schema', EXISTS (SELECT 1 FROM pg_namespace n CROSS JOIN LATERAL aclexplode(COALESCE(n.nspacl,acldefault('n',n.nspowner))) a WHERE n.nspname='public' AND a.grantee=0 AND a.privilege_type='CREATE')",
            "'runtime_can_use_schema', has_schema_privilege('parkventory_runtime','public','USAGE')",
            "'runtime_can_create_schema', has_schema_privilege('parkventory_runtime','public','CREATE')",
            "'unexpected_schema_grantee', EXISTS (SELECT 1 FROM pg_namespace n CROSS JOIN LATERAL aclexplode(COALESCE(n.nspacl,acldefault('n',n.nspowner))) a WHERE n.nspname='public' AND a.grantee NOT IN ((SELECT oid FROM pg_roles WHERE rolname='parkventory_owner'),(SELECT oid FROM pg_roles WHERE rolname='parkventory_runtime')))",
            "'unexpected_application_schema', EXISTS (SELECT 1 FROM pg_namespace n WHERE n.nspname<>'public' AND n.nspname<>'information_schema' AND left(n.nspname,3)<>'pg_')",
            "'migrator_is_owner_member', pg_has_role('parkventory_migrator','parkventory_owner','MEMBER')",
            "'runtime_has_owner_membership', pg_has_role('parkventory_runtime','parkventory_owner','MEMBER')",
            "'migrator_settings', (SELECT COALESCE(array_agg(setting ORDER BY setting),'{}'::text[]) = ARRAY['role=parkventory_owner','search_path=public']::text[] FROM pg_db_role_setting s CROSS JOIN LATERAL unnest(s.setconfig) setting WHERE s.setrole=(SELECT oid FROM pg_roles WHERE rolname='parkventory_migrator') AND s.setdatabase=(SELECT oid FROM pg_database WHERE datname='parkventory'))",
            "'runtime_settings', (SELECT COALESCE(array_agg(setting ORDER BY setting),'{}'::text[]) = ARRAY['search_path=public']::text[] FROM pg_db_role_setting s CROSS JOIN LATERAL unnest(s.setconfig) setting WHERE s.setrole=(SELECT oid FROM pg_roles WHERE rolname='parkventory_runtime') AND s.setdatabase=(SELECT oid FROM pg_database WHERE datname='parkventory'))",
            (
                "'unexpected_role_settings', EXISTS ("
                "SELECT 1 FROM pg_db_role_setting s WHERE "
                "(s.setrole=0 AND s.setdatabase IN "
                "(0,(SELECT oid FROM pg_database WHERE datname='parkventory'))) OR "
                "(s.setrole=(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner') "
                "AND s.setdatabase IN "
                "(0,(SELECT oid FROM pg_database WHERE datname='parkventory'))) OR "
                "(s.setrole IN ((SELECT oid FROM pg_roles WHERE rolname='parkventory_migrator'),"
                "(SELECT oid FROM pg_roles WHERE rolname='parkventory_runtime')) "
                "AND s.setdatabase=0)"
                ")"
            ),
            "'default_table_privileges', (" + privilege_array.format(object_type="'r'") + ")",
            "'default_sequence_privileges', (" + privilege_array.format(object_type="'S'") + ")",
            "'default_function_privileges', (" + privilege_array.format(object_type="'f'") + ")",
            "'default_type_privileges', (" + privilege_array.format(object_type="'T'") + ")",
            "'unexpected_default_grantee', EXISTS (SELECT 1 FROM pg_default_acl d CROSS JOIN LATERAL aclexplode(d.defaclacl) a WHERE d.defaclrole=(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner') AND d.defaclnamespace=(SELECT oid FROM pg_namespace WHERE nspname='public') AND a.grantee NOT IN ((SELECT oid FROM pg_roles WHERE rolname='parkventory_owner'),(SELECT oid FROM pg_roles WHERE rolname='parkventory_runtime')))",
            "'global_default_public_grantee', EXISTS (SELECT 1 FROM pg_default_acl d CROSS JOIN LATERAL aclexplode(d.defaclacl) a WHERE d.defaclrole=(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner') AND d.defaclnamespace=0 AND a.grantee=0)",
            "'global_default_runtime_grantee', EXISTS (SELECT 1 FROM pg_default_acl d CROSS JOIN LATERAL aclexplode(d.defaclacl) a WHERE d.defaclrole=(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner') AND d.defaclnamespace=0 AND a.grantee=(SELECT oid FROM pg_roles WHERE rolname='parkventory_runtime'))",
            "'unexpected_global_default_grantee', EXISTS (SELECT 1 FROM pg_default_acl d CROSS JOIN LATERAL aclexplode(d.defaclacl) a WHERE d.defaclrole=(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner') AND d.defaclnamespace=0 AND a.grantee<>(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner'))",
            "'unexpected_default_scope', EXISTS (SELECT 1 FROM pg_default_acl d WHERE d.defaclrole=(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner') AND d.defaclnamespace NOT IN (0,(SELECT oid FROM pg_namespace WHERE nspname='public')))",
            "'all_relations_owned', NOT EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p','v','m','f','S') AND c.relowner<>(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner'))",
            "'unexpected_relation_grantee', EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace CROSS JOIN LATERAL aclexplode(COALESCE(c.relacl,acldefault(CASE WHEN c.relkind='S' THEN 'S'::\"char\" ELSE 'r'::\"char\" END,c.relowner))) a WHERE n.nspname='public' AND c.relkind IN ('r','p','v','m','f','S') AND a.grantee NOT IN ((SELECT oid FROM pg_roles WHERE rolname='parkventory_owner'),(SELECT oid FROM pg_roles WHERE rolname='parkventory_runtime')))",
            "'column_acl_present', EXISTS (SELECT 1 FROM pg_attribute attribute JOIN pg_class relation ON relation.oid=attribute.attrelid JOIN pg_namespace namespace ON namespace.oid=relation.relnamespace CROSS JOIN LATERAL aclexplode(attribute.attacl) acl WHERE namespace.nspname='public' AND relation.relkind IN ('r','p','v','m','f') AND attribute.attnum>0 AND NOT attribute.attisdropped)",
            "'runtime_relation_privileges_bounded', NOT EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p','v','m','f') AND c.relname NOT IN ('admin_claim','app_session','audit_event','availability_offer','idempotency_record','invitation','magic_link_request','membership','organization','organization_domain','outbox_dispatch','outbox_event','parking_site','parking_spot','reservation','spot_assignment','user_account','user_email') AND (has_table_privilege('parkventory_runtime',c.oid,'SELECT') OR has_table_privilege('parkventory_runtime',c.oid,'INSERT') OR has_table_privilege('parkventory_runtime',c.oid,'UPDATE') OR has_table_privilege('parkventory_runtime',c.oid,'DELETE') OR has_table_privilege('parkventory_runtime',c.oid,'TRUNCATE') OR has_table_privilege('parkventory_runtime',c.oid,'REFERENCES') OR has_table_privilege('parkventory_runtime',c.oid,'TRIGGER') OR has_table_privilege('parkventory_runtime',c.oid,'MAINTAIN')))",
            "'runtime_sequence_privileges_bounded', NOT EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind='S' AND (has_sequence_privilege('parkventory_runtime',c.oid,'USAGE') OR has_sequence_privilege('parkventory_runtime',c.oid,'SELECT') OR has_sequence_privilege('parkventory_runtime',c.oid,'UPDATE')))",
            "'routine_ownership_bounded', NOT EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace LEFT JOIN pg_depend extension_dependency ON extension_dependency.classid='pg_proc'::regclass AND extension_dependency.objid=p.oid AND extension_dependency.objsubid=0 AND extension_dependency.refclassid='pg_extension'::regclass AND extension_dependency.deptype='e' LEFT JOIN pg_extension extension ON extension.oid=extension_dependency.refobjid LEFT JOIN pg_namespace extension_namespace ON extension_namespace.oid=extension.extnamespace WHERE n.nspname='public' AND ((extension.oid IS NULL AND p.proowner<>(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner')) OR (extension.oid IS NOT NULL AND (extension.extname<>'btree_gist' OR extension.extversion<>'1.7' OR extension_namespace.nspname<>'public' OR extension.extowner<>(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner') OR p.proowner<>(SELECT oid FROM pg_roles WHERE rolname='platform_admin')))))",
            "'unexpected_routine_grantee', EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace LEFT JOIN pg_depend extension_dependency ON extension_dependency.classid='pg_proc'::regclass AND extension_dependency.objid=p.oid AND extension_dependency.objsubid=0 AND extension_dependency.refclassid='pg_extension'::regclass AND extension_dependency.deptype='e' CROSS JOIN LATERAL aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) a WHERE n.nspname='public' AND NOT (a.grantee=p.proowner OR (extension_dependency.objid IS NULL AND p.proowner=(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner') AND p.proname IN ('app_current_identity_user_id','app_current_magic_link_hash','app_current_organization_id','app_current_requested_email','app_current_session_hash','app_current_verified_domain','app_current_verified_email') AND pg_get_function_identity_arguments(p.oid)='' AND a.grantee=(SELECT oid FROM pg_roles WHERE rolname='parkventory_runtime'))))",
            "'runtime_routine_privileges_bounded', NOT EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public' AND NOT (p.proname IN ('app_current_identity_user_id','app_current_magic_link_hash','app_current_organization_id','app_current_requested_email','app_current_session_hash','app_current_verified_domain','app_current_verified_email') AND pg_get_function_identity_arguments(p.oid)='') AND has_function_privilege('parkventory_runtime',p.oid,'EXECUTE'))",
            "'type_ownership_bounded', NOT EXISTS (SELECT 1 FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace LEFT JOIN pg_depend extension_dependency ON extension_dependency.classid='pg_type'::regclass AND extension_dependency.objid=t.oid AND extension_dependency.objsubid=0 AND extension_dependency.refclassid='pg_extension'::regclass AND extension_dependency.deptype='e' LEFT JOIN pg_extension extension ON extension.oid=extension_dependency.refobjid LEFT JOIN pg_namespace extension_namespace ON extension_namespace.oid=extension.extnamespace WHERE n.nspname='public' AND t.typisdefined AND t.typelem=0 AND (t.typtype<>'c' OR EXISTS (SELECT 1 FROM pg_class composite WHERE composite.oid=t.typrelid AND composite.relkind='c')) AND ((extension.oid IS NULL AND t.typowner<>(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner')) OR (extension.oid IS NOT NULL AND (extension.extname<>'btree_gist' OR extension.extversion<>'1.7' OR extension_namespace.nspname<>'public' OR extension.extowner<>(SELECT oid FROM pg_roles WHERE rolname='parkventory_owner') OR t.typowner<>(SELECT oid FROM pg_roles WHERE rolname='platform_admin')))))",
            "'unexpected_type_grantee', EXISTS (SELECT 1 FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace LEFT JOIN pg_depend extension_dependency ON extension_dependency.classid='pg_type'::regclass AND extension_dependency.objid=t.oid AND extension_dependency.objsubid=0 AND extension_dependency.refclassid='pg_extension'::regclass AND extension_dependency.deptype='e' CROSS JOIN LATERAL aclexplode(COALESCE(t.typacl,acldefault('T',t.typowner))) a WHERE n.nspname='public' AND t.typisdefined AND t.typelem=0 AND (t.typtype<>'c' OR EXISTS (SELECT 1 FROM pg_class composite WHERE composite.oid=t.typrelid AND composite.relkind='c')) AND a.grantee<>t.typowner)",
            "'runtime_type_privileges_bounded', NOT EXISTS (SELECT 1 FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace WHERE n.nspname='public' AND t.typisdefined AND t.typelem=0 AND (t.typtype<>'c' OR EXISTS (SELECT 1 FROM pg_class composite WHERE composite.oid=t.typrelid AND composite.relkind='c')) AND has_type_privilege('parkventory_runtime',t.oid,'USAGE'))"
    )
    chunks = (
        fields[index : index + 40]
        for index in range(0, len(fields), 40)
    )
    return "SELECT (" + " || ".join(
        "jsonb_build_object(" + ",".join(chunk) + ")" for chunk in chunks
    ) + ")::json;"


def rls_proof_sql() -> str:
    return """
SELECT jsonb_build_object(
  'extensions', COALESCE((
    SELECT jsonb_agg(
      jsonb_build_object(
        'name', extension.extname,
        'version', extension.extversion,
        'schema', namespace.nspname,
        'owner', pg_get_userbyid(extension.extowner),
        'member_owner', (
          SELECT CASE
            WHEN count(DISTINCT member.owner_name) = 1
              THEN min(member.owner_name)
            ELSE NULL
          END
          FROM (
            SELECT pg_get_userbyid(routine.proowner) AS owner_name
            FROM pg_proc routine
            JOIN pg_depend dependency
              ON dependency.classid = 'pg_proc'::regclass
             AND dependency.objid = routine.oid
             AND dependency.objsubid = 0
             AND dependency.refclassid = 'pg_extension'::regclass
             AND dependency.refobjid = extension.oid
             AND dependency.deptype = 'e'
            UNION ALL
            SELECT pg_get_userbyid(type.typowner) AS owner_name
            FROM pg_type type
            JOIN pg_depend dependency
              ON dependency.classid = 'pg_type'::regclass
             AND dependency.objid = type.oid
             AND dependency.objsubid = 0
             AND dependency.refclassid = 'pg_extension'::regclass
             AND dependency.refobjid = extension.oid
             AND dependency.deptype = 'e'
            WHERE type.typisdefined
              AND type.typelem = 0
          ) member
        ),
        'all_members', COALESCE((
          SELECT jsonb_agg(
            jsonb_build_object(
              'catalog', dependency.classid::regclass::text,
              'type', identity.type,
              'schema', identity.schema,
              'name', identity.name,
              'identity', identity.identity,
              'subobject', dependency.objsubid
            )
            ORDER BY dependency.classid::regclass::text,
              identity.type,
              identity.schema,
              identity.name,
              identity.identity,
              dependency.objsubid
          )
          FROM pg_depend dependency
          CROSS JOIN LATERAL pg_identify_object(
            dependency.classid,
            dependency.objid,
            dependency.objsubid
          ) identity
          WHERE dependency.refclassid = 'pg_extension'::regclass
            AND dependency.refobjid = extension.oid
            AND dependency.deptype = 'e'
        ), '[]'::jsonb),
        'routine_members', COALESCE((
          SELECT jsonb_agg(
            jsonb_build_object(
              'name', routine.proname,
              'schema', routine_namespace.nspname,
              'arguments', pg_get_function_identity_arguments(routine.oid),
              'kind', routine.prokind,
              'owner', pg_get_userbyid(routine.proowner)
            )
            ORDER BY routine.proname,
              pg_get_function_identity_arguments(routine.oid),
              routine.prokind
          )
          FROM pg_proc routine
          JOIN pg_namespace routine_namespace
            ON routine_namespace.oid = routine.pronamespace
          JOIN pg_depend dependency
            ON dependency.classid = 'pg_proc'::regclass
           AND dependency.objid = routine.oid
           AND dependency.objsubid = 0
           AND dependency.refclassid = 'pg_extension'::regclass
           AND dependency.refobjid = extension.oid
           AND dependency.deptype = 'e'
        ), '[]'::jsonb),
        'type_members', COALESCE((
          SELECT jsonb_agg(
            jsonb_build_object(
              'name', type.typname,
              'schema', type_namespace.nspname,
              'kind', type.typtype,
              'category', type.typcategory,
              'owner', pg_get_userbyid(type.typowner)
            )
            ORDER BY type.typname
          )
          FROM pg_type type
          JOIN pg_namespace type_namespace
            ON type_namespace.oid = type.typnamespace
          JOIN pg_depend dependency
            ON dependency.classid = 'pg_type'::regclass
           AND dependency.objid = type.oid
           AND dependency.objsubid = 0
           AND dependency.refclassid = 'pg_extension'::regclass
           AND dependency.refobjid = extension.oid
           AND dependency.deptype = 'e'
          WHERE type.typisdefined
            AND type.typelem = 0
        ), '[]'::jsonb)
      )
      ORDER BY extension.extname
    )
    FROM pg_extension extension
    JOIN pg_namespace namespace ON namespace.oid = extension.extnamespace
  ), '[]'::jsonb),
  'tables', COALESCE((
    SELECT jsonb_agg(
      jsonb_build_object(
        'table', relation.relname,
        'enabled', relation.relrowsecurity,
        'forced', relation.relforcerowsecurity
      )
      ORDER BY relation.relname
    )
    FROM pg_class relation
    JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
    WHERE namespace.nspname = 'public'
      AND relation.relkind IN ('r', 'p')
      AND relation.relname <> 'flyway_schema_history'
  ), '[]'::jsonb),
  'policies', COALESCE((
    SELECT jsonb_agg(
      jsonb_build_object(
        'table', relation.relname,
        'name', policy.polname,
        'command', CASE policy.polcmd
          WHEN '*' THEN 'ALL'
          WHEN 'r' THEN 'SELECT'
          WHEN 'a' THEN 'INSERT'
          WHEN 'w' THEN 'UPDATE'
          WHEN 'd' THEN 'DELETE'
        END,
        'permissive', policy.polpermissive,
        'roles', (
          SELECT jsonb_agg(role_name ORDER BY role_name)
          FROM (
            SELECT CASE
              WHEN role_oid = 0 THEN 'PUBLIC'
              ELSE pg_get_userbyid(role_oid)
            END AS role_name
            FROM unnest(policy.polroles) role_oid
          ) policy_roles
        ),
        'using', pg_get_expr(policy.polqual, policy.polrelid),
        'with_check', pg_get_expr(policy.polwithcheck, policy.polrelid)
      )
      ORDER BY relation.relname, policy.polname
    )
    FROM pg_policy policy
    JOIN pg_class relation ON relation.oid = policy.polrelid
    JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
    WHERE namespace.nspname = 'public'
  ), '[]'::jsonb),
  'helpers', COALESCE((
    SELECT jsonb_agg(
      jsonb_build_object(
        'name', routine.proname,
        'arguments', pg_get_function_identity_arguments(routine.oid),
        'result', pg_get_function_result(routine.oid),
        'language', language.lanname,
        'volatility', CASE routine.provolatile
          WHEN 'i' THEN 'IMMUTABLE'
          WHEN 's' THEN 'STABLE'
          WHEN 'v' THEN 'VOLATILE'
        END,
        'parallel', CASE routine.proparallel
          WHEN 's' THEN 'SAFE'
          WHEN 'r' THEN 'RESTRICTED'
          WHEN 'u' THEN 'UNSAFE'
        END,
        'security_definer', routine.prosecdef,
        'leakproof', routine.proleakproof,
        'strict', routine.proisstrict,
        'configuration', COALESCE(to_jsonb(routine.proconfig), '[]'::jsonb),
        'definition', pg_get_functiondef(routine.oid)
      )
      ORDER BY routine.proname
    )
    FROM pg_proc routine
    JOIN pg_namespace namespace ON namespace.oid = routine.pronamespace
    JOIN pg_language language ON language.oid = routine.prolang
    WHERE namespace.nspname = 'public'
      AND routine.proname LIKE 'app_current_%'
  ), '[]'::jsonb),
  'runtime_access', jsonb_build_object(
    'tables', COALESCE((
      SELECT jsonb_agg(
        jsonb_build_object(
          'table', access.relname,
          'privileges', access.privileges
        )
        ORDER BY access.relname
      )
      FROM (
        SELECT relation.relname, (
          SELECT jsonb_agg(candidate.privilege ORDER BY candidate.privilege)
          FROM (VALUES
            ('DELETE'), ('DELETE WITH GRANT OPTION'),
            ('INSERT'), ('INSERT WITH GRANT OPTION'),
            ('MAINTAIN'), ('MAINTAIN WITH GRANT OPTION'),
            ('REFERENCES'), ('REFERENCES WITH GRANT OPTION'),
            ('SELECT'), ('SELECT WITH GRANT OPTION'),
            ('TRIGGER'), ('TRIGGER WITH GRANT OPTION'),
            ('TRUNCATE'), ('TRUNCATE WITH GRANT OPTION'),
            ('UPDATE'), ('UPDATE WITH GRANT OPTION')
          ) candidate(privilege)
          WHERE has_table_privilege(
            'parkventory_runtime', relation.oid, candidate.privilege
          )
        ) AS privileges
        FROM pg_class relation
        JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
        WHERE namespace.nspname = 'public'
          AND relation.relkind IN ('r', 'p', 'v', 'm', 'f')
      ) access
      WHERE access.privileges IS NOT NULL
    ), '[]'::jsonb),
    'sequences', COALESCE((
      SELECT jsonb_agg(
        jsonb_build_object(
          'sequence', access.relname,
          'privileges', access.privileges
        )
        ORDER BY access.relname
      )
      FROM (
        SELECT relation.relname, (
          SELECT jsonb_agg(candidate.privilege ORDER BY candidate.privilege)
          FROM (VALUES
            ('SELECT'), ('SELECT WITH GRANT OPTION'),
            ('UPDATE'), ('UPDATE WITH GRANT OPTION'),
            ('USAGE'), ('USAGE WITH GRANT OPTION')
          ) candidate(privilege)
          WHERE has_sequence_privilege(
            'parkventory_runtime', relation.oid, candidate.privilege
          )
        ) AS privileges
        FROM pg_class relation
        JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
        WHERE namespace.nspname = 'public'
          AND relation.relkind = 'S'
      ) access
      WHERE access.privileges IS NOT NULL
    ), '[]'::jsonb),
    'functions', COALESCE((
      SELECT jsonb_agg(
        jsonb_build_object(
          'name', access.proname,
          'arguments', access.arguments,
          'privileges', access.privileges
        )
        ORDER BY access.proname, access.arguments
      )
      FROM (
        SELECT
          routine.proname,
          pg_get_function_identity_arguments(routine.oid) AS arguments,
          (
            SELECT jsonb_agg(candidate.privilege ORDER BY candidate.privilege)
            FROM (VALUES
              ('EXECUTE'), ('EXECUTE WITH GRANT OPTION')
            ) candidate(privilege)
            WHERE has_function_privilege(
              'parkventory_runtime', routine.oid, candidate.privilege
            )
          ) AS privileges
        FROM pg_proc routine
        JOIN pg_namespace namespace ON namespace.oid = routine.pronamespace
        WHERE namespace.nspname = 'public'
      ) access
      WHERE access.privileges IS NOT NULL
    ), '[]'::jsonb),
    'types', COALESCE((
      SELECT jsonb_agg(
        jsonb_build_object(
          'type', access.typname,
          'privileges', access.privileges
        )
        ORDER BY access.typname
      )
      FROM (
        SELECT type.typname, (
          SELECT jsonb_agg(candidate.privilege ORDER BY candidate.privilege)
          FROM (VALUES
            ('USAGE'), ('USAGE WITH GRANT OPTION')
          ) candidate(privilege)
          WHERE has_type_privilege(
            'parkventory_runtime', type.oid, candidate.privilege
          )
        ) AS privileges
        FROM pg_type type
        JOIN pg_namespace namespace ON namespace.oid = type.typnamespace
        LEFT JOIN pg_depend extension_dependency
          ON extension_dependency.classid = 'pg_type'::regclass
         AND extension_dependency.objid = type.oid
         AND extension_dependency.objsubid = 0
         AND extension_dependency.refclassid = 'pg_extension'::regclass
         AND extension_dependency.deptype = 'e'
        WHERE namespace.nspname = 'public'
          AND type.typisdefined
          AND type.typelem = 0
          AND (
            type.typtype <> 'c'
            OR EXISTS (
              SELECT 1 FROM pg_class composite
              WHERE composite.oid = type.typrelid
                AND composite.relkind = 'c'
            )
          )
      ) access
      WHERE access.privileges IS NOT NULL
    ), '[]'::jsonb)
  )
)::json;
"""


