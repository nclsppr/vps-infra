def fingerprint_rls_helpers(proof: object) -> object:
    if not isinstance(proof, dict) or not isinstance(proof.get("helpers"), list):
        return None
    for helper in proof["helpers"]:
        if not isinstance(helper, dict) or "definition_sha256" in helper:
            return None
        definition = helper.pop("definition", None)
        if not isinstance(definition, str):
            return None
        helper["definition_sha256"] = (
            "sha256:" + hashlib.sha256(definition.encode("utf-8")).hexdigest()
        )
    return proof


def fingerprint_extension_members(proof: object) -> object:
    if not isinstance(proof, dict) or not isinstance(proof.get("extensions"), list):
        return None
    for extension in proof["extensions"]:
        if not isinstance(extension, dict):
            return None
        for key in ("all_members", "routine_members", "type_members"):
            members = extension.get(key)
            if not isinstance(members, list):
                return None
            extension[key] = {
                "count": len(members),
                "identity_sha256": (
                    "sha256:" + hashlib.sha256(canonical_json(members)).hexdigest()
                ),
            }
    return proof


def observe_rls(
    container: str, *, require_runtime_access: bool
) -> dict[str, object]:
    raw = psql(container, "parkventory", rls_proof_sql())
    try:
        parsed = json.loads(raw, object_pairs_hook=unique_object)
    except json.JSONDecodeError as exc:
        raise ProvisionError(
            "PostgreSQL returned invalid row-level security JSON"
        ) from exc
    proof = fingerprint_rls_helpers(parsed)
    proof = fingerprint_extension_members(proof)
    if not isinstance(proof, dict):
        raise ProvisionError(
            "row-level security helper evidence is incomplete"
        )
    runtime_access = proof.pop("runtime_access", None)
    expected_catalog = {
        key: value
        for key, value in EXPECTED_RLS.items()
        if key != "runtime_access"
    }
    if proof != expected_catalog:
        raise ProvisionError(
            "application extension, row-level security tables, policies, or "
            "helpers differ from the application contract"
        )
    if require_runtime_access and runtime_access != EXPECTED_RUNTIME_ACCESS:
        raise ProvisionError(
            "runtime database access differs from the application allowlist"
        )
    proof["runtime_access"] = runtime_access
    return proof


def application_schema_present(container: str) -> bool:
    raw = psql(
        container,
        "parkventory",
        """
SELECT (
  EXISTS (
    SELECT 1
    FROM pg_class relation
    JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
    WHERE namespace.nspname = 'public'
      AND relation.relkind IN ('r', 'p', 'v', 'm', 'f', 'S')
      AND relation.relname <> 'flyway_schema_history'
  )
  OR EXISTS (
    SELECT 1
    FROM pg_policy policy
    JOIN pg_class relation ON relation.oid = policy.polrelid
    JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
    WHERE namespace.nspname = 'public'
  )
  OR EXISTS (
    SELECT 1
    FROM pg_proc routine
    JOIN pg_namespace namespace ON namespace.oid = routine.pronamespace
    WHERE namespace.nspname = 'public'
  )
  OR EXISTS (
    SELECT 1
    FROM pg_type type
    JOIN pg_namespace namespace ON namespace.oid = type.typnamespace
    WHERE namespace.nspname = 'public'
      AND type.typisdefined
      AND type.typelem = 0
      AND (
        type.typtype <> 'c'
        OR EXISTS (
          SELECT 1 FROM pg_class composite
          WHERE composite.oid = type.typrelid
            AND composite.relkind = 'c'
        )
      )
  )
  OR EXISTS (
    SELECT 1
    FROM pg_extension extension
    JOIN pg_namespace namespace ON namespace.oid = extension.extnamespace
    WHERE namespace.nspname = 'public'
  )
)::text;
""",
    )
    if raw not in {"true", "false"}:
        raise ProvisionError("PostgreSQL returned invalid schema presence proof")
    return raw == "true"


def read_database_proof(container: str) -> dict[str, object]:
    raw = psql(container, "parkventory", proof_sql())
    try:
        proof = json.loads(raw, object_pairs_hook=unique_object)
    except json.JSONDecodeError as exc:
        raise ProvisionError("PostgreSQL returned invalid readiness JSON") from exc
    if not isinstance(proof, dict):
        raise ProvisionError("PostgreSQL readiness proof is incomplete")
    return proof


def reconcile_application_acl(container: str) -> bool:
    before = observe_rls(container, require_runtime_access=False)
    database_proof = read_database_proof(container)
    changed = (
        before["runtime_access"] != EXPECTED_RUNTIME_ACCESS
        or database_proof != EXPECTED_PROOF
    )
    if not changed:
        return False
    table_allowlist = ", ".join(
        f"public.{table['table']}" for table in EXPECTED_RLS_TABLES
    )
    function_allowlist = ", ".join(
        f"public.{helper['name']}()" for helper in EXPECTED_RLS_HELPERS
    )
    sql = f"""
BEGIN;
REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public
  FROM PUBLIC, parkventory_runtime;
REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public
  FROM PUBLIC, parkventory_runtime;
REVOKE ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA public
  FROM PUBLIC, parkventory_runtime;
DO $column_acl$
DECLARE
  candidate record;
BEGIN
  FOR candidate IN
    SELECT
      namespace.nspname,
      relation.relname,
      attribute.attname,
      acl.grantee,
      grantee.rolname AS grantee_name
    FROM pg_attribute attribute
    JOIN pg_class relation ON relation.oid = attribute.attrelid
    JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
    CROSS JOIN LATERAL aclexplode(attribute.attacl) acl
    LEFT JOIN pg_roles grantee ON grantee.oid = acl.grantee
    WHERE namespace.nspname = 'public'
      AND relation.relkind IN ('r', 'p', 'v', 'm', 'f')
      AND attribute.attnum > 0
      AND NOT attribute.attisdropped
  LOOP
    IF candidate.grantee = 0 THEN
      EXECUTE format(
        'REVOKE ALL PRIVILEGES (%I) ON TABLE %I.%I FROM PUBLIC',
        candidate.attname,
        candidate.nspname,
        candidate.relname
      );
    ELSE
      EXECUTE format(
        'REVOKE ALL PRIVILEGES (%I) ON TABLE %I.%I FROM %I',
        candidate.attname,
        candidate.nspname,
        candidate.relname,
        candidate.grantee_name
      );
    END IF;
  END LOOP;
END
$column_acl$;
DO $type_acl$
DECLARE
  candidate record;
BEGIN
  FOR candidate IN
    SELECT namespace.nspname, type.typname
    FROM pg_type type
    JOIN pg_namespace namespace ON namespace.oid = type.typnamespace
    LEFT JOIN pg_depend extension_dependency
      ON extension_dependency.classid = 'pg_type'::regclass
     AND extension_dependency.objid = type.oid
     AND extension_dependency.objsubid = 0
     AND extension_dependency.refclassid = 'pg_extension'::regclass
     AND extension_dependency.deptype = 'e'
    WHERE namespace.nspname = 'public'
      AND type.typisdefined
      AND type.typelem = 0
      AND (
        type.typtype <> 'c'
        OR EXISTS (
          SELECT 1 FROM pg_class composite
          WHERE composite.oid = type.typrelid
            AND composite.relkind = 'c'
        )
      )
  LOOP
    EXECUTE format(
      'REVOKE ALL PRIVILEGES ON TYPE %I.%I FROM PUBLIC, parkventory_runtime',
      candidate.nspname,
      candidate.typname
    );
  END LOOP;
END
$type_acl$;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner
  REVOKE ALL ON TABLES FROM PUBLIC, parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner
  REVOKE ALL ON SEQUENCES FROM PUBLIC, parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner
  REVOKE ALL ON FUNCTIONS FROM PUBLIC, parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner
  REVOKE ALL ON TYPES FROM PUBLIC, parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public
  REVOKE ALL ON TABLES FROM PUBLIC, parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public
  REVOKE ALL ON SEQUENCES FROM PUBLIC, parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public
  REVOKE ALL ON FUNCTIONS FROM PUBLIC, parkventory_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE parkventory_owner IN SCHEMA public
  REVOKE ALL ON TYPES FROM PUBLIC, parkventory_runtime;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE {table_allowlist}
  TO parkventory_runtime;
GRANT EXECUTE ON FUNCTION {function_allowlist}
  TO parkventory_runtime;
COMMIT;
"""
    psql(container, "parkventory", sql)
    observe(container, require_rls=True)
    return True


def observe(
    container: str, *, require_rls: bool = False
) -> dict[str, object]:
    proof = read_database_proof(container)
    if proof != EXPECTED_PROOF:
        raise ProvisionError("effective database roles or default privileges differ from the contract")
    if require_rls:
        observe_rls(container, require_runtime_access=True)
    return proof


def check_database(
    container: str, *, require_rls: bool = False
) -> dict[str, object]:
    schema_present = application_schema_present(container)
    return observe(
        container,
        require_rls=require_rls or schema_present,
    )


def evidence_document(
    contract_digest: str,
    image: str,
    proof: dict[str, object],
    credential_digests: dict[str, str],
) -> bytes:
    return canonical_json(
        {
            "contract": "vps-infra.parkventory-postgres-readiness.v1",
            "database_contract_sha256": contract_digest,
            "postgres_image": image,
            "proof": proof,
            "secret_files": {
                "migrator": {
                    "path": str(CREDENTIAL_ROOT / "parkventory-postgres-migrator-password"),
                    "sha256": credential_digests["migrator"],
                    "uid": 0,
                    "gid": 10001,
                    "mode": "0440",
                },
                "runtime": {
                    "path": str(CREDENTIAL_ROOT / "parkventory-postgres-runtime-password"),
                    "sha256": credential_digests["runtime"],
                    "uid": 0,
                    "gid": 10001,
                    "mode": "0440",
                },
            },
            "transport": {
                "network": "db_parkventory",
                "subnet": "172.30.21.0/24",
                "internal": True,
                "postgres_attached": True,
                "published_postgres_port": False,
                "tls": False,
            },
            "validity": {
                "requires_live_check": True,
                "requires_postgres_network_attachment": True,
            },
        }
    )


def require_evidence(expected: bytes) -> None:
    try:
        descriptor = os.open(EVIDENCE_PATH, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as exc:
        raise ProvisionError("PostgreSQL readiness evidence is missing or unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != 0
            or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o400
            or metadata.st_size != len(expected)
        ):
            raise ProvisionError("PostgreSQL readiness evidence has unsafe metadata")
        if os.read(descriptor, MAX_FILE_BYTES + 1) != expected:
            raise ProvisionError("PostgreSQL readiness evidence is stale")
    finally:
        os.close(descriptor)


def require_safe_evidence_target() -> None:
    try:
        metadata = EVIDENCE_PATH.lstat()
    except FileNotFoundError:
        return
    except OSError as exc:
        raise ProvisionError("cannot inspect PostgreSQL readiness evidence") from exc
    if (
        not stat.S_ISREG(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_nlink != 1
        or metadata.st_uid != 0
        or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o400
        or not 1 <= metadata.st_size <= MAX_FILE_BYTES
    ):
        raise ProvisionError("PostgreSQL readiness evidence target is unsafe")


def write_evidence(content: bytes) -> None:
    for path in (Path("/var/lib/vps-readiness"), EVIDENCE_PATH.parent):
        try:
            path.mkdir(mode=0o700)
        except FileExistsError:
            pass
        metadata = path.lstat()
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o700
        ):
            raise ProvisionError(f"readiness directory {path} is unsafe")
    require_safe_evidence_target()
    temporary = EVIDENCE_PATH.parent / f".postgres.{secrets.token_hex(16)}.pending"
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o400,
    )
    try:
        os.fchown(descriptor, 0, 0)
        os.fchmod(descriptor, 0o400)
        written = 0
        while written < len(content):
            written += os.write(descriptor, content[written:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    try:
        os.replace(temporary, EVIDENCE_PATH)
        directory = os.open(EVIDENCE_PATH.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--apply", dest="mode", action="store_const", const="apply")
    modes.add_argument("--check", dest="mode", action="store_const", const="check")
    modes.add_argument("--dry-run", dest="mode", action="store_const", const="dry-run")
    modes.add_argument(
        "--reconcile-application-schema",
        dest="mode",
        action="store_const",
        const="reconcile-application-schema",
    )
    parser.set_defaults(mode="check")
    parser.add_argument("--validate-contract", action="store_true")
    parser.add_argument("--require-rls", action="store_true")
    parser.add_argument("--embedded-contract", action="store_true")
    parser.add_argument("--contract", type=Path, default=CONTRACT_PATH)
    return parser.parse_args()


def main() -> int:
    arguments = parse_args()
    try:
        embedded_contract = getattr(arguments, "embedded_contract", False)
        if embedded_contract:
            if arguments.mode != "dry-run" or arguments.contract != CONTRACT_PATH:
                raise ProvisionError(
                    "the embedded contract is restricted to the source dry-run"
                )
            contract = EXPECTED_CONTRACT
            contract_digest = (
                "sha256:" + hashlib.sha256(canonical_json(contract)).hexdigest()
            )
        else:
            contract, contract_digest = load_contract(arguments.contract)
        if arguments.validate_contract:
            print(f"Parkventory PostgreSQL contract valid: {arguments.contract}")
            return 0
        if arguments.require_rls and arguments.mode != "check":
            raise ProvisionError("row-level security proof is check-only")
        if os.geteuid() != 0 or arguments.contract != CONTRACT_PATH:
            raise ProvisionError("live PostgreSQL verification requires root and the fixed contract")
        container, image = resolve_postgres(
            contract,
            require_network=arguments.mode
            in {"apply", "check", "reconcile-application-schema"},
        )
        if arguments.mode == "dry-run":
            print(canonical_json({"changed": True, "mode": "dry-run", "ready": False}).decode(), end="")
            return 0
        migrator, migrator_digest = read_password(
            CREDENTIAL_ROOT / "parkventory-postgres-migrator-password"
        )
        runtime, runtime_digest = read_password(
            CREDENTIAL_ROOT / "parkventory-postgres-runtime-password"
        )
        if migrator == runtime:
            raise ProvisionError("migrator and runtime passwords must be distinct")
        credential_digests = {
            "migrator": migrator_digest,
            "runtime": runtime_digest,
        }
        changed = False
        if arguments.mode == "apply":
            require_safe_evidence_target()
            try:
                proof = observe(container)
                verify_database_credentials(container, migrator, runtime)
                evidence = evidence_document(
                    contract_digest, image, proof, credential_digests
                )
                require_evidence(evidence)
            except ProvisionError:
                apply_database(container, migrator, runtime)
                changed = True
            schema_present = application_schema_present(container)
            if schema_present:
                changed = reconcile_application_acl(container) or changed
            proof = observe(container, require_rls=schema_present)
            verify_database_credentials(container, migrator, runtime)
            evidence = evidence_document(
                contract_digest, image, proof, credential_digests
            )
            if changed:
                write_evidence(evidence)
            else:
                require_evidence(evidence)
        elif arguments.mode == "reconcile-application-schema":
            verify_database_credentials(container, migrator, runtime)
            if not application_schema_present(container):
                raise ProvisionError(
                    "application schema is absent after migration"
                )
            changed = reconcile_application_acl(container)
            proof = observe(container, require_rls=True)
            verify_database_credentials(container, migrator, runtime)
            evidence = evidence_document(
                contract_digest, image, proof, credential_digests
            )
            require_evidence(evidence)
        else:
            proof = check_database(
                container,
                require_rls=arguments.require_rls,
            )
            verify_database_credentials(container, migrator, runtime)
            evidence = evidence_document(
                contract_digest, image, proof, credential_digests
            )
            require_evidence(evidence)
    except ProvisionError as exc:
        return fail(str(exc))
    print(
        canonical_json(
            {"changed": changed, "mode": arguments.mode, "ready": True}
        ).decode(),
        end="",
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
