class StaticDeploymentError(ValueError):
    """The candidate static release violates the materialization contract."""


@dataclasses.dataclass(frozen=True)
class RedirectContract:
    domain: str
    expected_hsts: bool


@dataclasses.dataclass(frozen=True)
class StaticProfile:
    application: str
    source_repository: str
    source_url: str
    source_ref: str
    signer_workflow: str
    canonical_domain: str
    redirect_domains: tuple[str, ...]
    live_redirects: tuple[RedirectContract, ...]
    site_repository: str
    routes_repository: str
    max_archive_bytes: int
    max_uncompressed_bytes: int
    max_files: int
    max_members: int
    max_tar_stream_bytes: int
    file_mode: int
    directory_mode: int
    require_pax_revision: bool
    probe_timeout_seconds: int


@dataclasses.dataclass(frozen=True)
class LayerContract:
    manifest_digest: str
    layer_digest: str
    layer_size: int
    created: str


@dataclasses.dataclass(frozen=True)
class IntegrationContract:
    manifest_digest: str
    archive_digest: str
    archive_size: int
    inventory_digest: str
    inventory_size: int
    created: str


@dataclasses.dataclass(frozen=True)
class IntegrationFileContract:
    path: str
    size: int
    sha256: str


@dataclasses.dataclass(frozen=True)
class RegistryFetchContract:
    repository: str
    kind: str
    digest: str
    maximum_size: int
    expected_size: int | None


@dataclasses.dataclass(frozen=True)
class RouteFile:
    file: str
    route: str
    size: int
    sha256: str


@dataclasses.dataclass(frozen=True)
class InventoryContract:
    archive_bytes: int
    archive_sha256: str
    file_count: int
    uncompressed_bytes: int
    files: tuple[RouteFile, ...]


@dataclasses.dataclass(frozen=True)
class IsolatedWorkerState:
    unit: str
    state_name: str
    logical_root: Path
    physical_root: Path
    uid: int
    gid: int
    remapped_input_names: tuple[str, ...] = ()


@dataclasses.dataclass(frozen=True)
class DeploymentState:
    application: str
    source_revision: str
    site_reference: str
    routes_reference: str
    integration_revision: str
    integration_reference: str
    caddy_image: str

    def as_dict(self) -> dict[str, object]:
        return {
            "application": self.application,
            "caddy_image": self.caddy_image,
            "integration_reference": self.integration_reference,
            "integration_revision": self.integration_revision,
            "routes_reference": self.routes_reference,
            "schema": 1,
            "site_reference": self.site_reference,
            "source_revision": self.source_revision,
        }


@dataclasses.dataclass(frozen=True)
class DeploymentTransaction:
    candidate: DeploymentState
    previous_state: DeploymentState | None
    previous_target: str | None
    expected_target: str
    phase: str

    def as_dict(self) -> dict[str, object]:
        return {
            "application": self.candidate.application,
            "candidate": self.candidate.as_dict(),
            "expected_target": self.expected_target,
            "phase": self.phase,
            "previous_state": (
                None if self.previous_state is None else self.previous_state.as_dict()
            ),
            "previous_target": self.previous_target,
            "schema": 1,
        }


