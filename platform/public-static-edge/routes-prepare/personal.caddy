http://nicolaspieper.com, http://www.nicolaspieper.com, http://pieper.fr, http://www.pieper.fr, http://nicolas.pieper.fr {
	log
	root * /srv/www/personal/current
	import static_site
	handle_errors {
		import security_headers
		header Cache-Control "no-cache"
		@not_found expression {err.status_code} == 404
		rewrite @not_found /404.html
		file_server
	}
}
