parkventory.com {
	log
	root * /srv/www/parkventory/current
	import static_site
	handle_errors {
		import security_headers
		header Cache-Control "no-cache"
		@not_found expression {err.status_code} == 404
		rewrite @not_found /404.html
		file_server
	}
}

www.parkventory.com {
	import security_headers
	redir https://parkventory.com{uri} 308
}
