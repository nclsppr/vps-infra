nicolaspieper.com {
	log
	root * /srv/www/personal/current
	import static_site
	handle_errors {
		import security_headers
		header Cache-Control "no-cache"
		@not_found expression {err.status_code} == 404
		rewrite @not_found /404.html
		file_server
	}
}

http://www.nicolaspieper.com, http://pieper.fr, http://nicolas.pieper.fr {
	import redirect_security_headers
	redir https://nicolaspieper.com{uri} 308
}

www.nicolaspieper.com, pieper.fr, nicolas.pieper.fr {
	import redirect_security_headers
	redir https://nicolaspieper.com{uri} 308
}
