# Structural validation uses the exact upstream Caddy image audited in
# Surplasse. It cannot serve the Surplasse wildcard because it does not contain
# the OVH DNS module. Production MUST replace this value with the digest of the
# image built from platform/caddy/Dockerfile.
CADDY_PLATFORM_IMAGE=docker.io/library/caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
CADDY_BUILDER_IMAGE=docker.io/library/caddy:2.11.4-builder-alpine@sha256:8e89605351333ad2cc2f3bcc95275a2ccc427f88914050e86a5fde0fd77a63c4
CADDY_RUNTIME_IMAGE=docker.io/library/caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
# caddy-dns/ovh v1.1.0, resolved and pinned to its immutable commit.
CADDY_DNS_MODULE=github.com/caddy-dns/ovh@17fd665136b593153167bf9dfee9a3c0bd2c7ac0
POSTGRES_IMAGE=docker.io/library/postgres:17.10-bookworm@sha256:4f736ae292687621d4dbe0d499ffd024a36bd2ee7d8ca6f2ccd4c800f047b394
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.13.1-busybox@sha256:3c42b892cf723fa54d2f262c37a0e1f80aa8c8ddb1da7b9b0df9455a35a7f893
GRAFANA_IMAGE=docker.io/grafana/grafana:13.1.1@sha256:1c1bd67c54c5fcf6e759897852b5a584191bd6796e8d328a5ace457799801261
NODE_EXPORTER_IMAGE=docker.io/prom/node-exporter:v1.12.1@sha256:1b4e4438faca4dd7e001dd445d161a4a2091b0fededa84093b3a8dfeae1f1be0
POSTGRES_EXPORTER_IMAGE=docker.io/prometheuscommunity/postgres-exporter:v0.20.1@sha256:ac5ec343104fae0e2d84a27bb8d69b38430a11910c5382cad85d478d2bab713e

CADDY_HTTP_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_BIND_ADDRESS=0.0.0.0
CADDY_HTTPS_PORT=443
STATIC_ROOT=/srv/www

PERSONAL_DOMAIN=nicolaspieper.com
PERSONAL_WWW_DOMAIN=www.nicolaspieper.com
PERSONAL_LEGACY_DOMAIN=nicolas.pieper.fr
PAPERSEMPIRE_DOMAIN=papersempire.com
SURPLASSE_DOMAIN=surplasse.com
SURPLASSE_BASE_URL=https://surplasse.com
SURPLASSE_ONBOARDING_ORIGIN=https://surplasse.com
SURPLASSE_DASHBOARD_ORIGIN=https://dashboard.surplasse.com
SURPLASSE_BACKEND_UPSTREAM=surplasse-backend:8080
SURPLASSE_ONBOARDING_UPSTREAM=surplasse-onboarding:8080
SURPLASSE_COMMANDE_UPSTREAM=surplasse-commande:8080
SURPLASSE_DASHBOARD_UPSTREAM=surplasse-dashboard:8080
SURPLASSE_DOCS_UPSTREAM=surplasse-docs:8080

# Parkventory has no production domain or production artifacts yet. This value
# is deliberately non-routable and its Caddy fragment remains disabled.
PARKVENTORY_ENABLED=false
PARKVENTORY_DOMAIN=parkventory.invalid

OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY_FILE=/etc/vps/secrets/platform/ovh-application-key
OVH_APPLICATION_SECRET_FILE=/etc/vps/secrets/platform/ovh-application-secret
OVH_CONSUMER_KEY_FILE=/etc/vps/secrets/platform/ovh-consumer-key
POSTGRES_SUPERUSER_PASSWORD_FILE=/etc/vps/secrets/platform/postgres-superuser-password
POSTGRES_EXPORTER_PASSWORD_FILE=/etc/vps/secrets/platform/postgres-exporter-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD_FILE=/etc/vps/secrets/platform/grafana-admin-password
GRAFANA_SECRET_KEY_FILE=/etc/vps/secrets/platform/grafana-secret-key

GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://127.0.0.1:3000
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=8GB

OPS_NETWORK_NAME=ops
SURPLASSE_APP_NETWORK_NAME=app_surplasse
SURPLASSE_DB_NETWORK_NAME=db_surplasse
PARKVENTORY_APP_NETWORK_NAME=app_parkventory
PARKVENTORY_DB_NETWORK_NAME=db_parkventory
POSTGRES_MONITORING_NETWORK_NAME=db_monitoring
