# Custom Caddy 2.11.4 image built from the committed Go graph and OVH module.
# GitHub Actions verified the manifest, both native images, strict vulnerability
# scans, OCI labels and build provenance before this digest was promoted.
CADDY_PLATFORM_IMAGE=ghcr.io/nclsppr/vps-infra/caddy:sha-755565642f71918134151921f8eae63935951ad6@sha256:1879be5d28d98d49522d74f4fc1bd8c176fd4e35112f757b6639151f3170f11f
POSTGRES_IMAGE=ghcr.io/nclsppr/vps-infra/postgres:sha-e45dc731d1db291a2b14d7db46eb95d90a06750c@sha256:f26c37a44c6d2286fe6794a2bc7d18c23907c8bdb9ffc3e0890e07be713d6095
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.13.2-busybox@sha256:1147c92841726a6fef55fe6124491d6f85480f8de204f7d420304ca5bbd0a8f7
GRAFANA_IMAGE=docker.io/grafana/grafana:13.1.3-slim@sha256:0d2091fa32b712dd93c20376f21f3feb32789afcda6d1a3595da463fbff303c7
NODE_EXPORTER_IMAGE=docker.io/prom/node-exporter:v1.12.1-busybox@sha256:da83fae85603c4e47e6c68369a7d746e2dda683dc35ea2e234b4f171e0d92798
POSTGRES_EXPORTER_IMAGE=docker.io/prometheuscommunity/postgres-exporter:v0.20.1@sha256:4f3d82803c1f99ea5e767890de3557d2479ebbc711f63f2e04c663daa840057a

CADDY_HTTP_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_BIND_ADDRESS=0.0.0.0
CADDY_HTTPS_PORT=443
STATIC_ROOT=/srv/www

POSTGRES_SUPERUSER_PASSWORD_FILE=/etc/vps/secrets/platform/postgres-superuser-password
POSTGRES_EXPORTER_PASSWORD_FILE=/etc/vps/secrets/platform/postgres-exporter-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD_FILE=/etc/vps/secrets/platform/grafana-admin-password
GRAFANA_SECRET_KEY_FILE=/etc/vps/secrets/platform/grafana-secret-key

GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://127.0.0.1:3000
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=8GB

OPS_NETWORK_NAME=ops
POSTGRES_MONITORING_NETWORK_NAME=db_monitoring
