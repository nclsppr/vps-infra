https://{$SURPLASSE_DOMAIN:surplasse.com}, https://*.{$SURPLASSE_DOMAIN:surplasse.com} {
	log
	import security_headers
	import /etc/caddy/surplasse-tls.caddy

	@edge_identity path /.well-known/surplasse-edge
	handle @edge_identity {
		respond "surplasse-edge-v1" 200
	}

	@api_management {
		host api.{$SURPLASSE_DOMAIN:surplasse.com}
		path /q /q/*
	}
	handle @api_management {
		respond "Not found.\n" 404
	}

	@api_dashboard {
		host api.{$SURPLASSE_DOMAIN:surplasse.com}
		header Origin {$SURPLASSE_DASHBOARD_ORIGIN:https://dashboard.surplasse.com}
	}
	handle @api_dashboard {
		reverse_proxy {$SURPLASSE_BACKEND_UPSTREAM:surplasse-backend:8080} {
			import proxy_headers
			flush_interval -1
			header_down Access-Control-Allow-Credentials "true"
		}
	}

	@api_onboarding {
		host api.{$SURPLASSE_DOMAIN:surplasse.com}
		header Origin {$SURPLASSE_ONBOARDING_ORIGIN:https://surplasse.com}
	}
	handle @api_onboarding {
		reverse_proxy {$SURPLASSE_BACKEND_UPSTREAM:surplasse-backend:8080} {
			import proxy_headers
			flush_interval -1
			header_down Access-Control-Allow-Credentials "true"
		}
	}

	@api host api.{$SURPLASSE_DOMAIN:surplasse.com}
	handle @api {
		reverse_proxy {$SURPLASSE_BACKEND_UPSTREAM:surplasse-backend:8080} {
			import proxy_headers
			flush_interval -1
			header_down -Access-Control-Allow-Credentials
		}
	}

	@docs host docs.{$SURPLASSE_DOMAIN:surplasse.com}
	handle @docs {
		reverse_proxy {$SURPLASSE_DOCS_UPSTREAM:surplasse-docs:8080} {
			import proxy_headers
		}
	}

	@dashboard host dashboard.{$SURPLASSE_DOMAIN:surplasse.com}
	handle @dashboard {
		reverse_proxy {$SURPLASSE_DASHBOARD_UPSTREAM:surplasse-dashboard:8080} {
			import proxy_headers
		}
	}

	@www host www.{$SURPLASSE_DOMAIN:surplasse.com}
	handle @www {
		redir {$SURPLASSE_BASE_URL:https://surplasse.com}{uri} 308
	}

	@stripe_connect_unavailable {
		host {$SURPLASSE_DOMAIN:surplasse.com}
		path /stripe-connect/config /stripe-connect/account-session
	}
	handle @stripe_connect_unavailable {
		respond "Stripe Connect is not available in this production release.\n" 503
	}

	@onboarding_content {
		host {$SURPLASSE_DOMAIN:surplasse.com}
		path / /index.html /creer.html /connect.html /connect.js /runtime-config.js /brand/*
	}
	handle @onboarding_content {
		rewrite / /frontends/onboarding/index.html
		rewrite /index.html /frontends/onboarding/index.html
		rewrite /creer.html /frontends/onboarding/creer.html
		rewrite /connect.html /frontends/onboarding/connect.html
		rewrite /connect.js /frontends/onboarding/connect.js
		rewrite /runtime-config.js /frontends/onboarding/runtime-config.js
		reverse_proxy {$SURPLASSE_ONBOARDING_UPSTREAM:surplasse-onboarding:8080} {
			import proxy_headers
		}
	}

	@onboarding host {$SURPLASSE_DOMAIN:surplasse.com}
	handle @onboarding {
		respond "This path is not exposed by the Surplasse Onboarding.\n" 404
	}

	@reserved host app.{$SURPLASSE_DOMAIN:surplasse.com} admin.{$SURPLASSE_DOMAIN:surplasse.com} local.{$SURPLASSE_DOMAIN:surplasse.com} mail.{$SURPLASSE_DOMAIN:surplasse.com} autoconfig.{$SURPLASSE_DOMAIN:surplasse.com} autodiscover.{$SURPLASSE_DOMAIN:surplasse.com} mta-sts.{$SURPLASSE_DOMAIN:surplasse.com} smtp.{$SURPLASSE_DOMAIN:surplasse.com} imap.{$SURPLASSE_DOMAIN:surplasse.com} pop.{$SURPLASSE_DOMAIN:surplasse.com} pop3.{$SURPLASSE_DOMAIN:surplasse.com} webmail.{$SURPLASSE_DOMAIN:surplasse.com} status.{$SURPLASSE_DOMAIN:surplasse.com} reports.{$SURPLASSE_DOMAIN:surplasse.com} grafana.{$SURPLASSE_DOMAIN:surplasse.com}
	handle @reserved {
		respond "This Surplasse subdomain is reserved but has no service in this deployment.\n" 503
	}

	handle {
		reverse_proxy {$SURPLASSE_COMMANDE_UPSTREAM:surplasse-commande:8080} {
			import proxy_headers
		}
	}
}
