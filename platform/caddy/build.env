# Reproducible base images for platform/caddy/Dockerfile. These values do not
# select the image that Compose runs. Renovate may propose the two upstream
# images only after operator approval. The complete Go graph is locked in
# platform/caddy/build/go.mod and go.sum.
CADDY_BUILDER_IMAGE=docker.io/library/caddy:2.11.4-builder-alpine@sha256:c2433c74c0648b47d8a844ff1792661f93996c553687101bbdf89c63a09dccef
CADDY_RUNTIME_IMAGE=docker.io/library/caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
