#!/usr/bin/env bash
set -Eeuo pipefail

export PYTHONDONTWRITEBYTECODE=1

TESTS_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly TESTS_DIR
readonly VALID_SHA=0123456789abcdef0123456789abcdef01234567
readonly VALID_DIGEST=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
readonly PERSONAL_SITE="ghcr.io/nclsppr/personal/site@sha256:$VALID_DIGEST"
readonly PERSONAL_ROUTES="ghcr.io/nclsppr/personal/routes@sha256:$VALID_DIGEST"
readonly PAPERSEMPIRE_SITE="ghcr.io/nclsppr/papersempire/site@sha256:$VALID_DIGEST"
readonly PAPERSEMPIRE_ROUTES="ghcr.io/nclsppr/papersempire/routes@sha256:$VALID_DIGEST"
readonly PARKVENTORY_SITE="ghcr.io/nclsppr/parkventory-static-site@sha256:$VALID_DIGEST"
readonly PARKVENTORY_ROUTES="ghcr.io/nclsppr/parkventory-static-routes@sha256:$VALID_DIGEST"
readonly PLATFORM_INTEGRATION="ghcr.io/nclsppr/vps-infra/platform-integration@sha256:$VALID_DIGEST"
readonly CADDY_IMAGE="ghcr.io/nclsppr/vps-infra/caddy:sha-$VALID_SHA@sha256:$VALID_DIGEST"
readonly SURPLASSE_RELEASE="ghcr.io/nclsppr/surplasse/application-release@sha256:$VALID_DIGEST"
readonly PARKVENTORY_RELEASE="ghcr.io/nclsppr/parkventory/application-release@sha256:$VALID_DIGEST"
readonly MONFLORIAN_RELEASE="ghcr.io/nclsppr/monflorian/application-release@sha256:$VALID_DIGEST"

if [[ $EUID -eq 0 ]]; then
  command -v setpriv >/dev/null 2>&1 || {
    echo "test runner requires setpriv when executed as root" >&2
    exit 78
  }

  guard_root=$(mktemp -d)
  set +e
  VPS_CONTROLLER_TESTING=1 \
    VPS_REPOSITORY_DIR="$guard_root/repository" \
    VPS_STATE_DIR="$guard_root/state" \
    VPS_LOCK_DIR="$guard_root/lock" \
    VPS_PRODUCTION_ENABLE_FILE="$guard_root/production-enabled" \
    "$TESTS_DIR/../scripts/deploy" "$VALID_SHA" \
    >"$guard_root/stdout" 2>"$guard_root/stderr"
  guard_status=$?
  set -e
  if [[ $guard_status -ne 78 ]] || \
    ! grep -Fxq 'deploy refused: root cannot use controller test mode' "$guard_root/stderr" || \
    [[ -e $guard_root/repository || -e $guard_root/state || -e $guard_root/lock || \
      -e $guard_root/production-enabled ]]; then
    echo "root controller test guard failed" >&2
    rm -rf -- "$guard_root"
    exit 1
  fi
  rm -rf -- "$guard_root"

  if setpriv --reuid=65534 --regid=65534 --clear-groups -- \
    /bin/true >/dev/null 2>&1; then
    set +e
    setpriv --reuid=65534 --regid=65534 --clear-groups -- \
      /bin/bash -s -- "$TESTS_DIR/run" <<'UNPRIVILEGED_TESTS'
set -Eeuo pipefail
test_runner=$1
private_root=$(mktemp -d /tmp/vps-infra-tests.XXXXXX)
cleanup() {
  local status=$?
  rm -rf -- "$private_root"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM
mkdir -m 0700 -- "$private_root/home" "$private_root/tmp"
HOME="$private_root/home" \
  TMPDIR="$private_root/tmp" \
  XDG_CONFIG_HOME="$private_root/home/.config" \
  "$test_runner"
UNPRIVILEGED_TESTS
    test_status=$?
    set -e
    exit "$test_status"
  fi

  echo "unprivileged user context unavailable: controller integration tests skipped" >&2
  export VPS_CONTROLLER_ROOT_SAFE_SKIP=1
fi

python3 "$TESTS_DIR/test_release_controller.py"
python3 "$TESTS_DIR/test_github_evidence.py"
python3 "$TESTS_DIR/test_platform_integration.py"
python3 "$TESTS_DIR/test_platform_proof.py"
python3 "$TESTS_DIR/test_postgres_backup.py"
python3 "$TESTS_DIR/test_codex_cli.py"
python3 "$TESTS_DIR/test_repository_contract.py"
python3 "$TESTS_DIR/test_secret_registry.py"
python3 "$TESTS_DIR/test_application_release_policy.py"
python3 "$TESTS_DIR/test_application_release_resolver.py"
python3 "$TESTS_DIR/test_application_bundle.py"
python3 "$TESTS_DIR/test_application_controller.py"
python3 "$TESTS_DIR/test_surplasse_pilot_local_staging.py"
python3 "$TESTS_DIR/test_surplasse_pilot_manifest.py"
python3 "$TESTS_DIR/test_surplasse_pilot_controller.py"
python3 "$TESTS_DIR/test_static_release_resolver.py"
python3 "$TESTS_DIR/test_static_materializer.py"
python3 "$TESTS_DIR/test_surplasse_controller.py"
python3 "$TESTS_DIR/test_surplasse_public_edge_candidate.py"
python3 "$TESTS_DIR/test_surplasse_dns_materializer.py"
python3 "$TESTS_DIR/test_surplasse_public_edge_controller.py"
python3 "$TESTS_DIR/test_surplasse_dns_cutover.py"
python3 "$TESTS_DIR/test_parkventory_postgres.py"
python3 "$TESTS_DIR/test_parkventory_provider_secrets.py"
python3 "$TESTS_DIR/test_parkventory_postgres_integration.py"

parsed=$("$TESTS_DIR/../scripts/parse-forced-command" "deploy $VALID_SHA")
[[ $parsed == "$VALID_SHA" ]]

personal_command="deploy-static-live personal $VALID_SHA $PERSONAL_SITE $PERSONAL_ROUTES $VALID_SHA $PLATFORM_INTEGRATION $CADDY_IMAGE"
papersempire_command="deploy-static-live papersempire $VALID_SHA $PAPERSEMPIRE_SITE $PAPERSEMPIRE_ROUTES $VALID_SHA $PLATFORM_INTEGRATION ghcr.io/nclsppr/vps-infra/caddy@sha256:$VALID_DIGEST"
parkventory_command="deploy-static-live parkventory $VALID_SHA $PARKVENTORY_SITE $PARKVENTORY_ROUTES $VALID_SHA $PLATFORM_INTEGRATION ghcr.io/nclsppr/vps-infra/caddy:release_1.2-3@sha256:$VALID_DIGEST"
surplasse_application_command="deploy-application-live surplasse $VALID_SHA $SURPLASSE_RELEASE"
parkventory_application_command="deploy-application-live parkventory $VALID_SHA $PARKVENTORY_RELEASE"
monflorian_application_command="deploy-application-live monflorian $VALID_SHA $MONFLORIAN_RELEASE"

for valid in \
  "$personal_command" \
  "$papersempire_command" \
  "$parkventory_command"; do
  parsed=$("$TESTS_DIR/../scripts/parse-forced-command" "$valid")
  [[ $parsed == "$valid" ]]
done

for valid in \
  "$surplasse_application_command" \
  "$parkventory_application_command" \
  "$monflorian_application_command"; do
  parsed=$("$TESTS_DIR/../scripts/parse-forced-command" "$valid")
  [[ $parsed == "$valid" ]]
done

for invalid in \
  "" \
  "deploy" \
  "deploy  $VALID_SHA" \
  "deploy ${VALID_SHA} " \
  "deploy 0123456789ABCDEF0123456789ABCDEF01234567" \
  "deploy aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaé" \
  "deploy ${VALID_SHA}; id" \
  "deploy ${VALID_SHA}$(printf '\nid')" \
  "deploy \$(id)" \
  "deploy ${VALID_SHA}\t" \
  "doctor"; do
  if "$TESTS_DIR/../scripts/parse-forced-command" "$invalid" >/dev/null 2>&1; then
    echo "parser unexpectedly accepted: $invalid" >&2
    exit 1
  fi
done

for invalid in \
  "deploy-application-live" \
  "deploy-application-live  surplasse $VALID_SHA $SURPLASSE_RELEASE" \
  "${surplasse_application_command} " \
  "$surplasse_application_command extra" \
  "deploy-application-live unknown $VALID_SHA $SURPLASSE_RELEASE" \
  "deploy-application-live surplasse 0123456789ABCDEF0123456789ABCDEF01234567 $SURPLASSE_RELEASE" \
  "deploy-application-live surplasse $VALID_SHA $PARKVENTORY_RELEASE" \
  "deploy-application-live monflorian $VALID_SHA $SURPLASSE_RELEASE" \
  "deploy-application-live surplasse $VALID_SHA ghcr.io/nclsppr/surplasse/application-release:latest@sha256:$VALID_DIGEST" \
  "deploy-application-live surplasse $VALID_SHA ghcr.io/nclsppr/surplasse/application-release@sha256:${VALID_DIGEST%?}" \
  "${surplasse_application_command}; id" \
  "${surplasse_application_command}"$'\n''id' \
  "${surplasse_application_command}"$'\t'; do
  if "$TESTS_DIR/../scripts/parse-forced-command" "$invalid" >/dev/null 2>&1; then
    echo "parser unexpectedly accepted application command: $invalid" >&2
    exit 1
  fi
done

for invalid in \
  "deploy-static-live" \
  "deploy-static-live  personal $VALID_SHA $PERSONAL_SITE $PERSONAL_ROUTES $VALID_SHA $PLATFORM_INTEGRATION $CADDY_IMAGE" \
  "${personal_command} " \
  "$personal_command extra" \
  "deploy-static-live unknown $VALID_SHA $PERSONAL_SITE $PERSONAL_ROUTES $VALID_SHA $PLATFORM_INTEGRATION $CADDY_IMAGE" \
  "deploy-static-live personal 0123456789ABCDEF0123456789ABCDEF01234567 $PERSONAL_SITE $PERSONAL_ROUTES $VALID_SHA $PLATFORM_INTEGRATION $CADDY_IMAGE" \
  "deploy-static-live personal $VALID_SHA $PAPERSEMPIRE_SITE $PERSONAL_ROUTES $VALID_SHA $PLATFORM_INTEGRATION $CADDY_IMAGE" \
  "deploy-static-live personal $VALID_SHA ghcr.io/nclsppr/personal/site:latest@sha256:$VALID_DIGEST $PERSONAL_ROUTES $VALID_SHA $PLATFORM_INTEGRATION $CADDY_IMAGE" \
  "deploy-static-live personal $VALID_SHA $PERSONAL_SITE ghcr.io/nclsppr/papersempire/routes@sha256:$VALID_DIGEST $VALID_SHA $PLATFORM_INTEGRATION $CADDY_IMAGE" \
  "deploy-static-live personal $VALID_SHA $PERSONAL_SITE $PERSONAL_ROUTES $VALID_SHA ghcr.io/nclsppr/vps-infra/platform-integration:latest@sha256:$VALID_DIGEST $CADDY_IMAGE" \
  "deploy-static-live personal $VALID_SHA $PERSONAL_SITE $PERSONAL_ROUTES $VALID_SHA $PLATFORM_INTEGRATION ghcr.io/nclsppr/vps-infra/caddy:bad/tag@sha256:$VALID_DIGEST" \
  "deploy-static-live personal $VALID_SHA $PERSONAL_SITE $PERSONAL_ROUTES $VALID_SHA $PLATFORM_INTEGRATION ghcr.io/nclsppr/vps-infra/caddy:tag@sha256:${VALID_DIGEST%?}" \
  "deploy-static-live personal $VALID_SHA $PERSONAL_SITE $PERSONAL_ROUTES $VALID_SHA $PLATFORM_INTEGRATION ghcr.io/nclsppr/other/caddy@sha256:$VALID_DIGEST" \
  "${personal_command}; id" \
  "${personal_command}"$'\n''id' \
  "${personal_command}"$'\t'; do
  if "$TESTS_DIR/../scripts/parse-forced-command" "$invalid" >/dev/null 2>&1; then
    echo "parser unexpectedly accepted static command: $invalid" >&2
    exit 1
  fi
done

for invalid in \
  "" \
  "doctor" \
  "deploy ${VALID_SHA}; id" \
  "deploy-static-live unknown $VALID_SHA $PERSONAL_SITE $PERSONAL_ROUTES $VALID_SHA $PLATFORM_INTEGRATION $CADDY_IMAGE" \
  "${personal_command}; id" \
  "deploy-application-live unknown $VALID_SHA $SURPLASSE_RELEASE" \
  "${surplasse_application_command}; id"; do
  if SSH_ORIGINAL_COMMAND=$invalid "$TESTS_DIR/../scripts/forced-command" >/dev/null 2>&1; then
    echo "forced-command wrapper unexpectedly accepted: $invalid" >&2
    exit 1
  fi
done

echo "forced-command parser tests passed"
